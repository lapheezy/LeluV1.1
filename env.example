# ==========================================================
# LÉLU — Environment Configuration
#
# Copy this file to .env and fill in your values.
# The real .env must never be committed to the repository.
# ==========================================================

# ----------------------------------------------------------
# AI CHAT PROVIDERS (fallback priority order)
#
# SERVER-SIDE ONLY — deliberately NOT VITE_-prefixed.
#
# Vite inlines every VITE_* value into the client bundle, so a
# VITE_-prefixed provider key is published to anyone who loads the
# page. These names are read by the server process instead, and the
# browser reaches the upstream through the same-origin relay
# (plugins/aiProxyApi.ts). Verified by scripts/verify-bundle-secrets.ts.
#
# At least one is required for LÉLU to generate responses.
# ----------------------------------------------------------

# Claude (Anthropic) — primary provider (priority 1).
# Uses the Messages API; NOT a bare API_KEY (see ENV_VARS.md).
ANTHROPIC_API_KEY=

# Groq — fallback #1 (priority 2). Also used for voice transcription.
GROQ_API_KEY=

# OpenRouter — fallback #1 (priority 2)
OPENROUTER_API_KEY=

# Cerebras — fallback #2 (priority 3)
CEREBRAS_API_KEY=

# Mistral — fallback #3 (priority 4)
MISTRAL_API_KEY=

# Fireworks AI — fallback #4 (priority 5)
FIREWORKS_API_KEY=

# GitHub Models — fallback #5 (priority 6).
# A bare GITHUB_TOKEN is deliberately ignored: dev containers and CI set
# it for git tooling, and adopting it would falsely mark this provider
# configured. Use this explicit name.
GITHUB_MODELS_TOKEN=

# ----------------------------------------------------------
# MODEL OVERRIDES (browser-safe: names, not credentials)
# ----------------------------------------------------------
VITE_ANTHROPIC_MODEL=claude-opus-5
VITE_GROQ_MODEL=openai/gpt-oss-120b
VITE_OPENROUTER_MODEL=openrouter/auto
VITE_CEREBRAS_MODEL=gpt-oss-120b
VITE_MISTRAL_MODEL=mistral-small-latest
VITE_FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
VITE_GITHUB_MODEL=gpt-4o-mini

# Custom AI proxy base URL for GitHub Models (optional; bypasses the relay)
# VITE_AI_PROXY_BASE_URL=

# Default provider to try first (optional)
VITE_DEFAULT_PROVIDER=groq

# ----------------------------------------------------------
# KNOWLEDGE / RESEARCH PROVIDERS (optional)
# ----------------------------------------------------------

# NewsAPI.org — current news lookups
VITE_NEWS_API_KEY=

# YouTube Data API v3 — video lookups
VITE_YOUTUBE_API_KEY=

# ----------------------------------------------------------
# INSTAGRAM GRAPH API (server-only)
# Keep these unprefixed: they must never enter the browser bundle.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=elpheru
INSTAGRAM_API_VERSION=v24.0

# Optional RSS sources (URLs are not secrets; VITE_ makes them client-visible)
VITE_SAPIOLINGO_RSS_URL=
VITE_ELPHERU_RSS_URL=
VITE_GOOGLE_NEWS_RSS_URL=
VITE_GOOGLE_NEWS_RSS_URL_2=
# Optional query-based Google News template fallback
VITE_GOOGLE_NEWS_TEMPLATE=https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en

# ----------------------------------------------------------
# DEFLOCK / FOGGEDLENS (no key required)
#
# ALPR camera infrastructure from public OpenStreetMap data
# (FoggedLens/DeFlock tagging) via the Overpass API. Shown as a
# native layer of the LÉLU Earth Core + registered cognition tools.
# ----------------------------------------------------------

# ----------------------------------------------------------
# QUAD9 SECURE DNS (optional, server-side)
# The /api/network/quad9 bridge VERIFIES the runtime's actual DNS
# posture (system resolvers, DNSSEC validation, live DoH query).
# The container's system resolvers are a deployment-level setting.
# ----------------------------------------------------------
# QUAD9_DOH_URL=https://dns.quad9.net/dns-query
# QUAD9_ECS=
# QUAD9_ECS_MASK=24

# ----------------------------------------------------------
# NEKO VIRTUAL BROWSER (m1k1o/neko, optional)
# VITE_NEKO_URL is the public URL of your Neko web client — the
# live browser session renders inside LÉLU's browser panel.
# NEKO_PASSWORD is the join password; server-side only.
# ----------------------------------------------------------
VITE_NEKO_URL=
# NEKO_URL=          # server-only alias accepted by /api/neko/status
# NEKO_PASSWORD=

# ----------------------------------------------------------
# PROVIDERS THAT NEED NO KEY
#
# These are always available when their modules load:
#   Wikipedia, Wikidata, Wikimedia, GDELT, OpenMeteo,
#   Hacker News, NASA, arXiv, CrossRef, OpenAlex,
#   OpenStreetMap/Nominatim, RSS
# ----------------------------------------------------------

# ----------------------------------------------------------
# SUPABASE PERSISTENCE (optional, browser-safe publishable key)
#
# Supabase is an optional local-first persistence/sync adapter.
# Email/password authentication is available from the existing Genesis
# Settings panel. Enable Email provider in Supabase Auth. Never place a
# service-role key in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The supplied Supabase names are also supported by Vite:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------------
# VLY INTEGRATION (optional)
# Provided automatically by Freebuff platform.
# ----------------------------------------------------------
# VLY_INTEGRATION_KEY=
# VLY_INTEGRATION_BASE_URL=https://integrations.vly.ai/

# ----------------------------------------------------------
# EARTH CORE PROVIDERS (optional — the layer reports its real status without them)
# ----------------------------------------------------------

# NASA FIRMS — live fire detection layer (MAP_KEY)
VITE_FIRMS_API_KEY=

# AISStream — live vessel positions layer.
# SERVER-ONLY: read by the Vite dev/preview server process and used for
# the server-side WebSocket bridge (plugins/aisBridgePlugin.ts). Never
# prefix this with VITE_ and never reference it from client code.
AISSTREAM_API_KEY=

# Optional custom REST endpoint for vessel positions (must keep the
# AIS key server-side as well — the URL must not carry a key)
# VITE_EARTH_VESSELS_ENDPOINT=

# ----------------------------------------------------------
# SECURITY NOTES
#
# - Every VITE_ variable is readable from the browser
#   bundle — use only public-facing client credentials.
# - Never hardcode keys in source code.
# - Never log secret values.
# - Never return credentials through API responses.
# ----------------------------------------------------------
