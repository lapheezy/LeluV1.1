# MOSS-TTS-Nano worker under workerctl: from the app checkout, `. services/mossnano/workerctl.env`,
# then: python3 services/voxcpm/workerctl.py start|status|stop|restart
export VOXCPM_SERVER=services/mossnano/server.py
export VOXCPM_PYTHON=.venv-mossnano/bin/python
export VOXCPM_READY_MARKER=.mossnano/state/model-ready.json
export VOXCPM_REQUIRED_GIB=3
export VOXCPM_RUN_DIR=$PWD/.mossnano/run
export VOXCPM_PORT=8789
export VOXCPM_STARTUP_TIMEOUT=180
