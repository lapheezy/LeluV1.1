# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit real environment files
.env
.env.local
.env.*.local

# Local analysis checkout for the external Neko service
.neko-source/

# Keep the config template tracked
!.env.example
!env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# LÉLU's isolated engineering workspace copies
.lelu-sandbox/
# Server-side runtime state (autonomy levels + audit) — never committed.
.lelu-runtime/
.lelu-studio/


# Runtime Cosmos world store written by the dev server (plugins/worldEngine.ts)
/cosmos/

# Rejected by the user (face lost in the 60k remesh); kept locally, not committed. Ledger + previews are committed.
leluverse/assets/characters/lelu_character/meshes/v001_multi-image-to-3d_01a18f49/*.glb
leluverse/assets/characters/lelu_character/meshes/v001_multi-image-to-3d_01a18f49/*.fbx
leluverse/assets/characters/lelu_character/meshes/v001_multi-image-to-3d_01a18f49/texture_*
leluverse/assets/characters/lelu_character/rig/v001_rigging_01a18f4e/*.glb
leluverse/assets/characters/lelu_character/rig/v001_rigging_01a18f4e/*.fbx

# MediaPipe segmentation models are downloaded on demand (URLs in scripts/blender/lelu_hairclean.py)
scripts/blender/models/*.tflite

# Runtime world state of the dev server's Forge store (worldEngine)
leluverse/assets/cosmos/
# Local review renders
review/
# Head bust source (99 MB GLB, 60 MB textures) and superseded head-swap builds: kept locally, not committed
leluverse/assets/characters/lelu_character/meshes/v002_multi-image-to-3d_01a18f5a/*.glb
leluverse/assets/characters/lelu_character/meshes/v002_multi-image-to-3d_01a18f5a/texture_*
leluverse/assets/characters/lelu_character/rig/v002_headswap_mvvnvqa1/*.glb
leluverse/assets/characters/lelu_character/rig/v003_headswap_mvvnvqa1/*.glb

# Meshy animation downloads repeat the whole character (~24 MB each); the
# client uses motion.glb (bones + clip only), which is committed.
leluverse/assets/characters/lelu_character/animations/*/animation.glb
leluverse/assets/characters/lelu_character/animations/*/animation.fbx

# Local integration binaries (opa, gitleaks, trivy). Not source; ~260 MB.
.tools/
# Blender export outputs are large (a 53 MB .blend, a 40 MB .obj) and are
# free to regenerate from their source job through POST /api/forge/jobs/<id>/export,
# so the binaries stay local and only the ledger records them.
leluverse/assets/**/meshes/v*_export_*/

# Playwright browser libraries unpacked into the workspace (see docs/acceptance/spatial-phase-2-11/scripts/README.md)
.apt/
