+/* --------------------------------- routes -------------------------------- */
+
+const MIME: Record<string, string> = {
+  ".html": "text/html; charset=utf-8",
+  ".css": "text/css; charset=utf-8",
+  ".js": "text/javascript; charset=utf-8",
+  ".mjs": "text/javascript; charset=utf-8",
+  ".json": "application/json; charset=utf-8",
+  ".png": "image/png",
+  ".jpg": "image/jpeg",
+  ".jpeg": "image/jpeg",
+  ".webp": "image/webp",
+  ".svg": "image/svg+xml",
+  ".glb": "model/gltf-binary",
+  ".gltf": "model/gltf+json",
+  ".wasm": "application/wasm",
+  ".txt": "text/plain; charset=utf-8",
+  ".map": "application/json; charset=utf-8",
+};
+
+/* --------------------------- application backend -------------------------
+ * An application project declares its backend in studio.json. Its preview
+ * must be the REAL app connected to the REAL API, not a static shell, so
+ * the studio starts that backend and proxies the whole preview through
+ * this origin. Relative /api requests inside the iframe then reach the
+ * project's own server without rewriting a single frontend file.
+ */
+
+interface BackendConfig {
+  command: string;
+  health?: string;
+}
+
+interface RunningBackend {
+  port: number;
+  child: ChildProcess;
+}
+
+const backends = new Map<string, RunningBackend>();
+
+function backendConfig(root: string): BackendConfig | null {
+  try {
+    const parsed = JSON.parse(readFileSync(path.join(root, "studio.json"), "utf8")) as {
+      backend?: { command?: string; health?: string };
+    };
+    if (!parsed.backend?.command) return null;
+    return { command: parsed.backend.command, health: parsed.backend.health ?? "/api/health" };
+  } catch {
+    return null;
+  }
+}
+
+function freePort(): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const probe = createNetServer();
+    probe.once("error", reject);
+    probe.listen(0, "127.0.0.1", () => {
+      const address = probe.address();
+      const port = typeof address === "object" && address ? address.port : 0;
+      probe.close(() => resolve(port));
+    });
+  });
+}
+
+async function waitForHealth(url: string, timeoutMs: number): Promise<boolean> {
+  const started = Date.now();
+  while (Date.now() - started < timeoutMs) {
+    try {
+      const response = await fetch(url, { signal: AbortSignal.timeout(1500) });
+      if (response.ok) return true;
+    } catch {
+      /* not up yet */
+    }
+    await new Promise((resolve) => setTimeout(resolve, 300));
+  }
+  return false;
+}
+
+async function ensureBackend(slug: string, root: string, config: BackendConfig): Promise<RunningBackend> {
+  const existing = backends.get(slug);
+  if (existing) return existing;
+  const port = await freePort();
+  const child = spawn(process.execPath, [config.command], {
+    cwd: root,
+    detached: process.platform !== "win32",
+    env: { ...process.env, PORT: String(port), HOST: "127.0.0.1", NODE_OPTIONS: "" },
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  let log = "";
+  const keep = (chunk: Buffer) => {
+    log = `${log}${chunk.toString("utf8")}`.slice(-4000);
+  };
+  child.stdout?.on("data", keep);
+  child.stderr?.on("data", keep);
+  const running: RunningBackend = { port, child };
+  backends.set(slug, running);
+  child.on("exit", () => {
+    if (backends.get(slug)?.child === child) backends.delete(slug);
+  });
+  const up = await waitForHealth(`http://127.0.0.1:${port}${config.health}`, 30_000);
+  if (!up) {
+    backends.delete(slug);
+    try {
+      if (child.pid) process.kill(-child.pid, "SIGTERM");
+      else child.kill("SIGTERM");
+    } catch {
+      child.kill("SIGTERM");
+    }
+    throw new Error(
+      `The application backend did not become healthy within 30 s. ${log.trim().slice(-1200)}`.trim(),
+    );
+  }
+  return running;
+}
+
+async function proxyToBackend(
+  req: ConnectLikeReq,
+  res: ConnectLikeRes,
+  slug: string,
+  root: string,
+  config: BackendConfig,
+  remainder: string,
+): Promise<void> {
+  const running = await ensureBackend(slug, root, config);
+  const rawUrl = req.url ?? "/";
+  const query = rawUrl.includes("?") ? rawUrl.slice(rawUrl.indexOf("?")) : "";
+  const method = (req.method ?? "GET").toUpperCase();
+  let body: string | undefined;
+  if (method !== "GET" && method !== "HEAD") {
+    body = await new Promise<string>((resolve, reject) => {
+      let size = 0;
+      const chunks: string[] = [];
+      const decoder = new TextDecoder();
+      req.on("data", (chunk) => {
+        const text = typeof chunk === "string" ? chunk : decoder.decode(chunk as Uint8Array, { stream: true });
+        size += text.length;
+        if (size > MAX_WRITE_BYTES) reject(new Error("Request body too large."));
+        else chunks.push(text);
+      });
+      req.on("end", () => resolve(chunks.join("")));
+      req.on("error", (error) => reject(error instanceof Error ? error : new Error(String(error))));
+    });
+  }
+  const target = `http://127.0.0.1:${running.port}/${remainder}${query}`;
+  const upstream = await fetch(target, {
+    method,
+    headers: { "content-type": header(req, "content-type") || "application/json" },
+    body,
+  });
+  const buffer = Buffer.from(await upstream.arrayBuffer());
+  res.statusCode = upstream.status;
+  res.setHeader("Content-Type", upstream.headers.get("content-type") ?? "application/octet-stream");
+  res.setHeader("Cache-Control", "no-store");
+  res.end(buffer);
+}
+
+/** Stop every application backend this runtime started. */
+export function stopAllStudioBackends(): void {
+  for (const [slug, running] of backends) {
+    try {
+      if (running.child.pid) process.kill(-running.child.pid, "SIGTERM");
+      else running.child.kill("SIGTERM");
+    } catch {
+      running.child.kill("SIGTERM");
+    }
+    backends.delete(slug);
+  }
+}
+
+function servePreview(req: ConnectLikeReq, res: ConnectLikeRes): void {
+  const relative = (req.url ?? "").split("?")[0].replace(/^\/+/, "");
+  const [rawSlug, ...rest] = relative.split("/");
+  let slug: string;
+  try {
+    slug = safeSlug(decodeURIComponent(rawSlug ?? ""));
+  } catch (error) {
+    sendJson(res, { ok: false, error: error instanceof Error ? error.message : String(error) }, 400);
+    return;
+  }
+  const projectDirectory = path.join(STUDIO_ROOT, slug);
+  const backend = backendConfig(projectDirectory);
+  if (backend) {
+    const remainder = rest.map((part) => decodeURIComponent(part)).join("/");
+    void proxyToBackend(req, res, slug, projectDirectory, backend, remainder).catch((error) => {
+      sendJson(
+        res,
+        { ok: false, error: error instanceof Error ? error.message : String(error) },
+        502,
+      );
+    });
+    return;
+  }
+
+  const method = (req.method ?? "GET").toUpperCase();
+  if (method !== "GET" && method !== "HEAD") {
+    sendJson(res, { ok: false, error: "A static preview is read with GET." }, 405);
+    return;
+  }
+
+  const root = path.join(projectDirectory, "dist");
+  if (!existsSync(root)) {
+    sendJson(
+      res,
+      { ok: false, error: `"${slug}" has no build output. Run its build before previewing it.` },
+      404,
+    );
+    return;
+  }
+  const requested = rest.length === 0 ? "index.html" : rest.map((part) => decodeURIComponent(part)).join("/");
+  let file: string;
+  try {
+    file = resolveInside(root, requested);
+  } catch {
+    sendJson(res, { ok: false, error: "That preview path is outside the project." }, 403);
+    return;
+  }
+  if (existsSync(file) && statSync(file).isDirectory()) file = path.join(file, "index.html");
+  if (!existsSync(file)) {
+    sendJson(res, { ok: false, error: `Not built: ${requested}` }, 404);
+    return;
+  }
+  res.statusCode = 200;
+  res.setHeader("Content-Type", MIME[path.extname(file).toLowerCase()] ?? "application/octet-stream");
+  res.setHeader("Cache-Control", "no-store");
+  res.setHeader("X-Content-Type-Options", "nosniff");
+  res.end(readFileSync(file));
+}
+
+export function createStudioApi(): { attach: (middlewares: { use: (route: string, handler: Handler) => void }) => void } {
+  const postRoute = (_route: string, handler: (body: Record<string, unknown>, req: ConnectLikeReq) => Promise<unknown>) => {
+    return (req: ConnectLikeReq, res: ConnectLikeRes, next: () => void) => {
+      if ((req.method ?? "GET").toUpperCase() !== "POST") {
+        next();
+        return;
+      }
+      if (isCrossOrigin(req)) {
+        sendJson(res, { ok: false, error: "Cross-origin requests are not permitted." }, 403);
+        return;
+      }
+      if (!tokenOk(req)) {
+        sendJson(res, { ok: false, error: "The studio runtime requires LELU_ENGINEER_TOKEN." }, 401);
+        return;
+      }
+      void (async () => {
+        try {
+          const body = await readJsonBody(req);
+          const result = await handler(body, req);
+          sendJson(res, result);
+        } catch (error) {
+          sendJson(res, { ok: false, error: error instanceof Error ? error.message : String(error) }, 400);
+        }
+      })();
+    };
+  };
+
+  return {
+    attach(middlewares) {
+      middlewares.use(
+        "/api/studio/health",
+        postRoute("/api/studio/health", async () => {
+          const templates = existsSync(TEMPLATE_ROOT) ? readdirSync(TEMPLATE_ROOT) : [];
+          return {
+            ok: true,
+            runtime: "studio",
+            root: path.relative(PROJECT_ROOT, STUDIO_ROOT).split(path.sep).join("/"),
+            templates,
+            capabilities: engineCapabilities(),
+          };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/projects",
+        postRoute("/api/studio/projects", async () => {
+          if (!existsSync(STUDIO_ROOT)) return { ok: true, projects: [] };
+          const projects = readdirSync(STUDIO_ROOT)
+            .filter((name) => /^[a-z0-9][a-z0-9-]*$/.test(name) && statSync(path.join(STUDIO_ROOT, name)).isDirectory())
+            .map((slug) => {
+              const root = path.join(STUDIO_ROOT, slug);
+              const files = walkFiles(root).filter((file) => !file.startsWith("dist/") && !file.startsWith("deploy/"));
+              return {
+                slug,
+                files: files.length,
+                bytes: dirSize(root),
+                updatedAt: statSync(root).mtimeMs,
+                built: existsSync(path.join(root, "dist", "index.html")),
+              };
+            });
+          return { ok: true, projects };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/scaffold",
+        postRoute("/api/studio/scaffold", async (body) => {
+          const kind = String(body.kind ?? "") as TemplateKind;
+          if (!(kind in TEMPLATE_KINDS)) {
+            throw new Error("kind must be website, application or game.");
+          }
+          const name = String(body.name ?? "").trim();
+          if (!name) throw new Error("A project needs a name.");
+          return { ok: true, ...scaffold(kind, name) };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/demo",
+        postRoute("/api/studio/demo", async () => {
+          const results = DEMOS.map((demo) => {
+            try {
+              const created = scaffold(demo.kind, demo.name, demo.slug);
+              return { ok: true, kind: demo.kind, ...created };
+            } catch (error) {
+              return {
+                ok: false,
+                kind: demo.kind,
+                slug: demo.slug,
+                files: 0,
+                error: error instanceof Error ? error.message : String(error),
+              };
+            }
+          });
+          return { ok: results.every((result) => result.ok), projects: results };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/tree",
+        postRoute("/api/studio/tree", async (body) => {
+          const root = projectRoot(safeSlug(body.slug));
+          const target = resolveInside(root, String(body.path ?? "."));
+          if (!existsSync(target)) throw new Error("That directory does not exist.");
+          if (!statSync(target).isDirectory()) throw new Error("That path is a file, not a directory.");
+          const entries = readdirSync(target)
+            .filter((name) => name !== "node_modules" && name !== ".git")
+            .map((name) => {
+              const full = path.join(target, name);
+              const stat = statSync(full);
+              return {
+                name,
+                path: path.relative(root, full).split(path.sep).join("/"),
+                type: stat.isDirectory() ? ("dir" as const) : ("file" as const),
+                size: stat.isDirectory() ? undefined : stat.size,
+              };
+            })
+            .sort((a, b) => (a.type === b.type ? a.name.localeCompare(b.name) : a.type === "dir" ? -1 : 1));
+          return { ok: true, entries };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/read",
+        postRoute("/api/studio/read", async (body) => {
+          const root = projectRoot(safeSlug(body.slug));
+          const file = resolveInside(root, String(body.path ?? ""));
+          if (!existsSync(file) || statSync(file).isDirectory()) throw new Error("No such file.");
+          if (statSync(file).size > MAX_WRITE_BYTES) throw new Error("That file is too large to open.");
+          return { ok: true, content: readFileSync(file, "utf8") };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/write",
+        postRoute("/api/studio/write", async (body) => {
+          const root = projectRoot(safeSlug(body.slug));
+          const relative = String(body.path ?? "");
+          if (!relative) throw new Error("A write needs a path.");
+          const content = String(body.content ?? "");
+          if (content.length > MAX_WRITE_BYTES) throw new Error("That file is too large to save.");
+          const refusal = refuseReasonForWrite(content);
+          if (refusal) throw new Error(refusal);
+          const file = resolveInside(root, relative);
+          mkdirSync(path.dirname(file), { recursive: true });
+          writeFileSync(file, content, "utf8");
+          return { ok: true, path: path.relative(root, file).split(path.sep).join("/"), bytes: content.length };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/backends/stop",
+        postRoute("/api/studio/backends/stop", async () => {
+          const running = backends.size;
+          stopAllStudioBackends();
+          return { ok: true, stopped: running };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/build",
+        postRoute("/api/studio/build", async (body) => {
+          const slug = safeSlug(body.slug);
+          const root = projectRoot(slug);
+          if (!existsSync(path.join(root, "scripts", "build.mjs"))) {
+            throw new Error("This project has no scripts/build.mjs, so it cannot be built here.");
+          }
+          const result = await runNode(root, ["scripts/build.mjs"], BUILD_TIMEOUT_MS);
+          const dist = path.join(root, "dist");
+          const built = existsSync(dist);
+          const sourceFiles = walkFiles(root).filter(
+            (file) => !file.startsWith("dist/") && !file.startsWith("deploy/") && !file.startsWith(".studio/"),
+          );
+          let hash = 0x811c9dc5;
+          let sourceBytes = 0;
+          for (const file of sourceFiles) {
+            const content = readFileSync(path.join(root, file));
+            sourceBytes += content.byteLength;
+            const text = `${file}\u0000${content.toString("base64")}`;
+            for (let index = 0; index < text.length; index += 1) {
+              hash ^= text.charCodeAt(index);
+              hash = Math.imul(hash, 0x01000193) >>> 0;
+            }
+          }
+          return {
+            ok: result.exitCode === 0 && built,
+            exitCode: result.exitCode,
+            durationMs: result.durationMs,
+            output: result.output || "(the build produced no output)",
+            artifact: built ? "dist" : null,
+            bytes: built ? dirSize(dist) : 0,
+            timedOut: result.timedOut,
+            version: {
+              files: sourceFiles.length,
+              bytes: sourceBytes,
+              hash: hash.toString(16).padStart(8, "0"),
+            },
+          };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/test",
+        postRoute("/api/studio/test", async (body) => {
+          const slug = safeSlug(body.slug);
+          const root = projectRoot(slug);
+          if (!existsSync(path.join(root, "tests"))) throw new Error("This project has no tests directory.");
+          // TAP is asked for explicitly: the default reporter's output
+          // ("ℹ pass 9") depends on whether a terminal is attached, and a
+          // test count must not change with the runner's TTY.
+          const result = await runNode(root, ["--test", "--test-reporter=tap", "tests/"], TEST_TIMEOUT_MS);
+          const pass = /# pass (\d+)/.exec(result.output);
+          const fail = /# fail (\d+)/.exec(result.output);
+          return {
+            ok: result.exitCode === 0,
+            exitCode: result.exitCode,
+            passed: pass ? Number(pass[1]) : 0,
+            failed: fail ? Number(fail[1]) : result.exitCode === 0 ? 0 : 1,
+            durationMs: result.durationMs,
+            output: result.output || "(the test run produced no output)",
+            timedOut: result.timedOut,
+          };
+        }),
+      );
+
+      // Static previews are GET; an application's preview proxies its own
+      // backend, so POST/PATCH/DELETE must reach it too. Measured in the
+      // first end-to-end run: the app's create-task POST fell through to a
+      // 404 because this handler only accepted GET.
+      middlewares.use("/api/studio/serve", (req, res) => {
+        servePreview(req, res);
+      });
+
+      middlewares.use(
+        "/api/studio/assets",
+        postRoute("/api/studio/assets", async () => readAssets()),
+      );
+
+      middlewares.use(
+        "/api/studio/approvals/request",
+        postRoute("/api/studio/approvals/request", async (body) => {
+          const slug = safeSlug(body.slug);
+          projectRoot(slug);
+          const action = String(body.action ?? "");
+          if (!PROTECTED_ACTIONS.has(action)) {
+            throw new Error(`"${action}" is not a protected action, so it needs no approval.`);
+          }
+          const reason = String(body.reason ?? "").trim();
+          if (reason.length < 12) throw new Error("An approval request must explain what would happen.");
+          const now = Date.now();
+          const approval: StoredApproval = {
+            id: `approval-${crypto.randomUUID().slice(0, 8)}`,
+            slug,
+            action,
+            reason,
+            scope: Array.isArray(body.scope) ? body.scope.map(String) : [],
+            requestedAt: now,
+            expiresAt: now + APPROVAL_TTL_MS,
+            status: "pending",
+            decidedAt: null,
+            decidedBy: null,
+          };
+          writeApprovals([...readApprovals(), approval]);
+          return { ok: true, approvalId: approval.id, approval };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/approvals/list",
+        postRoute("/api/studio/approvals/list", async (body) => {
+          const slug = safeSlug(body.slug);
+          return { ok: true, approvals: readApprovals().filter((approval) => approval.slug === slug) };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/approvals/decide",
+        postRoute("/api/studio/approvals/decide", async (body, req) => {
+          if (header(req, "x-lelu-user-confirmed") !== "1") {
+            throw new Error(
+              "An approval can only be decided by the person, through the Studio panel. " +
+                "LÉLU's tools cannot grant one.",
+            );
+          }
+          const approvalId = String(body.approvalId ?? "");
+          const decision = body.decision === "approved" ? "approved" : body.decision === "denied" ? "denied" : null;
+          if (!decision) throw new Error("decision must be approved or denied.");
+          const decidedBy = String(body.decidedBy ?? "").trim();
+          if (!decidedBy) throw new Error("An approval decision needs the person's identity.");
+          const approvals = readApprovals();
+          const approval = approvals.find((item) => item.id === approvalId);
+          if (!approval) throw new Error(`No approval "${approvalId}".`);
+          if (approval.status !== "pending") throw new Error(`That approval is already ${approval.status}.`);
+          const next: StoredApproval = {
+            ...approval,
+            status: decision,
+            decidedAt: Date.now(),
+            decidedBy,
+          };
+          writeApprovals(approvals.map((item) => (item.id === approvalId ? next : item)));
+          return { ok: true, approval: next };
+        }),
+      );
+
+      middlewares.use(
+        "/api/studio/deploy",
+        postRoute("/api/studio/deploy", async (body) => {
+          const slug = safeSlug(body.slug);
+          const environment = body.environment === "production" ? "production" : "preview";
+          const result = prepareDeployment(
+            slug,
+            environment,
+            typeof body.approvalId === "string" ? body.approvalId : undefined,
+          );
+          return result;
+        }),
+      );
+    },
+  };
+}
diff --git a/plugins/voiceApi.ts b/plugins/voiceApi.ts
new file mode 100644
index 0000000..f52c170
--- /dev/null
+++ b/plugins/voiceApi.ts
@@ -0,0 +1,254 @@
+/**
+ * ==========================================================
+ * LÉLU — VOICE API (ElevenLabs, server-side)
+ *
+ * Her voice was browser `speechSynthesis`: whatever voice the
+ * visitor's OS happened to install, different on every machine,
+ * never hers. This route is what makes it consistent — one
+ * voice, one model, chosen here, synthesised by ElevenLabs and
+ * streamed to the page as audio/mpeg.
+ *
+ * The key never reaches the browser:
+ *   - the request goes to /api/voice/tts
+ *   - the SERVER attaches `xi-api-key`
+ *   - the response is audio bytes, nothing else
+ *
+ * Endpoints:
+ *   GET  /api/voice/status  → { configured, voiceId, modelId }  (no key, no network)
+ *   POST /api/voice/tts     → audio/mpeg for { text }
+ *
+ * Failure is reported as failure: a synthesis error returns a
+ * JSON body with the upstream status, never silent audio and
+ * never a 200 carrying an error string.
+ * ==========================================================
+ */
+
+/** Anything that resolves an environment name, like vite's envReader. */
+type ReadEnv = (key: string) => string | undefined;
+
+const ELEVENLABS_BASE = "https://api.elevenlabs.io/v1";
+
+/**
+ * Jessica — "Playful, Bright, Warm", American, conversational.
+ * Chosen from the 21 voices this key can actually reach, for a
+ * natural feminine speaking register rather than an announcer.
+ * Override with ELEVENLABS_VOICE_ID without touching code.
+ */
+const DEFAULT_VOICE_ID = "cgSgspJ2msm6clMCkdW9";
+
+/**
+ * Eleven v3 is the expressive model on this account; turbo v2.5 is
+ * the low-latency fallback if v3 is unavailable. Both are verified
+ * against the live account before being reported as usable.
+ */
+const DEFAULT_MODEL_ID = "eleven_v3";
+
+/** A single reply segment. Keeps one request inside the free quota. */
+const MAX_TEXT_LENGTH = 900;
+
+interface ConnectLikeReq {
+  method?: string;
+  headers?: Record<string, string | string[] | undefined>;
+  on: ((event: "data", listener: (chunk: unknown) => void) => void) &
+    ((event: "end", listener: () => void) => void) &
+    ((event: "error", listener: (error: unknown) => void) => void);
+}
+
+interface ConnectLikeRes {
+  statusCode?: number;
+  setHeader: (name: string, value: string) => void;
+  end: (body?: string | Uint8Array) => void;
+}
+
+type Handler = (req: ConnectLikeReq, res: ConnectLikeRes, next: () => void) => void;
+
+function sendJson(res: ConnectLikeRes, payload: unknown, status = 200): void {
+  res.statusCode = status;
+  res.setHeader("Content-Type", "application/json; charset=utf-8");
+  res.setHeader("Cache-Control", "no-store");
+  res.end(JSON.stringify(payload));
+}
+
+/** A credential never contains whitespace; see plugins/bareSecretAliases.ts. */
+function readSecret(readEnv: ReadEnv | undefined, names: readonly string[]): string {
+  for (const name of names) {
+    const raw = readEnv ? readEnv(name) : process.env[name];
+    const value = typeof raw === "string" ? raw.replace(/\s+/g, "") : "";
+    if (value) return value;
+  }
+  return "";
+}
+
+function readJsonBody(req: ConnectLikeReq): Promise<Record<string, unknown>> {
+  return new Promise((resolve, reject) => {
+    const chunks: Uint8Array[] = [];
+    let size = 0;
+    req.on("data", (chunk: unknown) => {
+      const buffer = typeof chunk === "string" ? new TextEncoder().encode(chunk) : (chunk as Uint8Array);
+      size += buffer.length;
+      // A reply is a few kilobytes; anything larger is not a reply.
+      if (size > 64_000) {
+        reject(new Error("Request body too large."));
+        return;
+      }
+      chunks.push(buffer);
+    });
+    req.on("end", () => {
+      try {
+        const joined = new Uint8Array(size);
+        let offset = 0;
+        for (const chunk of chunks) {
+          joined.set(chunk, offset);
+          offset += chunk.length;
+        }
+        const body = new TextDecoder().decode(joined).trim();
+        resolve(body ? (JSON.parse(body) as Record<string, unknown>) : {});
+      } catch (error) {
+        reject(error);
+      }
+    });
+    req.on("error", reject);
+  });
+}
+
+function isCrossOrigin(req: ConnectLikeReq): boolean {
+  const headers = req.headers ?? {};
+  const origin = typeof headers.origin === "string" ? headers.origin : "";
+  const host = typeof headers.host === "string" ? headers.host : "";
+  if (!origin || !host) return false;
+  try {
+    return new URL(origin).host !== host;
+  } catch {
+    return true;
+  }
+}
+
+export function voiceSettings(): { voiceId: string; modelId: string } {
+  return { voiceId: DEFAULT_VOICE_ID, modelId: DEFAULT_MODEL_ID };
+}
+
+export function createVoiceApi(readEnv?: ReadEnv): {
+  attach: (middlewares: { use: (path: string, handler: Handler) => void }) => void;
+} {
+  function voiceConfig(): { key: string; voiceId: string; modelId: string } {
+    const configured = voiceSettings();
+    return {
+      key: readSecret(readEnv, ["ELEVENLABS_API_KEY", "Elevenlabs"]),
+      voiceId: readSecret(readEnv, ["ELEVENLABS_VOICE_ID"]) || configured.voiceId,
+      modelId: readSecret(readEnv, ["ELEVENLABS_MODEL_ID"]) || configured.modelId,
+    };
+  }
+
+  function handleStatus(req: ConnectLikeReq, res: ConnectLikeRes, next: () => void): void {
+    if ((req.method ?? "GET") !== "GET") {
+      next();
+      return;
+    }
+    const { key, voiceId, modelId } = voiceConfig();
+    // Presence, not health: this makes no network call and claims nothing
+    // about whether the key is still accepted upstream.
+    sendJson(res, { configured: Boolean(key), voiceId, modelId });
+  }
+
+  function handleTts(req: ConnectLikeReq, res: ConnectLikeRes, next: () => void): void {
+    if ((req.method ?? "GET") !== "POST") {
+      next();
+      return;
+    }
+    if (isCrossOrigin(req)) {
+      sendJson(res, { ok: false, error: "Cross-origin requests are not allowed." }, 403);
+      return;
+    }
+    void (async () => {
+      const { key, voiceId, modelId } = voiceConfig();
+      if (!key) {
+        sendJson(res, { ok: false, error: "ElevenLabs is not configured." }, 503);
+        return;
+      }
+      let body: Record<string, unknown>;
+      try {
+        body = await readJsonBody(req);
+      } catch {
+        sendJson(res, { ok: false, error: "Malformed request body." }, 400);
+        return;
+      }
+      const text = typeof body.text === "string" ? body.text.trim() : "";
+      if (!text) {
+        sendJson(res, { ok: false, error: "No text to speak." }, 400);
+        return;
+      }
+      if (text.length > MAX_TEXT_LENGTH) {
+        sendJson(res, { ok: false, error: `Text exceeds ${MAX_TEXT_LENGTH} characters.` }, 413);
+        return;
+      }
+      try {
+        const upstream = await fetch(
+          `${ELEVENLABS_BASE}/text-to-speech/${encodeURIComponent(voiceId)}?output_format=mp3_44100_128`,
+          {
+            method: "POST",
+            headers: {
+              "xi-api-key": key,
+              "Content-Type": "application/json",
+              Accept: "audio/mpeg",
+            },
+            body: JSON.stringify({
+              text,
+              model_id: modelId,
+              voice_settings: {
+                stability: 0.4,
+                similarity_boost: 0.8,
+                style: 0.2,
+                use_speaker_boost: true,
+              },
+            }),
+          },
+        );
+        if (!upstream.ok) {
+          // Report the status, never an upstream body (it can echo the text).
+          sendJson(
+            res,
+            { ok: false, error: "ElevenLabs refused the request.", upstreamStatus: upstream.status },
+            upstream.status === 401 || upstream.status === 403 ? 502 : 502,
+          );
+          return;
+        }
+        const audio = new Uint8Array(await upstream.arrayBuffer());
+        res.statusCode = 200;
+        res.setHeader("Content-Type", "audio/mpeg");
+        res.setHeader("Content-Length", String(audio.byteLength));
+        res.setHeader("Cache-Control", "no-store");
+        res.end(audio);
+      } catch (error) {
+        sendJson(
+          res,
+          { ok: false, error: `ElevenLabs request failed: ${(error as Error).message}` },
+          502,
+        );
+      }
+    })();
+  }
+
+  return {
+    attach(middlewares) {
+      middlewares.use("/api/voice/status", handleStatus);
+      middlewares.use("/api/voice/tts", handleTts);
+    },
+  };
+}
+
+export function voiceApiPlugin(readEnv?: ReadEnv): {
+  name: string;
+  configureServer: (server: { middlewares: { use: (path: string, handler: Handler) => void } }) => void;
+  configurePreviewServer: (server: { middlewares: { use: (path: string, handler: Handler) => void } }) => void;
+} {
+  const api = createVoiceApi(readEnv);
+  return {
+    name: "voice-api",
+    configureServer(server) {
+      api.attach(server.middlewares);
+    },
+    configurePreviewServer(server) {
+      api.attach(server.middlewares);
+    },
+  };
+}
diff --git a/plugins/wardrobeInventory.ts b/plugins/wardrobeInventory.ts
new file mode 100644
index 0000000..0a40cad
--- /dev/null
+++ b/plugins/wardrobeInventory.ts
@@ -0,0 +1,258 @@
+/**
+ * ==========================================================
+ * LÉLU 3D FORGE — WARDROBE INVENTORY (server + tests)
+ *
+ * The plan that sits between a reference board and a spend:
+ * every physical asset of a look, named, categorised, given
+ * the wardrobe slot and the bone it will follow, and the
+ * references that may drive its geometry.
+ *
+ * Reading it is free. Planning it creates the exact Meshy
+ * request each asset would send, with the published price
+ * attached, so the total is a number a person can approve
+ * rather than a surprise.
+ *
+ * Nothing here fabricates an asset: an entry whose references
+ * are not on disk is reported as blocked, not estimated away.
+ * ==========================================================
+ */
+
+import { estimateCredits, type ForgeJobKind } from "../src/core/forge/MeshyCatalog.ts";
+import type { ReferenceRecord } from "./forgeReferences.ts";
+import type { WardrobeCategory } from "./forgeStore.ts";
+
+export const INVENTORY_CATEGORIES: ReadonlySet<string> = new Set([
+  "look",
+  "hair",
+  "headwear",
+  "jewelry",
+  "outerwear",
+  "bag",
+  "shoes",
+  "accessory",
+  "other",
+]);
+
+export interface InventoryAsset {
+  /** Wardrobe id once generated: lowercase, unique across the character. */
+  id: string;
+  name: string;
+  category: string;
+  /** Interchangeable slot: items sharing one slot replace each other. */
+  slot: string;
+  /** Bone the finished piece follows; absent for a look, which replaces her model. */
+  bone?: string;
+  /** Which physical part of the outfit this is, in plain words. */
+  part?: string;
+  /** Reference ids that may drive this asset's geometry, most authoritative first. */
+  references: string[];
+  generation: { kind: "image-to-3d" | "multi-image-to-3d"; geometry?: "standard" | "2k"; polycount?: number };
+  /** Rig it to her skeleton (only meaningful for a full outfit). */
+  rig?: boolean;
+  /** True when this asset can be worn as a complete look. */
+  isLook?: boolean;
+  /** Design features a person must confirm, because the source cannot show them. */
+  inferred?: string[];
+  /** Runtime/wearable notes worth keeping with the asset. */
+  note?: string;
+}
+
+export interface InventoryLook {
+  id: string;
+  title: string;
+  authority: string[];
+  boards: string[];
+  assets: InventoryAsset[];
+}
+
+export interface WardrobeInventory {
+  version: number;
+  character: string;
+  looks: InventoryLook[];
+}
+
+export interface PlannedAsset {
+  look: string;
+  asset: InventoryAsset;
+  kind: ForgeJobKind;
+  body: Record<string, unknown>;
+  estimate: number;
+  rigEstimate: number;
+  /** Empty when the asset can be planned now. */
+  blockers: string[];
+}
+
+const PIECE_POLYCOUNT = 20_000;
+const OUTFIT_POLYCOUNT = 60_000;
+
+export function validateInventory(raw: unknown): WardrobeInventory {
+  const data = raw as WardrobeInventory;
+  if (!data || typeof data !== "object") throw new Error("Inventory must be a JSON object.");
+  if (!Array.isArray(data.looks) || data.looks.length === 0) throw new Error("Inventory needs a non-empty looks array.");
+  const problems: string[] = [];
+  const seen = new Set<string>();
+  for (const look of data.looks) {
+    if (!look.id || !/^[a-z][a-z0-9_]*$/.test(look.id)) problems.push(`Look id "${look.id}" must be lowercase a-z, 0-9, underscore.`);
+    if (!Array.isArray(look.assets) || look.assets.length === 0) problems.push(`Look "${look.id}" has no assets.`);
+    for (const asset of look.assets ?? []) {
+      const where = `${look.id}/${asset.id}`;
+      if (!asset.id || !/^[a-z][a-z0-9_]*$/.test(asset.id)) problems.push(`${where}: id must be lowercase a-z, 0-9, underscore.`);
+      if (seen.has(asset.id)) problems.push(`${where}: id is used more than once.`);
+      seen.add(asset.id);
+      if (!INVENTORY_CATEGORIES.has(asset.category)) problems.push(`${where}: category "${asset.category}" is not a wardrobe category (${[...INVENTORY_CATEGORIES].join(", ")}).`);
+      if (!asset.slot) problems.push(`${where}: needs a slot.`);
+      if (asset.category !== "look" && !asset.bone) problems.push(`${where}: needs the bone it follows (only a look replaces her model).`);
+      if (!Array.isArray(asset.references)) problems.push(`${where}: references must be an array (empty is allowed, and blocks it).`);
+      if (asset.generation?.kind === "multi-image-to-3d" && (asset.references ?? []).length > 4) problems.push(`${where}: multi-image takes at most 4 references.`);
+    }
+  }
+  if (problems.length) throw new Error(`Inventory is invalid:\n  - ${problems.join("\n  - ")}`);
+  return data;
+}
+
+/** The request an asset would send, built from the same settings as the approved looks. */
+export function requestFor(asset: InventoryAsset, referenceIds: string[]): Record<string, unknown> {
+  const piece = asset.category !== "look";
+  const shared = {
+    ai_model: "meshy-7.1",
+    should_texture: true,
+    enable_pbr: true,
+    texture_resolution: "2k",
+    should_remesh: true,
+    topology: "triangle",
+    target_polycount: asset.generation.polycount ?? (piece ? PIECE_POLYCOUNT : OUTFIT_POLYCOUNT),
+    image_enhancement: false,
+  };
+  if (asset.generation.geometry === "2k") shared["geometry_resolution"] = "2k";
+  return asset.generation.kind === "multi-image-to-3d"
+    ? { ...shared, image_urls: referenceIds.map((id) => `ref:${id}`) }
+    : { ...shared, image_url: `ref:${referenceIds[0]}` };
+}
+
+/**
+ * Plan every asset in the inventory against the references that actually
+ * exist. Free: no job is filed, nothing is submitted.
+ */
+export function planInventory(inventory: WardrobeInventory, references: ReferenceRecord[]): PlannedAsset[] {
+  const byId = new Map(references.map((reference) => [reference.id, reference]));
+  const planned: PlannedAsset[] = [];
+  for (const look of inventory.looks) {
+    for (const asset of look.assets) {
+      const blockers: string[] = [];
+      const usable = asset.references.filter((id) => byId.has(id));
+      for (const id of asset.references.filter((id) => !byId.has(id))) blockers.push(`reference "${id}" is not ingested`);
+      if (!asset.references.length) blockers.push("no reference assigned: a crop of the board or the original photograph must be chosen first");
+      if (asset.references.length && !usable.length) blockers.push("none of its references exist on disk");
+      if (asset.generation.kind === "multi-image-to-3d" && usable.length < 2) blockers.push(`multi-image needs at least 2 usable references (has ${usable.length})`);
+      if (asset.generation.kind === "multi-image-to-3d" && usable.length > 4) blockers.push("multi-image takes at most 4 references");
+      if (asset.isLook && usable.length < 1) blockers.push("a look needs at least one full-body reference");
+      const body = requestFor(asset, usable.length ? usable : asset.references.slice(0, 1));
+      const estimate = blockers.length ? 0 : estimateCredits(asset.generation.kind, body);
+      const rigEstimate = blockers.length || !asset.rig ? 0 : estimateCredits("rigging", {});
+      planned.push({ look: look.id, asset, kind: asset.generation.kind, body, estimate, rigEstimate, blockers });
+    }
+  }
+  return planned;
+}
+
+export function totalise(planned: PlannedAsset[]): { ready: number; blocked: number; generation: number; rigging: number } {
+  return planned.reduce(
+    (sum, item) => ({
+      ready: sum.ready + (item.blockers.length ? 0 : 1),
+      blocked: sum.blocked + (item.blockers.length ? 1 : 0),
+      generation: sum.generation + item.estimate,
+      rigging: sum.rigging + item.rigEstimate,
+    }),
+    { ready: 0, blocked: 0, generation: 0, rigging: 0 },
+  );
+}
+
+export function categoryOf(asset: InventoryAsset): WardrobeCategory {
+  return asset.category as WardrobeCategory;
+}
+
+/* ------------------------------ audit ------------------------------ */
+
+/** Bone names a GLB's skins actually bind to — her rig, as exported. */
+export function boneNamesFromGlb(bytes: Uint8Array): string[] {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  if (view.getUint32(0, true) !== 0x46546c67) throw new Error("Not a GLB.");
+  const chunkLength = view.getUint32(12, true);
+  const chunkType = view.getUint32(16, true);
+  if (chunkType !== 0x4e4f534a) throw new Error("GLB does not start with a JSON chunk.");
+  const json = JSON.parse(new TextDecoder().decode(bytes.subarray(20, 20 + chunkLength))) as {
+    nodes?: Array<{ name?: string }>;
+    skins?: Array<{ joints: number[] }>;
+  };
+  const names = new Set<string>();
+  for (const skin of json.skins ?? []) {
+    for (const joint of skin.joints) {
+      const name = json.nodes?.[joint]?.name;
+      if (name) names.add(name);
+    }
+  }
+  return [...names].sort();
+}
+
+export interface AssetFinding {
+  look: string;
+  asset: string;
+  severity: "problem" | "warning";
+  message: string;
+}
+
+/**
+ * Check every record against reality: the bones her rig actually has, the
+ * references actually on disk, and whether two assets would pay twice for
+ * the same geometry.
+ */
+export function auditInventory(
+  inventory: WardrobeInventory,
+  references: ReferenceRecord[],
+  rigBones: string[],
+): { findings: AssetFinding[]; problems: number; warnings: number } {
+  const byId = new Map(references.map((reference) => [reference.id, reference]));
+  const boneSet = new Set(rigBones.map((bone) => bone.toLowerCase()));
+  const findings: AssetFinding[] = [];
+  const seenReferences = new Map<string, string>();
+
+  for (const look of inventory.looks) {
+    for (const asset of look.assets) {
+      const add = (severity: AssetFinding["severity"], message: string) => findings.push({ look: look.id, asset: asset.id, severity, message });
+
+      if (asset.category !== "look") {
+        if (!asset.bone) add("problem", "no bone: a piece cannot be worn without one.");
+        else if (rigBones.length && !boneSet.has(asset.bone.toLowerCase())) add("problem", `bone "${asset.bone}" is not in her rig.`);
+      } else if (asset.isLook && !asset.rig) {
+        add("warning", "a complete look has to be rigged to animate on her skeleton.");
+      }
+      if (asset.category !== "look" && asset.rig) add("warning", "rigging a piece spends 5 credits for nothing; pieces are worn on a bone.");
+
+      if (!asset.references.length) add("problem", "no reference assigned.");
+      for (const id of asset.references) {
+        const reference = byId.get(id);
+        if (!reference) add("problem", `reference "${id}" is not ingested.`);
+        else if (reference.quality === "poor") add("warning", `reference "${id}" drifted to poor quality.`);
+      }
+      if (asset.generation.kind === "multi-image-to-3d" && asset.references.length < 2) {
+        add("problem", "a multi-image job needs at least two reference images.");
+      }
+
+      const key = [...asset.references].sort().join("|");
+      if (key) {
+        const twin = seenReferences.get(key);
+        if (twin) add("warning", `shares an identical reference set with "${twin}": check this is not duplicate geometry.`);
+        else seenReferences.set(key, asset.id);
+      }
+      if (!(asset.inferred ?? []).length && asset.category === "look") {
+        add("warning", "no inferred details documented, although no single view can show the back, lining or closures.");
+      }
+    }
+  }
+
+  return {
+    findings,
+    problems: findings.filter((finding) => finding.severity === "problem").length,
+    warnings: findings.filter((finding) => finding.severity === "warning").length,
+  };
+}
