@@ -0,0 +1,132 @@
+/**
+ * ==========================================================
+ * VERIFY — LÉLU OPERATES THE COSMOS THROUGH HER TOOL PIPELINE
+ *
+ * Not a test of WorkspaceAPI directly. This drives the REAL path a
+ * model's tool call takes:
+ *
+ *   ToolRegistry → ToolDispatcher.dispatchToolCall
+ *     → AutonomyGate permission check
+ *     → cosmos.workspace executor
+ *     → WorkspaceAPI (CosmosAutonomy policy)
+ *     → ApprovalGate (single-use) → the real stores
+ *
+ * Run: bunx tsx --tsconfig tsconfig.test.json scripts/verify-cosmos.ts
+ * ==========================================================
+ */
+
+const memory = new Map<string, string>();
+(globalThis as unknown as { window: unknown }).window = globalThis;
+(globalThis as unknown as { localStorage: unknown }).localStorage = {
+  getItem: (key: string) => memory.get(key) ?? null,
+  setItem: (key: string, value: string) => {
+    memory.set(key, String(value));
+  },
+  removeItem: (key: string) => {
+    memory.delete(key);
+  },
+  clear: () => memory.clear(),
+  key: (index: number) => [...memory.keys()][index] ?? null,
+  get length() {
+    return memory.size;
+  },
+};
+
+import { registerCosmosTools } from "../src/core/cosmos/CosmosTools";
+import { toolSchemaDiagnostics, toolSchemasForModel } from "../src/core/tools/ToolSchemas";
+import { dispatchToolCall, toolNameForModel } from "../src/core/tools/ToolDispatcher";
+import ApprovalGate from "../src/core/agentic/ApprovalGate";
+import CosmosNavigation from "../src/core/cosmos/CosmosNavigation";
+import { syncCosmosMap } from "../src/core/cosmos/CosmosLiveMap";
+
+const line = (label: string, value: string | number | boolean) => console.log(`  ${label.padEnd(34)} ${value}`);
+
+async function main(): Promise<void> {
+  console.log("\n=== 1. Registered, executable, and OFFERED to the model ===");
+  registerCosmosTools();
+  const diagnosed = toolSchemaDiagnostics().filter((entry) => entry.id.startsWith("cosmos."));
+  for (const entry of diagnosed) {
+    line(entry.id, `registered=${entry.registered} available=${entry.available} permitted=${entry.permitted} offered=${entry.offered}`);
+  }
+  const offered = toolSchemasForModel().filter((schema) => schema.name.startsWith("cosmos_"));
+  for (const schema of offered) {
+    line(`${schema.name} parameters`, `${Object.keys((schema.parameters.properties ?? {}) as Record<string, unknown>).join(", ")}`);
+  }
+
+  console.log("\n=== 2. Live map synchronised from the runtime ===");
+  const synced = await syncCosmosMap();
+  line("sync", `ok=${synced.ok} destinations=${synced.destinations} retired=${synced.retired}`);
+  const mapped = await dispatchToolCall(
+    { id: "verify-1", name: toolNameForModel("cosmos.map"), arguments: { sync: false } },
+    "verify-cosmos",
+  );
+  console.log(mapped.content.split("\n").map((text) => `  ${text}`).join("\n"));
+
+  console.log("\n=== 3. A green action runs immediately ===");
+  const navigated = await dispatchToolCall(
+    { id: "verify-2", name: toolNameForModel("cosmos.workspace"), arguments: { action: "navigate", roomId: "cosmos-core" } },
+    "verify-cosmos",
+  );
+  line("navigate → ok", navigated.ok);
+  line("navigate → content", navigated.content);
+
+  console.log("\n=== 4. A yellow action stops and asks, then runs once approved ===");
+  const asked = await dispatchToolCall(
+    {
+      id: "verify-3",
+      name: toolNameForModel("cosmos.workspace"),
+      arguments: { action: "create-room", room: { label: "Observatory" } },
+    },
+    "verify-cosmos",
+  );
+  const approvalId = (asked.data as { approvalId?: string } | undefined)?.approvalId;
+  line("first attempt ok (must be false)", asked.ok);
+  line("approval requested", approvalId ? approvalId.slice(0, 18) : "none");
+  line("room exists before approval", CosmosNavigation.getInstance().rooms().some((room) => room.label === "Observatory"));
+
+  if (approvalId) {
+    ApprovalGate.getInstance().decide(approvalId, "approved");
+    const approved = await dispatchToolCall(
+      {
+        id: "verify-4",
+        name: toolNameForModel("cosmos.workspace"),
+        arguments: { action: "create-room", room: { label: "Observatory" }, approvalId },
+      },
+      "verify-cosmos",
+    );
+    line("after approval ok", approved.ok);
+    line("approval spent (replay ok)", (await dispatchToolCall(
+      {
+        id: "verify-5",
+        name: toolNameForModel("cosmos.workspace"),
+        arguments: { action: "create-room", room: { label: "Observatory" }, approvalId },
+      },
+      "verify-cosmos",
+    )).ok);
+    line("room exists now", CosmosNavigation.getInstance().rooms().some((room) => room.label === "Observatory"));
+  }
+
+  console.log("\n=== 5. A protected action is not a tool at all ===");
+  const red = await dispatchToolCall(
+    { id: "verify-6", name: toolNameForModel("cosmos.workspace"), arguments: { action: "deploy" } },
+    "verify-cosmos",
+  );
+  line("deploy → ok", red.ok);
+  line("deploy → content", red.content.slice(0, 120));
+
+  console.log("\n=== 6. The map after the session ===");
+  const after = await dispatchToolCall(
+    { id: "verify-7", name: toolNameForModel("cosmos.map"), arguments: { sync: false } },
+    "verify-cosmos",
+  );
+  console.log(after.content.split("\n").map((text) => `  ${text}`).join("\n"));
+}
+
+// The subsystems these tools reach keep timers alive; the checks are done.
+main().then(
+  () => process.exit(0),
+  (error) => {
+    console.error(error);
+    process.exit(1);
+  },
+);
diff --git a/scripts/verify-engineer-auth.mjs b/scripts/verify-engineer-auth.mjs
new file mode 100644
index 0000000..eca00a4
--- /dev/null
+++ b/scripts/verify-engineer-auth.mjs
@@ -0,0 +1,276 @@
+/**
+ * LÉLU — IS THE ENGINEERING RUNTIME ACTUALLY CLOSED?
+ *
+ * Reports the answer a stranger on the internet would get, against the
+ * real production runtime (`bun server.ts` serving `dist/`), twice:
+ *
+ *   A. NO LELU_ENGINEER_TOKEN configured  → every route must refuse (503)
+ *   B. a token configured                 → missing/wrong → 401,
+ *                                           correct → the real work
+ *
+ * It asserts the refusal bodies leak nothing (no workspace path, no cwd,
+ * no operation list, no engine version) and that the origin guard still
+ * rejects a foreign Origin even WITH a valid token — the token must not
+ * buy a caller past CSRF.
+ *
+ * The servers are spawned and stopped by this script, so there is no
+ * state to forget between runs.
+ *
+ * Evidence: docs/evidence/engineer-auth/<stamp>/auth.json
+ * Usage: node scripts/verify-engineer-auth.mjs
+ */
+
+import { spawn } from "node:child_process";
+import { mkdirSync, writeFileSync } from "node:fs";
+import path from "node:path";
+
+const stamp = new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19);
+const OUT = path.join("docs", "evidence", "engineer-auth", stamp);
+mkdirSync(OUT, { recursive: true });
+
+const TOKEN = `verify-${Math.random().toString(36).slice(2)}${Date.now().toString(36)}`;
+const WRONG = `${TOKEN}-wrong`;
+const CWD = process.cwd();
+const PORT_A = 4181; // no token -> disabled
+const PORT_B = 4182; // token required
+
+const results = { stamp, node: process.version, checks: [], logs: {} };
+let failures = 0;
+
+function check(name, pass, detail) {
+  results.checks.push({ name, pass: Boolean(pass), detail });
+  if (!pass) failures += 1;
+  console.log(`${pass ? "PASS" : "FAIL"}  ${name}${detail ? ` — ${detail}` : ""}`);
+}
+
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+async function startServer(port, token) {
+  const env = { ...process.env, PORT: String(port) };
+  // The token must come from THIS script, never from an inherited
+  // environment or a .env file — otherwise "unset" is not being tested.
+  delete env.LELU_ENGINEER_TOKEN;
+  if (token) env.LELU_ENGINEER_TOKEN = token;
+
+  const child = spawn("bun", ["server.ts"], { env, stdio: ["ignore", "pipe", "pipe"] });
+  let log = "";
+  child.stdout.on("data", (chunk) => (log += String(chunk)));
+  child.stderr.on("data", (chunk) => (log += String(chunk)));
+
+  const deadline = Date.now() + 30_000;
+  while (Date.now() < deadline) {
+    try {
+      const response = await fetch(`http://127.0.0.1:${port}/`, { method: "HEAD" });
+      if (response.status > 0) return { child, log: () => log };
+    } catch {
+      /* not listening yet */
+    }
+    await sleep(200);
+  }
+  child.kill("SIGKILL");
+  throw new Error(`server did not start on :${port}\n${log}`);
+}
+
+function safeJson(text) {
+  try {
+    return JSON.parse(text);
+  } catch {
+    return null;
+  }
+}
+
+async function call(port, route, options = {}) {
+  const method = options.method ?? "POST";
+  const headers = { "content-type": "application/json", ...(options.headers ?? {}) };
+  if (options.token) headers["x-lelu-token"] = options.token;
+  if (options.legacyToken) headers["x-lelu-engineer-token"] = options.legacyToken;
+  if (options.origin) headers.origin = options.origin;
+  const response = await fetch(`http://127.0.0.1:${port}${route}`, {
+    method,
+    headers,
+    body: method === "POST" ? JSON.stringify(options.body ?? {}) : undefined,
+  });
+  const text = await response.text();
+  return { status: response.status, text, json: safeJson(text), headers: response.headers };
+}
+
+/** Nothing about the host may appear in a refusal. */
+function leaksHost(body) {
+  const leaks = [];
+  if (body.includes(CWD)) leaks.push("absolute cwd");
+  if (body.includes("workspaceRoot")) leaks.push("workspaceRoot");
+  if (body.includes("runtimeInfo")) leaks.push("runtimeInfo");
+  if (/"operations"\s*:/.test(body)) leaks.push("operation list");
+  if (/\b(1|2)\d\.\d+\.\d+/.test(body)) leaks.push("engine version");
+  if (body.includes(TOKEN)) leaks.push("the token itself");
+  return leaks;
+}
+
+const ROUTES_POST = [
+  "/api/engineer/command",
+  "/api/engineer/read",
+  "/api/engineer/list",
+  "/api/engineer/write",
+  "/api/engineer/workspace",
+  "/api/engineer/git",
+  "/api/engineer/search",
+  "/api/engineer/preview",
+  "/api/browser/capture",
+];
+
+async function main() {
+  let a = null;
+  let b = null;
+  try {
+    /* ============================================================ */
+    /* A. NOTHING CONFIGURED — the default a fresh VPS would run     */
+    /* ============================================================ */
+    a = await startServer(PORT_A, null);
+
+    const statusA = await call(PORT_A, "/api/engineer/status", { method: "GET" });
+    check(
+      "no token configured: status is refused, not served",
+      statusA.status === 503,
+      `HTTP ${statusA.status}`,
+    );
+    check(
+      "no token configured: the refusal says the runtime is disabled",
+      statusA.json?.disabled === true && statusA.json?.ok === false,
+      `disabled=${statusA.json?.disabled} ok=${statusA.json?.ok}`,
+    );
+    if (statusA.json?.tokenRequired === true) {
+      check(
+        "the environment does not supply LELU_ENGINEER_TOKEN (test isolation)",
+        false,
+        "a token arrived from the environment or .env — unset it before running this check",
+      );
+    }
+
+    const refused = [];
+    for (const route of ROUTES_POST) {
+      const response = await call(PORT_A, route, { body: { operation: "inspect", path: "package.json", query: "token", action: "create", workspace: "probe" } });
+      refused.push(`${route}=${response.status}`);
+      check(`no token configured: ${route} refuses`, response.status === 503, `HTTP ${response.status}`);
+    }
+    results.disabledResponses = refused;
+
+    const leaked = leaksHost(statusA.text);
+    check("no token configured: the refusal leaks nothing about the host", leaked.length === 0, leaked.join(", ") || `body: ${statusA.text.slice(0, 120)}`);
+
+    // The command route must never have executed anything.
+    check(
+      "no token configured: no command output is returned",
+      !/\d+\.\d+\.\d+/.test(statusA.text) && !statusA.text.includes("bun"),
+      "no version strings in the body",
+    );
+
+    check(
+      "the startup log states the runtime is disabled",
+      /engineering|\/api\/engineer/i.test(a.log()),
+      a.log().split("\n").filter((line) => /engineer/i.test(line)).slice(-1)[0] ?? "(no line)",
+    );
+    results.logs.disabled = a.log().slice(-1200);
+    a.child.kill("SIGTERM");
+    a = null;
+
+    /* ============================================================ */
+    /* B. A TOKEN CONFIGURED                                         */
+    /* ============================================================ */
+    b = await startServer(PORT_B, TOKEN);
+
+    const noToken = await call(PORT_B, "/api/engineer/status", { method: "GET" });
+    check("token configured: an unauthenticated status is 401", noToken.status === 401, `HTTP ${noToken.status}`);
+    check("token configured: the 401 tells the client a token is required", noToken.json?.tokenRequired === true, `tokenRequired=${noToken.json?.tokenRequired}`);
+    check("token configured: the 401 leaks no path, runtime info or operations", leaksHost(noToken.text).length === 0, leaksHost(noToken.text).join(", ") || "clean");
+
+    const wrongToken = await call(PORT_B, "/api/engineer/status", { method: "GET", token: WRONG });
+    check("token configured: an invalid token is 401", wrongToken.status === 401, `HTTP ${wrongToken.status}`);
+    check("an invalid token is never echoed back", !wrongToken.text.includes(WRONG), "token absent from the body");
+
+    const good = await call(PORT_B, "/api/engineer/status", { method: "GET", token: TOKEN });
+    check("token configured: a valid token gets the real report", good.status === 200 && good.json?.ok === true, `HTTP ${good.status}`);
+    check(
+      "the authorized report carries the workspace root and runtime info",
+      good.json?.workspaceRoot === CWD && Boolean(good.json?.runtimeInfo?.engine),
+      `workspaceRoot=${good.json?.workspaceRoot} engine=${good.json?.runtimeInfo?.engine}`,
+    );
+    check("the authorized report says tokenRequired:true", good.json?.tokenRequired === true, `tokenRequired=${good.json?.tokenRequired}`);
+
+    const legacy = await call(PORT_B, "/api/engineer/status", { method: "GET", legacyToken: TOKEN });
+    check(
+      "the legacy x-lelu-engineer-token header also authorizes (self-view routes use it)",
+      legacy.status === 200,
+      `HTTP ${legacy.status}`,
+    );
+
+    const commandAnonymous = await call(PORT_B, "/api/engineer/command", { body: { operation: "inspect" } });
+    check("an unauthenticated command does not run", commandAnonymous.status === 401 && !commandAnonymous.text.includes("bun"), `HTTP ${commandAnonymous.status}`);
+
+    const command = await call(PORT_B, "/api/engineer/command", { token: TOKEN, body: { operation: "inspect" } });
+    check(
+      "an authorized command still runs the real whitelisted operation",
+      command.status === 200 && command.json?.ok === true && command.json.stdout.length > 0,
+      `HTTP ${command.status}, stdout ${JSON.stringify((command.json?.stdout ?? "").slice(0, 40))}`,
+    );
+
+    const read = await call(PORT_B, "/api/engineer/read", { token: TOKEN, body: { path: "package.json" } });
+    check("an authorized read still returns source", read.status === 200 && String(read.json?.content ?? "").includes('"name"'), `HTTP ${read.status}`);
+    const readAnon = await call(PORT_B, "/api/engineer/read", { body: { path: "package.json" } });
+    check("an unauthenticated read returns no source", readAnon.status === 401 && !readAnon.text.includes('"name"'), `HTTP ${readAnon.status}`);
+
+    const writeAnon = await call(PORT_B, "/api/engineer/write", { body: { path: "package.json", content: "{}" } });
+    check("an unauthenticated write is refused before any other check", writeAnon.status === 401, `HTTP ${writeAnon.status}`);
+    const writeLive = await call(PORT_B, "/api/engineer/write", { token: TOKEN, body: { path: "package.json", content: "{}" } });
+    check(
+      "an authorized write STILL cannot touch the live project",
+      writeLive.status === 403 && String(writeLive.json?.error ?? "").includes("workspace"),
+      `HTTP ${writeLive.status}: ${String(writeLive.json?.error ?? "").slice(0, 70)}`,
+    );
+
+    const foreign = await call(PORT_B, "/api/engineer/command", {
+      token: TOKEN,
+      origin: "https://evil.example",
+      body: { operation: "inspect" },
+    });
+    check(
+      "a valid token does NOT buy a caller past the origin guard",
+      foreign.status === 403,
+      `HTTP ${foreign.status} for Origin: https://evil.example`,
+    );
+
+    const preflight = await call(PORT_B, "/api/engineer/command", { method: "OPTIONS", origin: "https://app.example" });
+    check("a preflight is answered without authorizing anything", preflight.status === 204, `HTTP ${preflight.status}`);
+
+    const search = await call(PORT_B, "/api/engineer/search", { token: TOKEN, body: { query: "engineerAuthVerdict", limit: 3 } });
+    check(
+      "search (self-view route) works with the token the app actually sends",
+      search.status === 200 && (search.json?.matches?.length ?? 0) > 0,
+      `HTTP ${search.status}, ${search.json?.matches?.length ?? 0} match(es)`,
+    );
+
+    const preview = await call(PORT_B, "/api/engineer/preview", { token: TOKEN, body: { action: "status" } });
+    check("preview (self-view route) answers only when authorized", preview.status === 200, `HTTP ${preview.status}`);
+
+    results.logs.token = b.log().slice(-1200);
+    b.child.kill("SIGTERM");
+    b = null;
+  } finally {
+    for (const running of [a, b]) {
+      if (running) {
+        running.child.kill("SIGKILL");
+      }
+    }
+  }
+
+  const pass = results.checks.filter((entry) => entry.pass).length;
+  results.pass = pass;
+  results.total = results.checks.length;
+  writeFileSync(path.join(OUT, "auth.json"), JSON.stringify(results, null, 2));
+  console.log(`\n${pass}/${results.checks.length} engineering-auth checks passed — evidence in ${OUT}/auth.json`);
+  process.exit(failures === 0 ? 0 : 1);
+}
+
+main().catch((error) => {
+  console.error("verify-engineer-auth failed:", error);
+  process.exit(1);
+});
diff --git a/scripts/verify-mobile-model-cache.mjs b/scripts/verify-mobile-model-cache.mjs
new file mode 100644
index 0000000..5812a4c
--- /dev/null
+++ b/scripts/verify-mobile-model-cache.mjs
@@ -0,0 +1,443 @@
+/**
+ * LÉLU — DOES A PHONE DOWNLOAD THE MODEL AGAIN?
+ *
+ * The 49 MB-accepting question, asked in a real mobile browser (Chromium,
+ * Pixel 5 emulation) against the production build:
+ *
+ *   1. a first visit: how many bytes actually cross the network;
+ *   2. a repeat visit in the SAME profile: zero from the network, or the
+ *      whole model again;
+ *   3. what the service worker keeps in Cache Storage;
+ *   4. whether a 49 MB ArrayBuffer survives in IndexedDB — which is how
+ *      the reconstruction pipeline actually keeps a model — and can be
+ *      read back byte-identical;
+ *   5. what happens when the user clears browser storage;
+ *   6. what happens when IndexedDB is unavailable at all.
+ *
+ * Byte counts come from CDP `Network.loadingFinished.encodedDataLength`
+ * for the model request, so "cached" is measured, not assumed.
+ *
+ * Evidence: docs/evidence/asset-caching/<stamp>/mobile.json
+ * Usage: node scripts/verify-mobile-model-cache.mjs [baseUrl]
+ */
+
+import { chromium, devices } from "playwright";
+import { mkdirSync, writeFileSync, mkdtempSync, rmSync, existsSync, statSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const BASE = (process.argv[2] ?? "http://127.0.0.1:5173/").replace(/\/?$/, "/");
+const MODEL_PATH = "/models/lelu-character.glb";
+const ORIGIN = new URL(BASE).origin;
+const stamp = new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19);
+const OUT = path.join("docs", "evidence", "asset-caching", stamp);
+mkdirSync(OUT, { recursive: true });
+
+/* ------------------------------------------------------------------ */
+/* the 49 MB model under test                                          */
+/*                                                                     */
+/* No GLB exists in this project yet (the Forge jobs are still         */
+/* awaiting approval), so the size the deployment brief asks about is  */
+/* created here and served by the runtime's OWN static handler — so the */
+/* cache headers being measured are the production ones, not a mock.   */
+/* It is removed on exit: a 49 MB file left in dist/ would be served   */
+/* to real users.                                                      */
+/* ------------------------------------------------------------------ */
+const MODEL_SIZE = 49 * 1024 * 1024;
+const FIXTURE_DIR = path.join("dist", "models");
+const FIXTURE_FILE = path.join(FIXTURE_DIR, "lelu-character.glb");
+
+function writeFixture(marker) {
+  if (!existsSync(path.join("dist", "index.html"))) {
+    throw new Error("dist/ is missing — run `bun run build` before this check.");
+  }
+  const buffer = Buffer.alloc(MODEL_SIZE, 0x67);
+  buffer.write("glTF", 0, "ascii");
+  // A byte no real GLB uses, so a REPLACED model is distinguishable
+  // from the original without hashing 49 MB over the wire.
+  buffer[8] = marker;
+  mkdirSync(FIXTURE_DIR, { recursive: true });
+  writeFileSync(FIXTURE_FILE, buffer);
+}
+
+function removeFixture() {
+  rmSync(FIXTURE_DIR, { recursive: true, force: true });
+}
+
+process.on("exit", () => {
+  try {
+    removeFixture();
+  } catch {
+    /* nothing left to clean */
+  }
+});
+
+const results = { stamp, base: BASE, checks: [], measurements: {} };
+const check = (name, pass, detail) => {
+  results.checks.push({ name, pass: Boolean(pass), detail });
+  console.log(`${pass ? "PASS" : "FAIL"}  ${name}${detail ? ` — ${detail}` : ""}`);
+};
+
+/** Network bytes per model request, straight from the browser. */
+function watchModelBytes(cdp) {
+  const pending = new Map();
+  const seen = [];
+  cdp.on("Network.responseReceived", (event) => {
+    if (!event.response.url.includes(MODEL_PATH)) return;
+    pending.set(event.requestId, {
+      url: event.response.url,
+      status: event.response.status,
+      fromDiskCache: event.response.fromDiskCache === true,
+      fromServiceWorker: event.response.fromServiceWorker === true,
+      fromPrefetchCache: event.response.fromPrefetchCache === true,
+      encodedDataLength: event.response.encodedDataLength,
+    });
+  });
+  cdp.on("Network.loadingFinished", (event) => {
+    const entry = pending.get(event.requestId);
+    if (!entry) return;
+    entry.encodedDataLength = event.encodedDataLength;
+    seen.push(entry);
+    pending.delete(event.requestId);
+  });
+  return {
+    take() {
+      const taken = seen.splice(0, seen.length);
+      return taken;
+    },
+  };
+}
+
+const fetchModel = (page) =>
+  page.evaluate(async (url) => {
+    const started = performance.now();
+    const response = await fetch(url, { cache: "default" });
+    const body = await response.arrayBuffer();
+    return {
+      status: response.status,
+      bytesReceived: body.byteLength,
+      ms: Math.round(performance.now() - started),
+      cacheControl: response.headers.get("cache-control"),
+      etag: response.headers.get("etag"),
+      // Enough of the body to tell one version of the model from another.
+      probe: Array.from(new Uint8Array(body.slice(0, 12))),
+    };
+  }, MODEL_PATH);
+
+async function visit(context, label) {
+  const page = context.pages()[0] ?? (await context.newPage());
+  const errors = [];
+  page.on("pageerror", (error) => errors.push(String(error)));
+  await page.goto(BASE, { waitUntil: "domcontentloaded" });
+  const swReady = await page
+    .evaluate(() => Promise.race([navigator.serviceWorker.ready.then(() => true), new Promise((r) => setTimeout(() => r(false), 8000))]))
+    .catch(() => false);
+  return { page, errors, swReady, label };
+}
+
+async function main() {
+  writeFixture(0x11);
+  console.log(`fixture: ${FIXTURE_FILE} (${(statSync(FIXTURE_FILE).size / 1024 / 1024).toFixed(0)} MB)\n`);
+
+  const profile = mkdtempSync(path.join(os.tmpdir(), "lelu-cache-"));
+
+  /* ------------------------------------------------------------ */
+  /* 1. first visit, then the same visit again in the same profile */
+  /* ------------------------------------------------------------ */
+  const context = await chromium.launchPersistentContext(profile, {
+    ...devices["Pixel 5"],
+    headless: true,
+    args: ["--no-sandbox"],
+  });
+  const first = await visit(context, "first visit");
+  const cdp = await context.newCDPSession(first.page);
+  await cdp.send("Network.enable");
+  const watcher = watchModelBytes(cdp);
+
+  check("the service worker becomes active on mobile", first.swReady, `ready=${first.swReady}`);
+
+  // Does a plain load of the app request the model at all?
+  const loadRequests = await first.page.evaluate(() =>
+    performance.getEntriesByType("resource").filter((e) => e.name.includes("lelu-character.glb")).length,
+  );
+  results.measurements.appRequestsModelOnLoad = loadRequests > 0;
+  check(
+    "reported honestly: the app does not fetch a GLB on load",
+    loadRequests === 0,
+    `${loadRequests} requests for the model during a plain load (the avatar is the 2.5D rig)`,
+  );
+
+  const original = await fetchModel(first.page);
+  await first.page.waitForTimeout(400);
+  const firstFetch = watcher.take();
+  results.measurements.firstVisit = firstFetch;
+  const firstBytes = firstFetch.reduce((sum, entry) => sum + (entry.encodedDataLength || 0), 0);
+  check("first visit downloads the model from the network", firstBytes > 1_000_000, `${(firstBytes / 1024 / 1024).toFixed(1)} MB over the wire`);
+
+  // Repeat visit: reload the app, then ask for the model again.
+  await first.page.reload({ waitUntil: "domcontentloaded" });
+  await first.page.waitForTimeout(500);
+  const second = await fetchModel(first.page);
+  await first.page.waitForTimeout(400);
+  const secondFetch = watcher.take();
+  results.measurements.repeatVisit = { fetch: second, network: secondFetch };
+  const repeatBytes = secondFetch.reduce((sum, entry) => sum + (entry.encodedDataLength || 0), 0);
+  const servedLocally = secondFetch.some((entry) => entry.fromDiskCache || entry.fromServiceWorker || entry.fromPrefetchCache);
+  check(
+    "repeat visit does NOT download the model again",
+    repeatBytes < 100_000,
+    `${(repeatBytes / 1024).toFixed(0)} KB over the wire after a reload; served by ${servedLocally ? "browser cache / service worker" : "an uncached network read"}`,
+  );
+  check("repeat visit still returns all the bytes to the page", second.bytesReceived === first.bytesReceived, `${second.bytesReceived} vs ${first.bytesReceived} bytes`);
+
+  /* ------------------------------------------------------------ */
+  /* 2. what the service worker keeps                              */
+  /* ------------------------------------------------------------ */
+  const cacheInventory = await first.page.evaluate(async () => {
+    const names = await caches.keys();
+    const contents = {};
+    let modelCopies = 0;
+    for (const name of names) {
+      const cache = await caches.open(name);
+      const keys = await cache.keys();
+      contents[name] = keys.map((request) => request.url);
+      modelCopies += keys.filter((request) => request.url.includes("lelu-character.glb")).length;
+    }
+    return { names, contents, modelCopies };
+  });
+  results.measurements.cacheStorage = cacheInventory;
+  check(
+    "Cache Storage does not keep a second 49 MB copy of the model",
+    cacheInventory.modelCopies === 0,
+    `${cacheInventory.modelCopies} model copies in ${cacheInventory.names.length} cache(s)`,
+  );
+
+  const estimate = await first.page.evaluate(async () => {
+    const usage = await navigator.storage.estimate();
+    return { usage: usage.usage, quota: usage.quota };
+  });
+  results.measurements.storageEstimate = estimate;
+
+  /* ------------------------------------------------------------ */
+  /* 3. the real persistence path: a 49 MB GLB in IndexedDB        */
+  /* ------------------------------------------------------------ */
+  const idb = await first.page.evaluate(async () => {
+    const SIZE = 49 * 1024 * 1024;
+    const openDb = () =>
+      new Promise((resolve, reject) => {
+        const request = indexedDB.open("lelu-avatar-3d", 1);
+        request.onupgradeneeded = () => request.result.createObjectStore("models");
+        request.onsuccess = () => resolve(request.result);
+        request.onerror = () => reject(request.error ?? new Error("open failed"));
+      });
+    const db = await openDb();
+    const buffer = new ArrayBuffer(SIZE);
+    const view = new Uint8Array(buffer);
+    for (let i = 0; i < SIZE; i += 4096) view[i] = (i / 4096) % 251; // a checkable pattern
+
+    const persist = (model) =>
+      new Promise((resolve, reject) => {
+        const tx = db.transaction("models", "readwrite");
+        tx.objectStore("models").put(model, "reconstructed");
+        tx.oncomplete = () => resolve(true);
+        tx.onerror = () => reject(tx.error ?? new Error("write failed"));
+      });
+    const read = () =>
+      new Promise((resolve, reject) => {
+        const tx = db.transaction("models", "readonly");
+        const request = tx.objectStore("models").get("reconstructed");
+        request.onsuccess = () => resolve(request.result ?? null);
+        request.onerror = () => reject(request.error ?? new Error("read failed"));
+      });
+
+    const writeStart = performance.now();
+    let writeError = null;
+    try {
+      await persist({ glb: buffer, fingerprint: "test", taskId: "test", createdAt: Date.now() });
+    } catch (error) {
+      writeError = String(error.message ?? error);
+    }
+    const writeMs = Math.round(performance.now() - writeStart);
+
+    const readStart = performance.now();
+    const restored = await read();
+    const readMs = Math.round(performance.now() - readStart);
+    const bytes = restored?.glb?.byteLength ?? 0;
+    let identical = false;
+    if (restored?.glb) {
+      const out = new Uint8Array(restored.glb);
+      identical = out[0] === 0 && out[4096] === 1 && out[8192] === 2 && out.length === SIZE;
+    }
+    db.close();
+    return { size: SIZE, writeError, writeMs, readMs, bytes, identical };
+  });
+  results.measurements.indexedDb = idb;
+  check("a 49 MB model is writable to IndexedDB on mobile", idb.writeError === null, idb.writeError ?? `wrote in ${idb.writeMs} ms`);
+  check("a 49 MB model survives the round trip byte-identically", idb.identical && idb.bytes === idb.size, `${idb.bytes} bytes read in ${idb.readMs} ms`);
+  check("the persisted model is not re-downloaded on a later visit", idb.readMs < 3000, `local read took ${idb.readMs} ms — no network involved`);
+
+  /* ------------------------------------------------------------ */
+  /* 4. the user clears browser storage                            */
+  /* ------------------------------------------------------------ */
+  await cdp.send("Storage.clearDataForOrigin", { origin: ORIGIN, storageTypes: "all" });
+  await first.page.reload({ waitUntil: "domcontentloaded" });
+  await first.page.waitForTimeout(600);
+  const afterClear = await fetchModel(first.page);
+  await first.page.waitForTimeout(400);
+  const clearedNetwork = watcher.take();
+  const clearedBytes = clearedNetwork.reduce((sum, entry) => sum + (entry.encodedDataLength || 0), 0);
+  results.measurements.afterClear = { fetch: afterClear, network: clearedNetwork };
+  check(
+    "after storage is cleared the model is fetched in full again",
+    clearedBytes > 1_000_000,
+    `${(clearedBytes / 1024 / 1024).toFixed(1)} MB re-downloaded, which is the documented cost of a cache clear`,
+  );
+
+  const idbAfterClear = await first.page.evaluate(async () => {
+    const names = await indexedDB.databases();
+    return names.map((entry) => entry.name);
+  });
+  check("clearing storage removes the persisted model", !idbAfterClear.includes("lelu-avatar-3d"), `databases now: ${JSON.stringify(idbAfterClear)}`);
+
+  /* ------------------------------------------------------------ */
+  /* 5. a replaced model must never be served stale                */
+  /* ------------------------------------------------------------ */
+  writeFixture(0x42); // same URL, different bytes
+  await first.page.reload({ waitUntil: "domcontentloaded" });
+  await first.page.waitForTimeout(500);
+  const replaced = await fetchModel(first.page);
+  await first.page.waitForTimeout(300);
+  results.measurements.replacedModel = { fetch: replaced, network: watcher.take() };
+  check(
+    "a replaced model at the same URL is not served from a stale cache",
+    Array.isArray(replaced.probe) && replaced.probe[8] !== original.probe[8],
+    `version byte ${original.probe?.[8]} → ${replaced.probe?.[8]}`,
+  );
+  check(
+    "a replaced model carries a new validator, so a 304 cannot be faked",
+    Boolean(replaced.etag) && replaced.etag !== original.etag,
+    `${original.etag} → ${replaced.etag}`,
+  );
+  const modelInSwCache = await first.page.evaluate(async () => {
+    const names = await caches.keys();
+    let copies = 0;
+    for (const name of names) {
+      const keys = await (await caches.open(name)).keys();
+      copies += keys.filter((request) => request.url.includes("lelu-character.glb")).length;
+    }
+    return copies;
+  });
+  check(
+    "the service worker never keeps its own copy of a model",
+    modelInSwCache === 0,
+    `${modelInSwCache} copies in Cache Storage after two versions of the model were fetched`,
+  );
+
+  /* ------------------------------------------------------------ */
+  /* 6. a refused IndexedDB write, and the recovery path           */
+  /* ------------------------------------------------------------ */
+  const resilience = await first.page.evaluate(async () => {
+    const openDb = () =>
+      new Promise((resolve, reject) => {
+        const request = indexedDB.open("lelu-avatar-3d", 1);
+        request.onupgradeneeded = () => request.result.createObjectStore("models");
+        request.onsuccess = () => resolve(request.result);
+        request.onerror = () => reject(request.error ?? new Error("open failed"));
+      });
+    const db = await openDb();
+    const proto = IDBObjectStore.prototype;
+    const originalPut = proto.put;
+    const write = () =>
+      new Promise((resolve, reject) => {
+        const tx = db.transaction("models", "readwrite");
+        tx.objectStore("models").put(new ArrayBuffer(1024), "reconstructed");
+        tx.oncomplete = () => resolve(true);
+        tx.onerror = () => reject(tx.error ?? new Error("write failed"));
+      });
+
+    // A browser refusing the write: quota exhausted, or a private-mode rule.
+    let refused = null;
+    proto.put = function blocked() {
+      throw new DOMException("simulated quota", "QuotaExceededError");
+    };
+    try {
+      await write();
+    } catch (error) {
+      refused = String(error?.name ?? error?.message ?? error);
+    } finally {
+      proto.put = originalPut;
+    }
+
+    // The same write once the pressure is gone — the retry path.
+    let recovered = false;
+    try {
+      recovered = (await write()) === true;
+    } catch {
+      recovered = false;
+    }
+    db.close();
+    return { refused, recovered };
+  });
+  results.measurements.indexedDbResilience = resilience;
+  check(
+    "a refused IndexedDB write fails loudly instead of silently",
+    resilience.refused === "QuotaExceededError",
+    `refused with ${resilience.refused}`,
+  );
+  check(
+    "the same write succeeds on retry, so a paid model is recoverable",
+    resilience.recovered === true,
+    "retry stored the record",
+  );
+
+  await context.close();
+
+  /* ------------------------------------------------------------ */
+  /* 5. IndexedDB unavailable entirely                             */
+  /* ------------------------------------------------------------ */
+  const blockedProfile = mkdtempSync(path.join(os.tmpdir(), "lelu-nostore-"));
+  const blockedContext = await chromium.launchPersistentContext(blockedProfile, {
+    ...devices["Pixel 5"],
+    headless: true,
+    args: ["--no-sandbox"],
+  });
+  await blockedContext.addInitScript(() => {
+    // A browser with storage blocked (private mode policies, enterprise
+    // lockdown): every access throws, as Safari and Chrome can do.
+    Object.defineProperty(window, "indexedDB", {
+      configurable: true,
+      get() {
+        throw new Error("IndexedDB is disabled in this browser");
+      },
+    });
+  });
+  const blocked = await visit(blockedContext, "storage blocked");
+  await blocked.page.waitForTimeout(1500);
+  const rendered = await blocked.page.evaluate(() => document.querySelector("#root")?.childElementCount ?? 0);
+  const graceful = await blocked.page.evaluate(() => {
+    try {
+      indexedDB.open("lelu-avatar-3d", 1);
+      return { threw: false };
+    } catch (error) {
+      return { threw: true, message: String(error.message ?? error) };
+    }
+  });
+  results.measurements.storageBlocked = { rendered, graceful, errors: blocked.errors };
+  check("the app still renders with IndexedDB disabled", rendered > 0, `${rendered} root children`);
+  check("no uncaught page error when storage is unavailable", blocked.errors.length === 0, blocked.errors.slice(0, 3).join(" | ") || "none");
+  check("storage access is the thing that fails, not the app", graceful.threw, graceful.message ?? "did not throw");
+  await blockedContext.close();
+
+  /* ------------------------------------------------------------ */
+  const pass = results.checks.filter((c) => c.pass).length;
+  results.pass = pass;
+  results.total = results.checks.length;
+  writeFileSync(path.join(OUT, "mobile.json"), JSON.stringify(results, null, 2));
+  console.log(`\n${pass}/${results.checks.length} mobile cache checks passed — evidence in ${OUT}/mobile.json`);
+  process.exit(pass === results.checks.length ? 0 : 1);
+}
+
+main().catch((error) => {
+  console.error("verify-mobile-model-cache failed:", error);
+  process.exit(1);
+});
