+/**
+ * Aurora site — the logic that is worth testing.
+ *
+ * Pure functions only: no DOM, no globals. The browser module imports the
+ * same file the test suite does, so a passing test says something about
+ * the page and not about a copy of it.
+ */
+
+export const PROJECTS = [
+  { id: "pulse", name: "Pulse Board", tags: ["product", "systems"] },
+  { id: "orchard", name: "Night Orchard", tags: ["brand"] },
+  { id: "quiet", name: "Quiet Hours", tags: ["product"] },
+  { id: "atlas", name: "Atlas Index", tags: ["systems"] },
+  { id: "solstice", name: "Solstice Field", tags: ["brand", "product"] },
+];
+
+export const FILTERS = ["all", "product", "brand", "systems"];
+
+/** Which projects survive a filter chip. Unknown filters behave like "all". */
+export function filterProjects(projects, filter) {
+  if (!FILTERS.includes(filter) || filter === "all") return [...projects];
+  return projects.filter((project) => project.tags.includes(filter));
+}
+
+/** "Showing 2 of 5 projects." — singular/plural handled. */
+export function describeCount(shown, total) {
+  const noun = shown === 1 ? "project" : "projects";
+  return `Showing ${shown} of ${total} ${noun}.`;
+}
+
+const EMAIL = /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i;
+
+/**
+ * Validate the contact form. Returns a map of field → message; an empty
+ * object means the form may be submitted.
+ */
+export function validateContact(values) {
+  const errors = {};
+  const name = String(values.name ?? "").trim();
+  const email = String(values.email ?? "").trim();
+  const message = String(values.message ?? "").trim();
+
+  if (name.length < 2) errors.name = "Please enter your name (at least 2 characters).";
+  if (!EMAIL.test(email)) errors.email = "That email address does not look complete.";
+  if (message.length < 10) errors.message = "A sentence, please — at least 10 characters.";
+
+  return errors;
+}
+
+/** Theme is one of two values; anything unknown falls back to night. */
+export function nextTheme(current) {
+  return current === "day" ? "night" : "day";
+}
+
+export function themeLabel(theme) {
+  return theme === "day" ? "Day" : "Night";
+}
+
+/** What the form reports after a successful submit. */
+export function confirmationMessage(name) {
+  const safe = String(name ?? "").trim();
+  return `Thanks${safe ? `, ${safe}` : ""} — the brief is ready to send. This demo does not contact a server.`;
+}
diff --git a/studio/templates/website/src/site.js b/studio/templates/website/src/site.js
new file mode 100644
index 0000000..7eaa895
--- /dev/null
+++ b/studio/templates/website/src/site.js
@@ -0,0 +1,141 @@
+import {
+  PROJECTS,
+  confirmationMessage,
+  describeCount,
+  filterProjects,
+  nextTheme,
+  themeLabel,
+  validateContact,
+} from "./logic.js";
+
+const root = document.documentElement;
+const nav = document.getElementById("site-nav");
+const menuToggle = document.getElementById("menu-toggle");
+const themeToggle = document.getElementById("theme-toggle");
+const filters = document.getElementById("filters");
+const grid = document.getElementById("work-grid");
+const resultCount = document.getElementById("result-count");
+const emptyState = document.getElementById("empty-state");
+const form = document.getElementById("contact-form");
+const formStatus = document.getElementById("form-status");
+const year = document.getElementById("year");
+
+const STORE_KEY = "aurora.theme";
+const cards = [...grid.querySelectorAll(".card")];
+
+if (year) year.textContent = String(new Date().getFullYear());
+
+/* ------------------------------- theme -------------------------------- */
+
+function applyTheme(theme) {
+  const value = theme === "day" ? "day" : "night";
+  root.dataset.theme = value;
+  themeToggle?.setAttribute("aria-pressed", String(value === "day"));
+  const label = themeToggle?.querySelector(".theme-label");
+  if (label) label.textContent = themeLabel(value);
+  try {
+    localStorage.setItem(STORE_KEY, value);
+  } catch {
+    /* storage can be blocked; the theme still applies for this visit */
+  }
+}
+
+let storedTheme = "night";
+try {
+  storedTheme = localStorage.getItem(STORE_KEY) || "night";
+} catch {
+  storedTheme = "night";
+}
+applyTheme(storedTheme);
+
+themeToggle?.addEventListener("click", () => {
+  applyTheme(nextTheme(root.dataset.theme === "day" ? "day" : "night"));
+});
+
+/* ----------------------------- mobile nav ------------------------------ */
+
+function closeNav() {
+  nav?.classList.remove("is-open");
+  menuToggle?.setAttribute("aria-expanded", "false");
+}
+
+menuToggle?.addEventListener("click", () => {
+  const open = nav?.classList.toggle("is-open") ?? false;
+  menuToggle.setAttribute("aria-expanded", String(open));
+});
+
+nav?.addEventListener("click", (event) => {
+  if (event.target instanceof HTMLAnchorElement) closeNav();
+});
+
+document.addEventListener("keydown", (event) => {
+  if (event.key === "Escape") closeNav();
+});
+
+/* ------------------------------- filters ------------------------------- */
+
+function applyFilter(filter) {
+  const visible = filterProjects(PROJECTS, filter).map((project) => project.id);
+  for (const card of cards) {
+    const id = card.querySelector("h3")?.textContent?.toLowerCase().split(" ")[0] ?? "";
+    const match = visible.some((visibleId) => id.startsWith(visibleId));
+    card.hidden = !match;
+  }
+  if (resultCount) resultCount.textContent = describeCount(visible.length, PROJECTS.length);
+  if (emptyState) emptyState.hidden = visible.length > 0;
+  for (const chip of filters?.querySelectorAll("[data-filter]") ?? []) {
+    const active = chip.getAttribute("data-filter") === filter;
+    chip.classList.toggle("is-active", active);
+    chip.setAttribute("aria-pressed", String(active));
+  }
+}
+
+filters?.addEventListener("click", (event) => {
+  const chip = event.target instanceof Element ? event.target.closest("[data-filter]") : null;
+  if (chip) applyFilter(chip.getAttribute("data-filter") || "all");
+});
+
+applyFilter("all");
+
+/* -------------------------------- form --------------------------------- */
+
+function setFieldError(name, message) {
+  const field = form?.elements.namedItem(name);
+  const error = document.getElementById(`${name}-error`);
+  if (field instanceof HTMLElement) {
+    field.setAttribute("aria-invalid", message ? "true" : "false");
+  }
+  if (error) {
+    error.textContent = message || "";
+    error.hidden = !message;
+  }
+}
+
+form?.addEventListener("submit", (event) => {
+  event.preventDefault();
+  const data = new FormData(form);
+  const values = {
+    name: String(data.get("name") ?? ""),
+    email: String(data.get("email") ?? ""),
+    message: String(data.get("message") ?? ""),
+  };
+  const errors = validateContact(values);
+  for (const field of ["name", "email", "message"]) {
+    setFieldError(field, errors[field] || "");
+  }
+  if (formStatus) {
+    formStatus.hidden = Object.keys(errors).length > 0;
+    formStatus.textContent = Object.keys(errors).length > 0 ? "" : confirmationMessage(values.name);
+  }
+  if (Object.keys(errors).length === 0) {
+    form.reset();
+    for (const field of ["name", "email", "message"]) setFieldError(field, "");
+  }
+});
+
+for (const input of form?.querySelectorAll("input, textarea") ?? []) {
+  input.addEventListener("input", () => {
+    const name = input.getAttribute("name");
+    if (name) setFieldError(name, "");
+  });
+}
