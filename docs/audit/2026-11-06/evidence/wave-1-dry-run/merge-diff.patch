diff --git a/studio/templates/application/styles.css b/studio/templates/application/styles.css
new file mode 100644
index 0000000..47884ed
--- /dev/null
+++ b/studio/templates/application/styles.css
@@ -0,0 +1,191 @@
+:root {
+  color-scheme: dark;
+  --bg: #080d18;
+  --panel: rgba(19, 28, 47, 0.78);
+  --line: rgba(148, 163, 184, 0.2);
+  --text: #e9eefb;
+  --muted: #9aabc9;
+  --accent: #67e8f9;
+  --accent-dark: #0e7490;
+  --danger: #fca5a5;
+  --todo: #fbbf24;
+  --doing: #a78bfa;
+  --done: #34d399;
+  font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  min-height: 100vh;
+  background:
+    radial-gradient(55rem 32rem at 8% -10%, rgba(34, 211, 238, 0.16), transparent 60%),
+    var(--bg);
+  color: var(--text);
+  line-height: 1.55;
+}
+
+h1, h2 { margin: 0; letter-spacing: -0.015em; }
+h1 { font-size: 1.2rem; }
+h2 { font-size: 1rem; }
+
+.sr-only {
+  position: absolute;
+  width: 1px; height: 1px;
+  padding: 0; margin: -1px;
+  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
+}
+
+.topbar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.75rem;
+  padding: 1rem clamp(1rem, 4vw, 2.4rem);
+  border-bottom: 1px solid var(--line);
+  background: rgba(8, 13, 24, 0.85);
+  backdrop-filter: blur(12px);
+  position: sticky;
+  top: 0;
+  z-index: 5;
+}
+
+.brand { display: flex; align-items: center; gap: 0.7rem; }
+.brand .dot {
+  width: 0.7rem; height: 0.7rem; border-radius: 50%;
+  background: var(--accent);
+  box-shadow: 0 0 14px var(--accent);
+}
+.sub { margin: 0.1rem 0 0; color: var(--muted); font-size: 0.8rem; }
+
+.connection {
+  margin: 0;
+  font-size: 0.8rem;
+  color: var(--muted);
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  padding: 0.3rem 0.8rem;
+}
+.connection.is-live { color: var(--done); border-color: rgba(52, 211, 153, 0.4); }
+.connection.is-down { color: var(--danger); border-color: rgba(252, 165, 165, 0.4); }
+
+main { width: min(1120px, 94vw); margin: 0 auto; padding: 1.4rem 0 3rem; }
+
+.composer {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  padding: 1rem;
+  margin-bottom: 1rem;
+}
+.composer h2 { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); margin-bottom: 0.6rem; }
+
+#task-form {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(110px, auto) auto;
+  gap: 0.6rem;
+}
+
+input, select, button {
+  font: inherit;
+  color: var(--text);
+  background: rgba(255, 255, 255, 0.06);
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  padding: 0.65rem 0.8rem;
+  min-height: 44px;
+}
+input::placeholder { color: var(--muted); }
+input:focus-visible, select:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+button[type="submit"] { background: var(--accent); color: #04121a; font-weight: 650; border-color: transparent; cursor: pointer; }
+
+.stats {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 0.6rem;
+  margin-bottom: 1rem;
+}
+.stats div {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 14px;
+  padding: 0.7rem 0.9rem;
+  display: flex;
+  flex-direction: column;
+}
+.stats span { font-size: clamp(1.2rem, 3vw, 1.6rem); font-weight: 650; font-variant-numeric: tabular-nums; }
+.stats small { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; }
+
+.board {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 0.8rem;
+  align-items: start;
+}
+.lane {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  padding: 0.85rem;
+  min-width: 0;
+}
+.lane header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.7rem; }
+.lane[data-lane="todo"] h2 { color: var(--todo); }
+.lane[data-lane="doing"] h2 { color: var(--doing); }
+.lane[data-lane="done"] h2 { color: var(--done); }
+.count {
+  font-size: 0.75rem;
+  color: var(--muted);
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  padding: 0.05rem 0.5rem;
+  font-variant-numeric: tabular-nums;
+}
+
+.tasks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
+.task {
+  background: rgba(255, 255, 255, 0.04);
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  padding: 0.65rem 0.7rem;
+  display: grid;
+  gap: 0.45rem;
+  min-width: 0;
+}
+.task-title { font-size: 0.9rem; overflow-wrap: anywhere; margin: 0; }
+.task-meta { display: flex; flex-wrap: wrap; gap: 0.35rem; }
+.task button {
+  font-size: 0.72rem;
+  padding: 0.3rem 0.55rem;
+  min-height: 32px;
+  border-radius: 8px;
+  cursor: pointer;
+}
+.task button.danger { color: var(--danger); border-color: rgba(252, 165, 165, 0.35); }
+.empty { color: var(--muted); font-size: 0.8rem; margin: 0.2rem 0 0; }
+.empty[hidden] { display: none; }
+.error { color: var(--danger); font-size: 0.82rem; margin: 0.5rem 0 0; }
+
+footer {
+  width: min(1120px, 94vw);
+  margin: 0 auto;
+  padding: 1rem 0 2.5rem;
+  border-top: 1px solid var(--line);
+  color: var(--muted);
+  font-size: 0.8rem;
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: 0.75rem;
+}
+footer p { margin: 0; }
+code { color: var(--accent); }
+.link { background: none; border: none; color: var(--muted); text-decoration: underline; cursor: pointer; font-size: 0.8rem; padding: 0.25rem; min-height: 32px; }
+
+@media (max-width: 760px) {
+  #task-form { grid-template-columns: minmax(0, 1fr); }
+  .board { grid-template-columns: minmax(0, 1fr); }
+  .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
