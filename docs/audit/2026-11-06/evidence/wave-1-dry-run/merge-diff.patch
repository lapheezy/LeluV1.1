+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <meta name="theme-color" content="#080d18" />
+    <title>Pulse Board</title>
+    <link rel="stylesheet" href="styles.css" />
+  </head>
+  <body>
+    <header class="topbar">
+      <div class="brand">
+        <span class="dot" aria-hidden="true"></span>
+        <div>
+          <h1>Pulse Board</h1>
+          <p class="sub">Tasks kept by a real HTTP backend</p>
+        </div>
+      </div>
+      <p class="connection" id="connection" role="status" aria-live="polite">Connecting…</p>
+    </header>
+
+    <main>
+      <section class="composer" aria-labelledby="composer-title">
+        <h2 id="composer-title">Add a task</h2>
+        <form id="task-form">
+          <label class="sr-only" for="task-title">Task title</label>
+          <input id="task-title" name="title" placeholder="What has to move?" maxlength="120" required />
+          <label class="sr-only" for="task-lane">Lane</label>
+          <select id="task-lane" name="lane">
+            <option value="todo">To do</option>
+            <option value="doing">Doing</option>
+            <option value="done">Done</option>
+          </select>
+          <button type="submit">Add</button>
+        </form>
+        <p class="error" id="composer-error" role="alert" hidden></p>
+      </section>
+
+      <section class="stats" aria-label="Totals">
+        <div><span id="stat-total">0</span><small>total</small></div>
+        <div><span id="stat-doing">0</span><small>doing</small></div>
+        <div><span id="stat-done">0</span><small>done</small></div>
+        <div><span id="stat-percent">0%</span><small>complete</small></div>
+      </section>
+
+      <section class="board" aria-label="Task board">
+        <article class="lane" data-lane="todo">
+          <header><h2>To do</h2><span class="count" data-count="todo">0</span></header>
+          <ul class="tasks" data-list="todo"></ul>
+          <p class="empty" data-empty="todo">Nothing waiting.</p>
+        </article>
+        <article class="lane" data-lane="doing">
+          <header><h2>Doing</h2><span class="count" data-count="doing">0</span></header>
+          <ul class="tasks" data-list="doing"></ul>
+          <p class="empty" data-empty="doing">Nothing in flight.</p>
+        </article>
+        <article class="lane" data-lane="done">
+          <header><h2>Done</h2><span class="count" data-count="done">0</span></header>
+          <ul class="tasks" data-list="done"></ul>
+          <p class="empty" data-empty="done">Finished work lands here.</p>
+        </article>
+      </section>
+      <p class="error" id="board-error" role="alert" hidden></p>
+    </main>
+
+    <footer>
+      <p>Every change is a request to <code>/api/tasks</code>, stored on disk by the Node backend.</p>
+      <button id="reset-demo" type="button" class="link">Remove all tasks</button>
+    </footer>
+
+    <script type="module" src="src/app.js"></script>
+  </body>
+</html>
diff --git a/studio/templates/application/scripts/build.mjs b/studio/templates/application/scripts/build.mjs
new file mode 100644
index 0000000..d6213d9
--- /dev/null
+++ b/studio/templates/application/scripts/build.mjs
@@ -0,0 +1,84 @@
+/**
+ * Pulse Board build. The frontend is static; the backend is imported and
+ * checked as a module before anything ships, so a syntax error in the API
+ * fails the build rather than the first user request.
+ */
+
+import { createHash } from "node:crypto";
+import {
+  existsSync,
+  mkdirSync,
+  readFileSync,
+  readdirSync,
+  rmSync,
+  statSync,
+  writeFileSync,
+} from "node:fs";
+import path from "node:path";
+
+const root = process.cwd();
+const dist = path.join(root, "dist");
+const failures = [];
+
+const SHIP = ["index.html", "styles.css", "src/app.js", "README.md"];
+const SERVER = "server.mjs";
+
+for (const file of [...SHIP, SERVER, "tests/api.test.mjs"]) {
+  if (!existsSync(path.join(root, file))) failures.push(`missing source file: ${file}`);
+}
+
+let backend = null;
+try {
+  backend = await import(new URL(`../${SERVER}`, import.meta.url));
+} catch (error) {
+  failures.push(`the backend module does not load: ${error.message}`);
+}
+if (!backend || typeof backend.createApiServer !== "function") {
+  failures.push("server.mjs does not export createApiServer()");
+}
+if (!backend || typeof backend.statsFor !== "function") {
+  failures.push("server.mjs does not export statsFor()");
+}
+
+const serverSource = existsSync(path.join(root, SERVER)) ? readFileSync(path.join(root, SERVER), "utf8") : "";
+for (const route of ["/api/tasks", "/api/stats", "/api/health"]) {
+  if (!serverSource.includes(route)) failures.push(`the backend does not serve ${route}`);
+}
+
+const html = existsSync(path.join(root, "index.html")) ? readFileSync(path.join(root, "index.html"), "utf8") : "";
+for (const required of ["id=\"task-form\"", "data-lane=\"todo\"", "data-lane=\"doing\"", "data-lane=\"done\"", "src/app.js"]) {
+  if (!html.includes(required)) failures.push(`index.html is missing ${required}`);
+}
+
+if (failures.length > 0) {
+  console.error(failures.join("\n"));
+  process.exit(1);
+}
+
+rmSync(dist, { recursive: true, force: true });
+mkdirSync(dist, { recursive: true });
+
+const manifest = { name: "pulse-board", builtAt: new Date().toISOString(), files: [], bytes: 0 };
+for (const file of SHIP) {
+  const content = readFileSync(path.join(root, file));
+  const target = path.join(dist, file);
+  mkdirSync(path.dirname(target), { recursive: true });
+  writeFileSync(target, content);
+  manifest.files.push({
+    path: file,
+    bytes: content.byteLength,
+    sha256: createHash("sha256").update(content).digest("hex").slice(0, 16),
+  });
+  manifest.bytes += content.byteLength;
+}
+writeFileSync(path.join(dist, "build.json"), `${JSON.stringify(manifest, null, 2)}\n`);
+
+const walk = (dir) => readdirSync(dir).flatMap((name) => {
+  const full = path.join(dir, name);
+  return statSync(full).isDirectory() ? walk(full) : [full];
+});
+
+console.log(
+  `built pulse-board: ${walk(dist).length} files, ${(manifest.bytes / 1024).toFixed(1)} KB, ` +
+    `backend imports and serves ${["/api/tasks", "/api/stats", "/api/health"].length} checked routes`,
+);
diff --git a/studio/templates/application/server.mjs b/studio/templates/application/server.mjs
new file mode 100644
index 0000000..40b1d83
--- /dev/null
+++ b/studio/templates/application/server.mjs
@@ -0,0 +1,237 @@
+/**
+ * Pulse Board backend — a real HTTP API with disk persistence.
+ *
+ * Node built-ins only. `createApiServer()` is exported so the test suite
+ * can start it on an ephemeral port; running the file starts it for the
+ * user (and for the studio's preview proxy).
+ */
+
+import { createServer } from "node:http";
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const LANES = ["todo", "doing", "done"];
+const MAX_TITLE = 120;
+const MAX_BODY = 16 * 1024;
+
+function json(res, status, body) {
+  res.writeHead(status, {
+    "content-type": "application/json; charset=utf-8",
+    "cache-control": "no-store",
+  });
+  res.end(JSON.stringify(body));
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on("data", (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY) {
+        reject(new Error("Body too large."));
+        req.destroy();
+      } else chunks.push(chunk);
+    });
+    req.on("end", () => {
+      try {
+        resolve(chunks.length ? JSON.parse(Buffer.concat(chunks).toString("utf8")) : {});
+      } catch {
+        reject(new Error("Body must be JSON."));
+      }
+    });
+    req.on("error", reject);
+  });
+}
+
+function normalizeTitle(raw) {
+  return String(raw ?? "").trim().replace(/\s+/g, " ");
+}
+
+export function validateTask(input, { partial = false } = {}) {
+  const errors = [];
+  if (!partial || input.title !== undefined) {
+    const title = normalizeTitle(input.title);
+    if (title.length < 3) errors.push("A task title needs at least 3 characters.");
+    if (title.length > MAX_TITLE) errors.push(`A task title is at most ${MAX_TITLE} characters.`);
+  }
+  if (input.lane !== undefined && !LANES.includes(input.lane)) {
+    errors.push(`Lane must be one of ${LANES.join(", ")}.`);
+  }
+  return errors;
+}
+
+export function statsFor(tasks) {
+  const byLane = { todo: 0, doing: 0, done: 0 };
+  for (const task of tasks) byLane[task.lane] += 1;
+  const total = tasks.length;
+  return {
+    total,
+    byLane,
+    donePercent: total === 0 ? 0 : Math.round((byLane.done / total) * 100),
+  };
+}
+
+export function createApiServer(options = {}) {
+  const dataFile = options.dataFile ?? path.join(HERE, "data", "tasks.json");
+  const root = options.root ?? HERE;
+
+  const load = () => {
+    try {
+      const parsed = JSON.parse(readFileSync(dataFile, "utf8"));
+      return Array.isArray(parsed.tasks) ? parsed.tasks : [];
+    } catch {
+      return [];
+    }
+  };
+  let tasks = load();
+  let counter = tasks.reduce((max, task) => Math.max(max, Number(task.id) || 0), 0);
+
+  const save = () => {
+    mkdirSync(path.dirname(dataFile), { recursive: true });
+    writeFileSync(dataFile, `${JSON.stringify({ tasks }, null, 2)}\n`, "utf8");
+  };
+
+  const serveStatic = (req, res, urlPath) => {
+    const relative = urlPath === "/" ? "index.html" : decodeURIComponent(urlPath).replace(/^\/+/, "");
+    const full = path.resolve(root, relative);
+    if (!full.startsWith(path.resolve(root) + path.sep) && full !== path.resolve(root)) {
+      res.writeHead(403).end("Forbidden");
+      return;
+    }
+    if (!existsSync(full)) {
+      res.writeHead(404, { "content-type": "text/plain" }).end(`Not found: ${relative}`);
+      return;
+    }
+    const ext = path.extname(full);
+    const type =
+      ext === ".html" ? "text/html; charset=utf-8"
+        : ext === ".css" ? "text/css; charset=utf-8"
+          : ext === ".js" ? "text/javascript; charset=utf-8"
+            : ext === ".png" ? "image/png"
+              : "application/octet-stream";
+    res.writeHead(200, { "content-type": type, "cache-control": "no-store" });
+    res.end(readFileSync(full));
+  };
+
+  const server = createServer(async (req, res) => {
+    const url = new URL(req.url ?? "/", "http://127.0.0.1");
+    const method = (req.method ?? "GET").toUpperCase();
+    const route = url.pathname;
+
+    try {
+      if (route === "/api/health" && method === "GET") {
+        json(res, 200, { ok: true, service: "pulse-board", tasks: tasks.length });
+        return;
+      }
+
+      if (route === "/api/tasks" && method === "GET") {
+        const lane = url.searchParams.get("lane");
+        const visible = lane ? tasks.filter((task) => task.lane === lane) : tasks;
+        json(res, 200, { tasks: visible });
+        return;
+      }
+
+      if (route === "/api/tasks" && method === "POST") {
+        const body = await readBody(req);
+        const errors = validateTask(body);
+        if (errors.length > 0) {
+          json(res, 400, { ok: false, errors });
+          return;
+        }
+        counter += 1;
+        const task = {
+          id: counter,
+          title: normalizeTitle(body.title),
+          lane: LANES.includes(body.lane) ? body.lane : "todo",
+          createdAt: new Date().toISOString(),
+          updatedAt: new Date().toISOString(),
+        };
+        tasks = [...tasks, task];
+        save();
+        json(res, 201, { ok: true, task });
+        return;
+      }
+
+      const match = /^\/api\/tasks\/(\d+)$/.exec(route);
+      if (match && method === "PATCH") {
+        const body = await readBody(req);
+        const errors = validateTask(body, { partial: true });
+        if (errors.length > 0) {
+          json(res, 400, { ok: false, errors });
+          return;
+        }
+        const id = Number(match[1]);
+        const current = tasks.find((task) => task.id === id);
+        if (!current) {
+          json(res, 404, { ok: false, errors: ["No task with that id."] });
+          return;
+        }
+        const next = {
+          ...current,
+          ...(body.title !== undefined ? { title: normalizeTitle(body.title) } : {}),
+          ...(body.lane !== undefined ? { lane: body.lane } : {}),
+          updatedAt: new Date().toISOString(),
+        };
+        tasks = tasks.map((task) => (task.id === id ? next : task));
+        save();
+        json(res, 200, { ok: true, task: next });
+        return;
+      }
+
+      if (match && method === "DELETE") {
+        const id = Number(match[1]);
+        if (!tasks.some((task) => task.id === id)) {
+          json(res, 404, { ok: false, errors: ["No task with that id."] });
+          return;
+        }
+        tasks = tasks.filter((task) => task.id !== id);
+        save();
+        json(res, 200, { ok: true, deleted: id });
+        return;
+      }
+
+      if (route === "/api/tasks" && method === "DELETE") {
+        const removed = tasks.length;
+        tasks = [];
+        save();
+        json(res, 200, { ok: true, removed });
+        return;
+      }
+
+      if (route === "/api/stats" && method === "GET") {
+        json(res, 200, { ok: true, ...statsFor(tasks) });
+        return;
+      }
+
+      if (route.startsWith("/api/")) {
+        json(res, 404, { ok: false, errors: [`No API route ${method} ${route}`] });
+        return;
+      }
+
+      if (method === "GET" || method === "HEAD") {
+        serveStatic(req, res, route);
+        return;
+      }
+
+      json(res, 405, { ok: false, errors: [`${method} is not allowed here.`] });
+    } catch (error) {
+      json(res, 400, { ok: false, errors: [error instanceof Error ? error.message : String(error)] });
+    }
+  });
+
+  return server;
+}
+
+const isDirect = process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);
+if (isDirect) {
+  const port = Number(process.env.PORT ?? 5300);
+  const server = createApiServer({
+    dataFile: process.env.PULSE_DATA ?? path.join(HERE, "data", "tasks.json"),
+  });
+  server.listen(port, "127.0.0.1", () => {
+    console.log(`pulse-board backend listening on http://127.0.0.1:${port}`);
+  });
+}
diff --git a/studio/templates/application/src/app.js b/studio/templates/application/src/app.js
new file mode 100644
index 0000000..1485418
--- /dev/null
+++ b/studio/templates/application/src/app.js
@@ -0,0 +1,172 @@
+/**
+ * Pulse Board frontend. Every number on screen comes from the backend:
+ * no optimistic local counters, so a failed request is visible instead of
+ * being hidden by a UI that already moved.
+ */
+
+// Relative on purpose: the same frontend is served directly by its backend
+// and through /api/studio/serve/<slug>/, where a root-absolute /api would
+// escape the proxy and reach the host application instead.
+const API = "api";
+const LANES = ["todo", "doing", "done"];
+const NEXT_LANE = { todo: "doing", doing: "done", done: "todo" };
+
+const connection = document.getElementById("connection");
+const form = document.getElementById("task-form");
+const titleInput = document.getElementById("task-title");
+const laneInput = document.getElementById("task-lane");
+const composerError = document.getElementById("composer-error");
+const boardError = document.getElementById("board-error");
+const resetButton = document.getElementById("reset-demo");
+
+let state = { tasks: [], stats: { total: 0, byLane: { todo: 0, doing: 0, done: 0 }, donePercent: 0 } };
+
+function setError(element, message) {
+  if (!element) return;
+  element.textContent = message || "";
+  element.hidden = !message;
+}
+
+function setConnection(mode, text) {
+  if (!connection) return;
+  connection.textContent = text;
+  connection.classList.toggle("is-live", mode === "live");
+  connection.classList.toggle("is-down", mode === "down");
+}
+
+async function api(path, options = {}) {
+  const response = await fetch(`${API}${path}`, {
+    headers: { "content-type": "application/json" },
+    ...options,
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok || data.ok === false) {
+    throw new Error(Array.isArray(data.errors) ? data.errors.join(" ") : `HTTP ${response.status}`);
+  }
+  return data;
+}
+
+function countTasks(tasks) {
+  const byLane = { todo: 0, doing: 0, done: 0 };
+  for (const task of tasks) byLane[task.lane] += 1;
+  const donePercent = tasks.length === 0 ? 0 : Math.round((byLane.done / tasks.length) * 100);
+  return { total: tasks.length, byLane, donePercent };
+}
+
+function taskElement(task) {
+  const item = document.createElement("li");
+  item.className = "task";
+  item.dataset.taskId = String(task.id);
+
+  const title = document.createElement("p");
+  title.className = "task-title";
+  title.textContent = task.title;
+
+  const meta = document.createElement("div");
+  meta.className = "task-meta";
+
+  const move = document.createElement("button");
+  move.type = "button";
+  move.dataset.action = "move";
+  move.textContent = task.lane === "done" ? "Reopen" : `Move to ${NEXT_LANE[task.lane]}`;
+  meta.append(move);
+
+  const remove = document.createElement("button");
+  remove.type = "button";
+  remove.dataset.action = "delete";
+  remove.className = "danger";
+  remove.textContent = "Delete";
+  meta.append(remove);
+
+  item.append(title, meta);
+  return item;
+}
+
+function render() {
+  for (const lane of LANES) {
+    const list = document.querySelector(`[data-list="${lane}"]`);
+    const empty = document.querySelector(`[data-empty="${lane}"]`);
+    const count = document.querySelector(`[data-count="${lane}"]`);
+    if (!list) continue;
+    list.replaceChildren(...state.tasks.filter((task) => task.lane === lane).map(taskElement));
+    if (empty) empty.hidden = state.tasks.some((task) => task.lane === lane);
+    if (count) count.textContent = String(state.stats.byLane[lane] ?? 0);
+  }
+  const setText = (id, value) => {
+    const element = document.getElementById(id);
+    if (element) element.textContent = String(value);
+  };
+  setText("stat-total", state.stats.total);
+  setText("stat-doing", state.stats.byLane.doing);
+  setText("stat-done", state.stats.byLane.done);
+  setText("stat-percent", `${state.stats.donePercent}%`);
+}
+
+function recalculate() {
+  state.stats = countTasks(state.tasks);
+  render();
+}
+
+async function refresh() {
+  try {
+    const data = await api("/tasks");
+    state.tasks = data.tasks ?? [];
+    recalculate();
+    setConnection("live", `Live · ${state.tasks.length} stored`);
+    setError(boardError, "");
+  } catch (error) {
+    setConnection("down", "Backend unreachable");
+    setError(
+      boardError,
+      `The backend could not be reached (${error.message}). Nothing shown here is cached.`,
+    );
+  }
+}
+
+form?.addEventListener("submit", async (event) => {
+  event.preventDefault();
+  setError(composerError, "");
+  try {
+    await api("/tasks", {
+      method: "POST",
+      body: JSON.stringify({ title: titleInput?.value ?? "", lane: laneInput?.value ?? "todo" }),
+    });
+    if (titleInput) titleInput.value = "";
+    await refresh();
+    titleInput?.focus();
+  } catch (error) {
+    setError(composerError, error.message);
+  }
+});
+
+document.querySelector(".board")?.addEventListener("click", async (event) => {
+  const button = event.target instanceof Element ? event.target.closest("button[data-action]") : null;
+  if (!button) return;
+  const item = button.closest("[data-task-id]");
+  const task = state.tasks.find((candidate) => String(candidate.id) === item?.getAttribute("data-task-id"));
+  if (!task) return;
+  try {
+    if (button.dataset.action === "delete") {
+      await api(`/tasks/${task.id}`, { method: "DELETE" });
+    } else {
+      await api(`/tasks/${task.id}`, {
+        method: "PATCH",
+        body: JSON.stringify({ lane: NEXT_LANE[task.lane] }),
+      });
+    }
+    await refresh();
+  } catch (error) {
+    setError(boardError, error.message);
+  }
+});
+
+resetButton?.addEventListener("click", async () => {
+  try {
+    await api("/tasks", { method: "DELETE" });
+    await refresh();
+  } catch (error) {
+    setError(boardError, error.message);
+  }
+});
+
+refresh();
