diff --git a/deploy/Caddyfile b/deploy/Caddyfile
new file mode 100644
index 0000000..941b527
--- /dev/null
+++ b/deploy/Caddyfile
@@ -0,0 +1,75 @@
+# ==========================================================
+# LÉLU — CADDY (automatic HTTPS + reverse proxy)
+#
+# Caddy fetches and renews the certificate itself; there is no certbot
+# cron job to forget.
+#
+# What this file is careful about:
+#   • It does NOT set a blanket long cache lifetime. Doing so would
+#     reintroduce the bug server.ts just fixed: a phone would never
+#     revalidate sw.js or the avatar art. The app's own Cache-Control
+#     is authoritative and is passed through untouched.
+#   • Ranges and validators are forwarded, so a 49 MB model resumes and
+#     a repeat visit can return 304.
+#   • /api/engineer/* and /api/browser/capture are refused at the edge.
+#     The runtime already answers 503 when no token is configured (fail
+#     closed); this is the second, independent boundary the deployment
+#     brief asks for. Remove these two blocks only if you deliberately
+#     enable self-development on the server AND set LELU_ENGINEER_TOKEN.
+#   • Brotli: Caddy's built-in encoder supports gzip and zstd. Brotli
+#     needs a plugin (caddy-encode-brotli), so this config uses zstd +
+#     gzip, which every modern mobile browser accepts.
+# ==========================================================
+
+{
+	email {$ACME_EMAIL}
+	# Uncomment while testing with a staging certificate:
+	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
+}
+
+{$LELU_HOST} {
+	encode zstd gzip
+
+	# ---- second boundary: the engineering surface ----------------
+	# 404 (not 403) so the endpoints are not even confirmed to exist.
+	handle /api/engineer/* {
+		respond 404
+	}
+	handle /api/browser/capture {
+		respond 404
+	}
+
+	# ---- everything else ----------------------------------------
+	handle {
+		reverse_proxy lelu:4173 {
+			# Keep the upstream's own headers, including ETag,
+			# Last-Modified, Cache-Control, Content-Range and
+			# Accept-Ranges. Caddy forwards these by default; the
+			# point is that nothing below strips them.
+			header_up X-Forwarded-Proto {scheme}
+
+			# Server-sent events and long polls must not be buffered.
+			flush_interval -1
+
+			# A 49 MB model download is not a failure.
+			transport http {
+				read_timeout 300s
+				write_timeout 300s
+			}
+		}
+	}
+
+	log {
+		output file /data/access.log {
+			roll_size 20mb
+			roll_keep 5
+		}
+		format console
+	}
+
+	# Do not let the proxy answer for a wedged app: Caddy returns 502,
+	# which is an honest failure rather than a cached success.
+	handle_errors {
+		respond "{err.status_code} {err.status_text}" {err.status_code}
+	}
+}
diff --git a/deploy/Dockerfile b/deploy/Dockerfile
new file mode 100644
index 0000000..2957d40
--- /dev/null
+++ b/deploy/Dockerfile
@@ -0,0 +1,68 @@
+# ==========================================================
+# LÉLU — PRODUCTION IMAGE
+#
+# Two stages, on purpose:
+#
+#   build    installs dependencies and runs the real production
+#            build (`tsc -b && vite build`). `VITE_*` values are
+#            inlined into the bundle here, so the client-visible ones
+#            must be present in `.env` BEFORE this stage runs.
+#
+#   runtime  copies the built app and runs `bun server.ts` — the same
+#            entry point `bun run serve` uses. Server-only secrets are
+#            NOT baked in: `.env`/`.env.local` are deleted from the
+#            runtime layer and supplied at run time (compose
+#            `env_file`, or systemd `EnvironmentFile`).
+#
+# Build:
+#   docker build -f deploy/Dockerfile -t lelu:1.1 .
+# Run:
+#   docker compose -f deploy/docker-compose.yml up -d
+# ==========================================================
+
+FROM oven/bun:1.4-debian AS build
+WORKDIR /app
+
+# Dependencies first, so a source change does not re-resolve them.
+COPY package.json bun.lock* ./
+RUN bun install --frozen-lockfile
+
+COPY . .
+# The build reads .env for the VITE_ (client-visible) values it inlines.
+RUN bun run build
+
+# ---- runtime -----------------------------------------------------------
+FROM oven/bun:1.4-debian AS runtime
+
+# curl is used only by the container healthcheck below.
+RUN apt-get update \
+ && apt-get install -y --no-install-recommends curl ca-certificates \
+ && rm -rf /var/lib/apt/lists/*
+
+WORKDIR /app
+
+# The whole app, because `server.ts` mounts real plugins that import real
+# application code — this is a runtime, not a static bundle server.
+COPY --from=build /app /app
+
+# NEVER ship secrets in the image. Anything needed server-side arrives at
+# run time; anything needed at build time is already inlined in dist/.
+RUN rm -f /app/.env /app/.env.local /app/.env.production /app/.env.development
+
+# Runtime state that must survive a restart (see docs/CONTABO_DEPLOYMENT.md).
+RUN mkdir -p /app/data && chown -R bun:bun /app/data
+
+ENV NODE_ENV=production \
+    PORT=4173
+
+USER bun
+EXPOSE 4173
+
+# A real readiness probe: `dist/` missing or the router wedged both fail here.
+HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
+  CMD curl -fsS "http://127.0.0.1:${PORT}/api/env-check" > /dev/null || exit 1
+
+# Signals reach node directly (no shell), so SIGTERM stops the listener
+# instead of leaving a shell alive and the server orphaned.
+STOPSIGNAL SIGTERM
+CMD ["bun", "server.ts"]
diff --git a/deploy/docker-compose.yml b/deploy/docker-compose.yml
new file mode 100644
index 0000000..8df933e
--- /dev/null
+++ b/deploy/docker-compose.yml
@@ -0,0 +1,84 @@
+# ==========================================================
+# LÉLU — CONTABO DEPLOYMENT (app + automatic HTTPS)
+#
+#   docker compose -f deploy/docker-compose.yml up -d
+#
+# Two services and one network:
+#
+#   lelu    the Bun runtime (server.ts) — NOT published to the host.
+#           Only Caddy can reach it.
+#   caddy   terminates TLS with an automatic Let's Encrypt certificate,
+#           compresses text, and forwards ranges and validators intact.
+#
+# Secrets live in `.env` (chmod 600, never committed) and are injected
+# with `env_file`, so they are not in the image, not in this file and
+# not in `docker compose config`.
+# ==========================================================
+
+services:
+  lelu:
+    build:
+      context: ..
+      dockerfile: deploy/Dockerfile
+    image: lelu:1.1
+    restart: unless-stopped
+    env_file:
+      - ../.env
+    environment:
+      # Listen on all interfaces INSIDE the container so Caddy can reach
+      # it. Nothing is published to the host — see the `ports` note below.
+      PORT: "4173"
+      # The engineering API is intentionally left disabled here: it reads
+      # source and runs commands, so it stays closed unless someone
+      # deliberately sets LELU_ENGINEER_TOKEN in .env.
+    volumes:
+      # Runtime state that must outlive a container: forge ledger,
+      # generated artifacts and anything written to data/.
+      - lelu-data:/app/data
+    # Deliberately no `ports:` — the app is reachable only through Caddy.
+    # Publishing 4173 would expose it over plain HTTP and bypass the
+    # proxy-level block on /api/engineer/*.
+    expose:
+      - "4173"
+    healthcheck:
+      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:4173/api/env-check"]
+      interval: 30s
+      timeout: 5s
+      retries: 3
+      start_period: 20s
+    logging:
+      driver: json-file
+      options:
+        max-size: "20m"
+        max-file: "5"
+
+  caddy:
+    image: caddy:2-alpine
+    restart: unless-stopped
+    depends_on:
+      lelu:
+        condition: service_healthy
+    ports:
+      - "80:80"
+      - "443:443"
+      - "443:443/udp"
+    environment:
+      # Set to the real hostname; Caddy fetches the certificate for it.
+      # Must be an apex or subdomain root — the webmanifest uses absolute
+      # `/` paths, so a subpath deploy would install a broken PWA.
+      LELU_HOST: ${LELU_HOST:?set LELU_HOST in .env, e.g. lelu.example.com}
+      ACME_EMAIL: ${ACME_EMAIL:?set ACME_EMAIL in .env for expiry notices}
+    volumes:
+      - ./Caddyfile:/etc/caddy/Caddyfile:ro
+      - caddy-data:/data
+      - caddy-config:/config
+    logging:
+      driver: json-file
+      options:
+        max-size: "20m"
+        max-file: "5"
+
+volumes:
+  lelu-data:
+  caddy-data:
+  caddy-config:
