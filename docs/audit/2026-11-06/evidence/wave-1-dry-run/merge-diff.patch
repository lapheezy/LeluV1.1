+}
+
+:root[data-theme="day"] {
+  color-scheme: light;
+  --bg: #f5f7fb;
+  --surface: rgba(255, 255, 255, 0.86);
+  --line: rgba(15, 23, 42, 0.12);
+  --text: #0b1220;
+  --muted: #4a5a75;
+  --accent: #0e7490;
+  --accent-strong: #0891b2;
+  --danger: #b91c1c;
+}
+
+* { box-sizing: border-box; }
+
+html { scroll-behavior: smooth; }
+
+body {
+  margin: 0;
+  min-height: 100vh;
+  background:
+    radial-gradient(60rem 40rem at 15% -10%, rgba(34, 211, 238, 0.18), transparent 60%),
+    radial-gradient(50rem 36rem at 100% 10%, rgba(139, 92, 246, 0.16), transparent 55%),
