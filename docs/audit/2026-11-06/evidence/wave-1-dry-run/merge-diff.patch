diff --git a/src/core/cosmos/CosmosAutonomy.ts b/src/core/cosmos/CosmosAutonomy.ts
new file mode 100644
index 0000000..ce077b0
--- /dev/null
+++ b/src/core/cosmos/CosmosAutonomy.ts
@@ -0,0 +1,276 @@
+/**
+ * ==========================================================
+ * LÉLU — COSMOS AUTONOMY BOUNDARIES
+ *
+ * Three colours, one meaning each:
+ *
+ *   GREEN   she may do it on her own. It changes her own
+ *           workspace: navigating, opening a view, arranging
+ *           windows, placing an object, restoring what was
+ *           there before.
+ *
+ *   YELLOW  it creates or removes something that outlives the
+ *           action — a room, a task, a published extension.
+ *           Allowed, but only after a human approval, unless
+ *           the human is the one who asked.
+ *
+ *   RED     protected ground: cognition, authentication,
+ *           database security, secrets, production config,
+ *           protected core infrastructure. Never autonomous;
+ *           always a human approval, and the approval only
+ *           covers the exact action that was shown.
+ *
+ * The classification is a pure function so it can be tested and
+ * so every caller (the workspace API, the panel, a future tool)
+ * gets the same answer. Approval itself goes through the
+ * existing ApprovalGate — this file does not invent a second
+ * approval mechanism, it names which actions need the one that
+ * already exists.
+ *
+ * ExtensionJournal is the reversible-expansion half: an
+ * experiment is opened with a checkpoint of the state it is
+ * about to change, must be VERIFIED before it can be published,
+ * and can be rolled back to the checkpoint while it is still a
+ * draft. A published extension keeps its record so the activity
+ * is visible; a rolled-back one restores the snapshot.
+ * ==========================================================
+ */
+
+import KvStore from "../storage/KvStore";
+
+export type Boundary = "green" | "yellow" | "red";
+
+export type CosmosAction =
+  | "navigate"
+  | "open-workspace"
+  | "arrange-windows"
+  | "restore-workspace"
+  | "place-object"
+  | "read-file"
+  | "open-browser"
+  | "switch-project"
+  | "create-room"
+  | "remove-room"
+  | "run-task"
+  | "pause-task"
+  | "resume-task"
+  | "cancel-task"
+  | "publish-extension"
+  | "change-autonomy"
+  | "access-secrets"
+  | "alter-database"
+  | "modify-auth"
+  | "deploy";
+
+export type Actor = "user" | "lelu" | "agent";
+
+export interface BoundaryDecision {
+  boundary: Boundary;
+  /** May it run at all? */
+  allowed: boolean;
+  /** Does it need an approval before it runs? */
+  requiresApproval: boolean;
+  reason: string;
+}
+
+const REASONS: Record<CosmosAction, { boundary: Boundary; reason: string }> = {
+  navigate: { boundary: "green", reason: "moving through her own environment" },
+  "open-workspace": { boundary: "green", reason: "opening a workspace view" },
+  "arrange-windows": { boundary: "green", reason: "arranging windows she already has open" },
+  "restore-workspace": { boundary: "green", reason: "returning to a saved workspace" },
+  "place-object": { boundary: "green", reason: "placing a link to an existing record" },
+  "read-file": { boundary: "green", reason: "reading a file into a view" },
+  "open-browser": { boundary: "green", reason: "opening a page to read it" },
+  "switch-project": { boundary: "green", reason: "changing which project the workspace shows" },
+  "create-room": { boundary: "yellow", reason: "adding a place that outlives this action" },
+  "remove-room": { boundary: "yellow", reason: "removing a place from the environment" },
+  "run-task": { boundary: "yellow", reason: "starting work that continues in the background" },
+  "pause-task": { boundary: "yellow", reason: "changing a running task" },
+  "resume-task": { boundary: "yellow", reason: "restarting work that was stopped" },
+  "cancel-task": { boundary: "yellow", reason: "ending work that is in flight" },
+  "publish-extension": { boundary: "yellow", reason: "publishing a verified UI extension" },
+  "change-autonomy": { boundary: "red", reason: "changing the boundaries themselves" },
+  "access-secrets": { boundary: "red", reason: "secrets and credentials" },
+  "alter-database": { boundary: "red", reason: "database security and schema" },
+  "modify-auth": { boundary: "red", reason: "authentication and identity" },
+  deploy: { boundary: "red", reason: "production configuration and deployment" },
+};
+
+/**
+ * Classify an action for an actor.
+ *
+ * A human clicking a yellow action has already consented — the click is
+ * the decision. A yellow action LÉLU starts herself has only her own
+ * judgement behind it, so it waits for a person. Red never runs on
+ * autonomy at all, and still needs approval when a person asks, because
+ * "I clicked it" is not the same as "I read what it would change".
+ */
+export function classifyCosmosAction(action: CosmosAction, actor: Actor = "lelu"): BoundaryDecision {
+  const rule = REASONS[action];
+  if (!rule) {
+    return { boundary: "red", allowed: false, requiresApproval: true, reason: `unknown action "${action}"` };
+  }
+  const requiresApproval = rule.boundary === "red" || (rule.boundary === "yellow" && actor !== "user");
+  return {
+    boundary: rule.boundary,
+    allowed: !(rule.boundary === "red" && actor !== "user"),
+    requiresApproval,
+    reason: rule.reason,
+  };
+}
+
+/** Paths/areas that are protected regardless of what action touches them. */
+const PROTECTED_PATTERNS: Array<{ pattern: RegExp; reason: string }> = [
+  { pattern: /(^|\/)\.env(\.|$)/i, reason: "secrets live in env files" },
+  { pattern: /secret|credential|api[-_]?key/i, reason: "secrets and credentials" },
+  { pattern: /(^|\/)(auth|authn|authz)(\/|\.|$)/i, reason: "authentication" },
+  { pattern: /supabase\/(migrations|functions)/i, reason: "database security" },
+  { pattern: /(^|\/)(Bootstrap|MemoryBridge|PromptInjectionGuard|PersonalityGuard)\.ts$/i, reason: "protected core infrastructure" },
+  { pattern: /wrangler\.(toml|jsonc?)$/i, reason: "production configuration" },
+];
+
+/** Does this target sit on protected ground? */
+export function isProtectedTarget(target: string): { protected: boolean; reason: string } {
+  for (const rule of PROTECTED_PATTERNS) {
+    if (rule.pattern.test(target)) return { protected: true, reason: rule.reason };
+  }
+  return { protected: false, reason: "" };
+}
+
+/* ------------------------------------------------------------------
+ * REVERSIBLE EXTENSION EXPANSION
+ * ------------------------------------------------------------------ */
+
+export type ExtensionStatus = "draft" | "verified" | "published" | "rolled-back";
+
+export interface ExtensionRecord {
+  id: string;
+  label: string;
+  /** What it intends to change, in words the activity log can show. */
+  applies: string[];
+  createdAt: number;
+  status: ExtensionStatus;
+  verifiedAt?: number;
+  publishedAt?: number;
+  rolledBackAt?: number;
+}
+
+export interface ExtensionDraft extends ExtensionRecord {
+  snapshot: unknown;
+}
+
+const EXTENSION_KEY = "lelu.cosmos.extensions.v1";
+const MAX_EXTENSIONS = 100;
+
+export class ExtensionJournal {
+  private drafts = new Map<string, ExtensionDraft>();
+  private published: ExtensionRecord[] = [];
+
+  constructor(private readonly persistState: (records: ExtensionRecord[]) => void = defaultPersist) {
+    this.published = loadPublished();
+  }
+
+  list(): ExtensionRecord[] {
+    return [...[...this.drafts.values()].map(strip), ...this.published];
+  }
+
+  get(id: string): ExtensionDraft | undefined {
+    return this.drafts.get(id);
+  }
+
+  /** Open an experiment with the state it is about to change. */
+  begin(input: { label: string; applies: string[]; snapshot: unknown }): ExtensionDraft {
+    const draft: ExtensionDraft = {
+      id: `ext-${crypto.randomUUID().slice(0, 8)}`,
+      label: input.label,
+      applies: [...input.applies],
+      createdAt: Date.now(),
+      status: "draft",
+      snapshot: input.snapshot,
+    };
+    this.drafts.set(draft.id, draft);
+    return draft;
+  }
+
+  /**
+   * A draft must be verified by its own checks before it may be shown as
+   * done. The check is the caller's: the journal only enforces that one
+   * ran and passed.
+   */
+  verify(id: string, check: () => boolean): boolean {
+    const draft = this.drafts.get(id);
+    if (!draft || draft.status !== "draft") return false;
+    let passed = false;
+    try {
+      passed = check() === true;
+    } catch {
+      passed = false;
+    }
+    if (!passed) return false;
+    draft.status = "verified";
+    draft.verifiedAt = Date.now();
+    return true;
+  }
+
+  /** Publish only what was verified. */
+  publish(id: string): { ok: boolean; reason: string } {
+    const draft = this.drafts.get(id);
+    if (!draft) return { ok: false, reason: "no such extension" };
+    if (draft.status !== "verified") {
+      return { ok: false, reason: "the extension has not passed its checks, so it is not published" };
+    }
+    draft.status = "published";
+    draft.publishedAt = Date.now();
+    this.published = [...this.published, strip(draft)].slice(-MAX_EXTENSIONS);
+    this.drafts.delete(id);
+    this.persistState(this.published);
+    return { ok: true, reason: `published "${draft.label}"` };
+  }
+
+  /**
+   * Undo a draft by restoring the checkpoint it opened with. Returns the
+   * snapshot to restore so the caller owns the state it took.
+   */
+  rollback(id: string): { ok: true; snapshot: unknown } | { ok: false; reason: string } {
+    const draft = this.drafts.get(id);
+    if (!draft) return { ok: false, reason: "no such extension" };
+    if (draft.status === "published") {
+      return { ok: false, reason: "a published extension is undone from its own controls" };
+    }
+    draft.status = "rolled-back";
+    draft.rolledBackAt = Date.now();
+    this.drafts.delete(id);
+    return { ok: true, snapshot: draft.snapshot };
+  }
+}
+
+function strip(draft: ExtensionDraft): ExtensionRecord {
+  const record: ExtensionRecord = {
+    id: draft.id,
+    label: draft.label,
+    applies: [...draft.applies],
+    createdAt: draft.createdAt,
+    status: draft.status,
+  };
+  if (draft.verifiedAt) record.verifiedAt = draft.verifiedAt;
+  if (draft.publishedAt) record.publishedAt = draft.publishedAt;
+  if (draft.rolledBackAt) record.rolledBackAt = draft.rolledBackAt;
+  return record;
+}
+
+function defaultPersist(records: ExtensionRecord[]): void {
+  try {
+    KvStore.getInstance().set(EXTENSION_KEY, records);
+  } catch {
+    /* best-effort */
+  }
+}
+
+function loadPublished(): ExtensionRecord[] {
+  try {
+    const stored = KvStore.getInstance().get<ExtensionRecord[]>(EXTENSION_KEY);
+    return Array.isArray(stored) ? stored : [];
+  } catch {
+    return [];
+  }
+}
diff --git a/src/core/cosmos/CosmosFocus.ts b/src/core/cosmos/CosmosFocus.ts
new file mode 100644
index 0000000..080f8cb
--- /dev/null
+++ b/src/core/cosmos/CosmosFocus.ts
@@ -0,0 +1,71 @@
+/**
+ * ==========================================================
+ * LÉLU — COSMOS FOCUS
+ *
+ * What is selected in the cosmos right now: a destination
+ * (galaxy / planet / room) or a spatial object.
+ *
+ * The 3D scene and the workspace panel both read and write
+ * this, so tapping a ring in space opens the same inspection
+ * the list opens, and selecting a room in the panel highlights
+ * it in space. It holds a reference only — never a copy of the
+ * thing selected, so it cannot drift from the record.
+ * ==========================================================
+ */
+
+export type FocusKind = "node" | "object";
+
+export interface FocusTarget {
+  kind: FocusKind;
+  id: string;
+}
+
+type Listener = (target: FocusTarget | null) => void;
+
+export default class CosmosFocus {
+  private static instance: CosmosFocus | null = null;
+
+  private target: FocusTarget | null = null;
+  private listeners = new Set<Listener>();
+
+  static getInstance(): CosmosFocus {
+    if (!CosmosFocus.instance) CosmosFocus.instance = new CosmosFocus();
+    return CosmosFocus.instance;
+  }
+
+  static reset(): void {
+    CosmosFocus.instance = null;
+  }
+
+  get(): FocusTarget | null {
+    return this.target ? { ...this.target } : null;
+  }
+
+  /** Select a destination or an object. Selecting the same id is a no-op. */
+  set(target: FocusTarget | null): void {
+    if (target && this.target && target.kind === this.target.kind && target.id === this.target.id) return;
+    if (!target && !this.target) return;
+    this.target = target ? { ...target } : null;
+    this.notify();
+  }
+
+  clear(): void {
+    this.set(null);
+  }
+
+  subscribe(listener: Listener): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  private notify(): void {
+    const current = this.get();
+    for (const listener of this.listeners) {
+      try {
+        listener(current);
+      } catch (error) {
+        console.error("[CosmosFocus] listener failed:", error);
+      }
+    }
+  }
+}
diff --git a/src/core/cosmos/CosmosInspector.ts b/src/core/cosmos/CosmosInspector.ts
new file mode 100644
index 0000000..562bac6
--- /dev/null
+++ b/src/core/cosmos/CosmosInspector.ts
@@ -0,0 +1,284 @@
+/**
+ * ==========================================================
+ * LÉLU — COSMOS INSPECTOR
+ *
+ * A spatial object is a pointer. This is what a pointer is
+ * worth: given an object in a room, it loads the record it
+ * links to and reports what that record actually says right
+ * now — never what the object's card said when it was placed.
+ *
+ * If a record cannot be loaded, it says so. It never fills the
+ * gap with the object's stored title and calls that inspection.
+ * ==========================================================
+ */
+
+import ProjectStore from "../projects/ProjectStore";
+import MultiChatStore from "../multichat/MultiChatStore";
+import TaskEngine from "../tasks/TaskEngine";
+import WorkspaceAPI from "../workspace/WorkspaceAPI";
+import type { WorkspaceViewKind } from "../workspace/WorkspaceEngine";
+import SpatialObjects, { type SpatialKind, type SpatialObject } from "./SpatialObjects";
+
+export interface Inspection {
+  ok: boolean;
+  objectId: string;
+  title: string;
+  kind: SpatialKind;
+  /** The record this object points at. */
+  link: { kind: string; id: string };
+  roomId: string;
+  /** Real lines read from the record, or the truthful reason there are none. */
+  lines: string[];
+  /** A workspace view this record can be opened as, when it has one. */
+  openable: boolean;
+}
+
+function clip(text: string, max = 240): string {
+  const clean = text.replace(/\s+/g, " ").trim();
+  return clean.length > max ? `${clean.slice(0, max - 1)}…` : clean;
+}
+
+/** A URL standing in as a record id (media placed by address). */
+function asUrl(link: { kind: string; id: string }): string | null {
+  return /^https?:\/\//i.test(link.id) ? link.id : null;
+}
+
+const URL_VIEW_KINDS: Record<string, WorkspaceViewKind> = {
+  image: "image",
+  video: "video",
+  file: "browser",
+  research: "browser",
+  document: "browser",
+};
+
+export default class CosmosInspector {
+  private static instance: CosmosInspector | null = null;
+
+  static getInstance(): CosmosInspector {
+    if (!CosmosInspector.instance) CosmosInspector.instance = new CosmosInspector();
+    return CosmosInspector.instance;
+  }
+
+  /** Read the record behind an object, from its own store. */
+  inspect(objectId: string): Inspection {
+    const object = SpatialObjects.getInstance().get(objectId);
+    if (!object) {
+      return {
+        ok: false,
+        objectId,
+        title: objectId,
+        kind: "note",
+        link: { kind: "unknown", id: objectId },
+        roomId: "cosmos-core",
+        lines: ["That object is no longer in any room."],
+        openable: false,
+      };
+    }
+
+    const base: Inspection = {
+      ok: true,
+      objectId: object.id,
+      title: object.title,
+      kind: object.kind,
+      link: { ...object.link },
+      roomId: object.roomId,
+      lines: [],
+      openable: false,
+    };
+
+    const record = this.readRecord(object);
+    return {
+      ...base,
+      ok: record.ok,
+      lines: record.lines,
+      openable: record.openable,
+    };
+  }
+
+  /**
+   * Open the record behind an object as a workspace view.
+   *
+   * This is a real open (through WorkspaceAPI, so the same boundary
+   * rules apply): a project switches the active project as well, a task
+   * shows its real step state, a conversation opens its transcript, and
+   * a URL opens the browser view.
+   */
+  open(objectId: string): { ok: boolean; message: string } {
+    const object = SpatialObjects.getInstance().get(objectId);
+    if (!object) return { ok: false, message: "That object is no longer in any room." };
+    const api = WorkspaceAPI.getInstance();
+    const link = object.link;
+
+    if (link.kind === "project") {
+      const project = ProjectStore.getInstance().list().find((item) => item.id === link.id);
+      if (!project) return { ok: false, message: `Project ${link.id} no longer exists.` };
+      const switched = api.execute({ action: "switch-project", actor: "user", projectId: project.id });
+      if (!switched.ok) return { ok: false, message: switched.message };
+      const opened = api.execute({
+        action: "open-workspace",
+        actor: "user",
+        view: {
+          id: `project-${project.id}`,
+          kind: "table",
+          title: project.name,
+          text: [
+            `Project: ${project.name}`,
+            `Status: ${project.status}`,
+            project.objective ? `Objective: ${project.objective}` : "",
+            project.checkpoint ? `Checkpoint: ${project.checkpoint.summary}` : "",
+            project.checkpoint?.nextAction ? `Next: ${project.checkpoint.nextAction}` : "",
+          ]
+            .filter(Boolean)
+            .join("\n"),
+        },
+      });
+      return { ok: opened.ok, message: opened.message };
+    }
+
+    if (link.kind === "task") {
+      const task = TaskEngine.getInstance().get(link.id);
+      if (!task) return { ok: false, message: `Task ${link.id} no longer exists.` };
+      const opened = api.execute({
+        action: "open-workspace",
+        actor: "user",
+        view: {
+          id: `task-${task.id}`,
+          kind: "timeline",
+          title: task.goal,
+          text: [
+            `Task ${task.id}: ${task.goal}`,
+            `Status: ${task.status}`,
+            ...task.steps.map((step, index) => `${index + 1}. [${step.status}] ${step.title || step.id}`),
+          ].join("\n"),
+        },
+      });
+      return { ok: opened.ok, message: opened.message };
+    }
+
+    if (link.kind === "conversation") {
+      const opened = this.openConversation(link.id, api);
+      if (opened) return opened;
+    }
+
+    const url = asUrl(link);
+    if (url) {
+      const opened = api.execute({
+        action: "open-browser",
+        actor: "user",
+        view: { kind: URL_VIEW_KINDS[object.kind] ?? "browser", title: object.title, url },
+      });
+      return { ok: opened.ok, message: opened.message };
+    }
+
+    // A note or research object carries its own text by design: the text
+    // IS the record the object was placed from.
+    if (object.note || object.kind === "note" || object.kind === "research") {
+      const opened = api.execute({
+        action: "open-workspace",
+        actor: "user",
+        view: {
+          kind: "file",
+          title: object.title,
+          text: [object.note ?? "", `Record: ${link.kind} ${link.id}`].filter(Boolean).join("\n\n"),
+        },
+      });
+      return { ok: opened.ok, message: opened.message };
+    }
+
+    return {
+      ok: false,
+      message: `No reader is wired for a ${link.kind} record (${link.id.slice(0, 24)}), so nothing was opened.`,
+    };
+  }
+
+  /* ---------------- internals ---------------- */
+
+  private readRecord(object: SpatialObject): { ok: boolean; lines: string[]; openable: boolean } {
+    const link = object.link;
+
+    if (link.kind === "project") {
+      const project = ProjectStore.getInstance().list().find((item) => item.id === link.id);
+      if (!project) return { ok: false, lines: [`Project ${link.id} is not in the project store any more.`], openable: false };
+      return {
+        ok: true,
+        openable: true,
+        lines: [
+          `Project: ${project.name}`,
+          `Status: ${project.status}`,
+          project.objective ? `Objective: ${clip(project.objective)}` : "",
+          project.checkpoint ? `Checkpoint: ${clip(project.checkpoint.summary)}` : "",
+          `${project.items.length} item${project.items.length === 1 ? "" : "s"} · updated ${new Date(project.updatedAt).toLocaleString()}`,
+        ].filter(Boolean),
+      };
+    }
+
+    if (link.kind === "task") {
+      const task = TaskEngine.getInstance().get(link.id);
+      if (!task) return { ok: false, lines: [`Task ${link.id} is not in the task engine any more.`], openable: false };
+      const done = task.steps.filter((step) => step.status === "completed").length;
+      return {
+        ok: true,
+        openable: true,
+        lines: [
+          `Task: ${task.goal}`,
+          `Status: ${task.status}`,
+          `${done}/${task.steps.length} step${task.steps.length === 1 ? "" : "s"} complete`,
+        ],
+      };
+    }
+
+    if (link.kind === "conversation") {
+      const conversation = this.conversation(link.id);
+      if (!conversation) return { ok: false, lines: [`Conversation ${link.id} is not available.`], openable: false };
+      return {
+        ok: true,
+        openable: true,
+        lines: [`Chat: ${conversation.title}`, `${conversation.messages} message${conversation.messages === 1 ? "" : "s"}`],
+      };
+    }
+
+    const url = asUrl(link);
+    if (url) {
+      return { ok: true, openable: true, lines: [`Address: ${url}`, `Kind: ${object.kind}`] };
+    }
+
+    if (object.note) {
+      return { ok: true, openable: true, lines: [clip(object.note, 400)] };
+    }
+
+    return {
+      ok: false,
+      lines: [`Nothing in this runtime can load a "${link.kind}" record with id ${link.id}.`],
+      openable: false,
+    };
+  }
+
+  /** Read-only: chat state belongs to MultiChatStore, not to the cosmos. */
+  private conversation(id: string): { title: string; messages: number } | null {
+    try {
+      const conversation = MultiChatStore.getInstance().get(id);
+      if (!conversation) return null;
+      return {
+        title: conversation.title || id,
+        messages: Array.isArray(conversation.messages) ? conversation.messages.length : 0,
+      };
+    } catch {
+      return null;
+    }
+  }
+
+  private openConversation(id: string, api: WorkspaceAPI): { ok: boolean; message: string } | null {
+    const conversation = this.conversation(id);
+    if (!conversation) return null;
+    const opened = api.execute({
+      action: "open-workspace",
+      actor: "user",
+      view: {
+        kind: "activity",
+        title: conversation.title,
+        text: `${conversation.messages} message(s) in conversation ${id}.`,
+      },
+    });
+    return { ok: opened.ok, message: opened.message };
+  }
+}
diff --git a/src/core/cosmos/CosmosLiveMap.ts b/src/core/cosmos/CosmosLiveMap.ts
new file mode 100644
index 0000000..bfcd20d
--- /dev/null
+++ b/src/core/cosmos/CosmosLiveMap.ts
@@ -0,0 +1,310 @@
+/**
+ * ==========================================================
+ * LÉLU — LIVE COSMOS MAP
+ *
+ * The cosmos map used to contain only what was registered by
+ * hand. This module makes it reflect the ACTUAL LÉLUVERSE:
+ * the executive galaxies and agent universes CosmosStore is
+ * already drawing, the projects ProjectStore holds, the views
+ * the workspace has open, and SHAMAN.
+ *
+ * Two rules make this safe to run over and over:
+ *
+ *   1. Every destination has a STABLE id, so repeated
+ *      synchronization updates instead of duplicating.
+ *   2. Only destinations this module owns (origin "system",
+ *      not removable, id starting with "map-") are ever
+ *      retired when their source disappears. A room the user
+ *      or LÉLU made is never touched here.
+ *
+ * It does not duplicate live state: a destination carries a
+ * `ref` to the real record and is re-read from the runtime on
+ * each sync, so a renamed agent shows its new name without
+ * losing the visits it accumulated.
+ * ==========================================================
+ */
+
+import CosmosNavigation, {
+  COSMOS_CORE_ID,
+  childPosition,
+  type NavDestination,
+} from "./CosmosNavigation";
+
+export interface LiveAgent {
+  id: string;
+  name: string;
+  position: [number, number, number];
+}
+
+export interface LiveGalaxy {
+  id: string;
+  name: string;
+  /** The executive type that owns it (governor, engineer, …). */
+  execType: string;
+  position: [number, number, number];
+  agents: LiveAgent[];
+}
+
+export interface LiveProject {
+  id: string;
+  name: string;
+  status: string;
+}
+
+export interface LiveView {
+  id: string;
+  title: string;
+  kind: string;
+}
+
+export interface LiveCosmosSnapshot {
+  galaxies: LiveGalaxy[];
+  projects: LiveProject[];
+  views: LiveView[];
+  includeShaman: boolean;
+}
+
+/** Ids are derived from real records, so they are stable across syncs. */
+export const MAP_ID = {
+  galaxy: (execType: string) => `map-galaxy-${execType}`,
+  agent: (agentId: string) => `map-agent-${agentId}`,
+  project: (projectId: string) => `map-project-${projectId}`,
+  view: (viewId: string) => `map-view-${viewId}`,
+  shaman: "map-shaman",
+  workspace: "map-env-workspace",
+} as const;
+
+/** Ids this module owns and may retire when their source is gone. */
+export function isMapOwned(id: string): boolean {
+  return id.startsWith("map-") && id !== MAP_ID.workspace;
+}
+
+function xyz(position: { x: number; y: number; z: number }): [number, number, number] {
+  return [position.x, position.y, position.z];
+}
+
+/**
+ * The destinations the live state implies. Pure, so it can be tested
+ * against a snapshot without a browser or a running app.
+ */
+export function buildCosmosDestinations(snapshot: LiveCosmosSnapshot): NavDestination[] {
+  const destinations: NavDestination[] = [];
+
+  if (snapshot.includeShaman) {
+    destinations.push({
+      id: MAP_ID.shaman,
+      level: "planet",
+      label: "SHAMAN",
+      parentId: COSMOS_CORE_ID,
+      ref: { kind: "cosmos", id: "shaman" },
+      opens: { module: "chat" },
+      position: [0, 6, 0],
+      origin: "system",
+      removable: false,
+    });
+  }
+
+  // The workspace itself is a destination: the open views hang under it,
+  // so "where did that document go" is a place you can walk back to.
+  destinations.push({
+    id: MAP_ID.workspace,
+    level: "planet",
+    label: "Workspace",
+    parentId: COSMOS_CORE_ID,
+    opens: { module: "workspace" },
+    origin: "system",
+    removable: false,
+  });
+
+  for (const view of snapshot.views) {
+    if (!view.id) continue;
+    destinations.push({
+      id: MAP_ID.view(view.id),
+      level: "room",
+      label: view.title || view.kind || "view",
+      parentId: MAP_ID.workspace,
+      ref: null,
+      opens: { module: "workspace", view: view.id },
+      origin: "system",
+      // An open view is not a place the user made; it follows the view.
+      removable: false,
+    });
+  }
+
+  for (const galaxy of snapshot.galaxies) {
+    if (!galaxy.execType) continue;
+    destinations.push({
+      id: MAP_ID.galaxy(galaxy.execType),
+      level: "galaxy",
+      label: galaxy.name,
+      parentId: COSMOS_CORE_ID,
+      ref: { kind: "cosmos", id: galaxy.id || `exec-${galaxy.execType}` },
+      // The rendered galaxy is exactly where CosmosStore put it, so the
+      // map and the 3D scene agree about where a galaxy is.
+      position: galaxy.position,
+      origin: "system",
+      removable: false,
+    });
+
+    for (const agent of galaxy.agents) {
+      if (!agent.id) continue;
+      destinations.push({
+        id: MAP_ID.agent(agent.id),
+        level: "planet",
+        label: agent.name || agent.id,
+        parentId: MAP_ID.galaxy(galaxy.execType),
+        ref: { kind: "agent", id: agent.id },
+        opens: { module: "chat" },
+        position: agent.position,
+        origin: "system",
+        removable: false,
+      });
+    }
+  }
+
+  snapshot.projects.forEach((project, index) => {
+    if (!project.id) return;
+    destinations.push({
+      id: MAP_ID.project(project.id),
+      level: "planet",
+      label: project.name || project.id,
+      parentId: COSMOS_CORE_ID,
+      ref: { kind: "project", id: project.id },
+      opens: { module: "workspace", projectId: project.id },
+      position: childPosition([0, 0, 0], 6 + index),
+      origin: "system",
+      removable: false,
+    });
+  });
+
+  return destinations;
+}
+
+/**
+ * Read the snapshot from the real stores.
+ *
+ * CosmosStore lives in the app tree and touches `window`, so it is
+ * imported lazily: the map works (and is tested) headlessly, and a store
+ * that cannot load degrades to an empty part of the map rather than
+ * taking the whole sync down.
+ */
+export async function readLiveCosmos(): Promise<LiveCosmosSnapshot> {
+  const snapshot: LiveCosmosSnapshot = { galaxies: [], projects: [], views: [], includeShaman: false };
+
+  try {
+    const { default: CosmosStore } = await import("../../app/scene/genesis/cosmos/CosmosStore");
+    const state = CosmosStore.getInstance().getState();
+    snapshot.includeShaman = state.entities.some((entity) => entity.level === "shaman");
+    snapshot.galaxies = state.executiveGalaxies.map((galaxy) => ({
+      id: galaxy.id,
+      name: galaxy.name,
+      execType: galaxy.runtimeId,
+      position: xyz(galaxy.position),
+      agents: state.agentUniverses
+        .filter((universe) => universe.parentId === galaxy.id)
+        .map((universe) => ({
+          id: universe.runtimeId,
+          name: universe.name,
+          position: xyz(universe.position),
+        })),
+    }));
+  } catch {
+    /* no cosmos store in this runtime — the rest of the map still syncs */
+  }
+
+  try {
+    const { default: ProjectStore } = await import("../projects/ProjectStore");
+    snapshot.projects = ProjectStore.getInstance()
+      .list()
+      .filter((project) => project.status !== "archived")
+      .map((project) => ({ id: project.id, name: project.name, status: project.status }));
+  } catch {
+    /* projects unavailable */
+  }
+
+  try {
+    const { default: WorkspaceEngine } = await import("../workspace/WorkspaceEngine");
+    snapshot.views = WorkspaceEngine.getInstance()
+      .getState()
+      .views.map((view) => ({ id: view.id, title: view.title, kind: view.kind }));
+  } catch {
+    /* workspace unavailable */
+  }
+
+  return snapshot;
+}
+
+/**
+ * Apply a snapshot: register everything live, then retire only this
+ * module's destinations whose source has gone.
+ *
+ * Split out from the store read so the behaviour can be tested against a
+ * snapshot, and so the rule (map-owned nodes only, archived not deleted)
+ * lives in one place.
+ */
+export function applyCosmosSnapshot(snapshot: LiveCosmosSnapshot): { destinations: number; retired: number } {
+  const destinations = buildCosmosDestinations(snapshot);
+  const nav = CosmosNavigation.getInstance();
+  nav.registerAll(destinations);
+
+  const live = new Set(destinations.map((destination) => destination.id));
+  let retired = 0;
+  for (const node of nav.getState().nodes) {
+    if (!isMapOwned(node.id)) continue;
+    if (node.origin !== "system" || node.removable) continue;
+    if (live.has(node.id)) continue;
+    if (nav.retire(node.id)) retired += 1;
+  }
+
+  return { destinations: destinations.length, retired };
+}
+
+/**
+ * Synchronize the navigation map with the live environment.
+ *
+ * Idempotent: calling it twice produces the same destinations, with the
+ * same ids, and keeps every visit count. Destinations that vanished from
+ * the runtime are retired (archived, reversible) — never deleted.
+ */
+export async function syncCosmosMap(): Promise<{
+  ok: boolean;
+  destinations: number;
+  retired: number;
+  error?: string;
+}> {
+  try {
+    const snapshot = await readLiveCosmos();
+    return { ok: true, ...applyCosmosSnapshot(snapshot) };
+  } catch (error) {
+    return {
+      ok: false,
+      destinations: 0,
+      retired: 0,
+      error: error instanceof Error ? error.message : String(error),
+    };
+  }
+}
+
+/** A compact, truthful description of the map as it stands. */
+export function describeCosmosMap(): string {
+  const nav = CosmosNavigation.getInstance();
+  const state = nav.getState();
+  const count = (level: string) => state.nodes.filter((node) => node.level === level).length;
+  const current = nav.current();
+  const path = nav
+    .pathTo(current.id)
+    .map((node) => node.label)
+    .join(" › ");
+  const rooms = nav
+    .rooms()
+    .filter((node) => node.origin !== "system")
+    .slice(0, 20)
+    .map((room) => `  ⬡ ${room.label} (${room.visits} visit${room.visits === 1 ? "" : "s"})`);
+
+  return [
+    `You are at ${path || current.label}.`,
+    `${count("galaxy")} galaxies · ${count("planet")} planets · ${count("room")} rooms · ${count("core")} core.`,
+    ...(rooms.length ? ["Rooms you or the user made:", ...rooms] : []),
+    `Trail: ${state.trail.map((id) => nav.get(id)?.label ?? id).join(" → ") || "(just arrived)"}`,
+  ].join("\n");
+}
diff --git a/src/core/cosmos/CosmosNavigation.ts b/src/core/cosmos/CosmosNavigation.ts
new file mode 100644
index 0000000..5d51dd1
--- /dev/null
+++ b/src/core/cosmos/CosmosNavigation.ts
@@ -0,0 +1,472 @@
+/**
+ * ==========================================================
+ * LÉLU — COSMOS NAVIGATION
+ *
+ * The spatial map as a place you can BE, not just look at.
+ *
+ * The 3D cosmos (CosmosStore) draws entities that already exist
+ * in the runtime. This is the layer above it that owns the
+ * things a navigable environment needs and a visualisation does
+ * not: where you currently are, the trail that got you there,
+ * the rooms that were opened, how often each place was visited,
+ * and which workspace a destination opens on arrival.
+ *
+ * Levels are nestable:
+ *
+ *   core ── galaxy ── planet ── room
+ *     └── project areas and sessions hang under the same tree
+ *
+ * Every node may carry a `ref` to a REAL record (an agent, a
+ * project, a task, a conversation). The map never copies those
+ * records — it points at them, so a node cannot disagree with
+ * the thing it names.
+ *
+ * Seeded destinations are re-registered from the runtime on
+ * every boot (so a deleted agent cannot linger as a ghost), and
+ * the same ids are idempotent: visiting a place does not
+ * duplicate it. Rooms created here persist, and a removed room
+ * is archived rather than destroyed, so expansion is reversible.
+ * ==========================================================
+ */
+
+import KvStore from "../storage/KvStore";
+
+export type NavLevel = "core" | "galaxy" | "planet" | "room";
+
+/** Who put this destination here. Expansion by LÉLU is marked as hers. */
+export type NavOrigin = "system" | "lelu" | "user";
+
+/** The real runtime record a node stands for. */
+export interface NavRef {
+  kind: "agent" | "project" | "task" | "conversation" | "cosmos";
+  id: string;
+}
+
+/** What arriving at this destination should open. */
+export interface NavOpen {
+  module?: string;
+  view?: string;
+  projectId?: string;
+  conversationId?: string;
+}
+
+export interface NavNode {
+  id: string;
+  level: NavLevel;
+  label: string;
+  parentId: string | null;
+  ref: NavRef | null;
+  opens: NavOpen | null;
+  position: [number, number, number];
+  origin: NavOrigin;
+  createdAt: number;
+  visits: number;
+  lastVisited: number | null;
+  /** Only rooms LÉLU or the user created can be removed. */
+  removable: boolean;
+  archived: boolean;
+}
+
+export interface NavDestination {
+  id: string;
+  level: NavLevel;
+  label: string;
+  parentId: string | null;
+  ref?: NavRef | null;
+  opens?: NavOpen | null;
+  position?: [number, number, number];
+  origin?: NavOrigin;
+  /**
+   * Only what the user or LÉLU added may be removed. Destinations that
+   * mirror a live record (an agent's planet, an open view) follow their
+   * source instead, so the map cannot be emptied out from under it.
+   */
+  removable?: boolean;
+}
+
+export interface NavigationState {
+  /** Live destinations, in registration order. Archived rooms are excluded. */
+  nodes: NavNode[];
+  currentId: string;
+  /** Visits in order, most recent last. A trail, not a stack of copies. */
+  trail: string[];
+  version: number;
+}
+
+const KEY = "lelu.cosmos.nav.v1";
+/** The root of the map. Exported so callers hang destinations in one place. */
+export const COSMOS_CORE_ID = "cosmos-core";
+const CORE_ID = COSMOS_CORE_ID;
+const MAX_TRAIL = 50;
+const MAX_PERSISTED_ROOMS = 200;
+
+interface PersistedNav {
+  rooms: NavNode[];
+  visits: Record<string, { visits: number; lastVisited: number | null }>;
+  currentId: string;
+  trail: string[];
+}
+
+function coreNode(): NavNode {
+  return {
+    id: CORE_ID,
+    level: "core",
+    label: "LÉLU CORE",
+    parentId: null,
+    ref: { kind: "cosmos", id: "lelu-core" },
+    opens: { module: "chat" },
+    position: [0, 0, 0],
+    origin: "system",
+    createdAt: 0,
+    visits: 0,
+    lastVisited: null,
+    removable: false,
+    archived: false,
+  };
+}
+
+/** Deterministic ring position for the nth child of a parent. */
+export function childPosition(parent: [number, number, number], index: number): [number, number, number] {
+  const angle = (index / Math.max(index + 1, 6)) * Math.PI * 2 + index * 0.7;
+  const radius = 3 + (index % 4) * 1.6;
+  return [
+    parent[0] + Math.cos(angle) * radius,
+    parent[1] + (index % 3) * 1.1 - 1,
+    parent[2] + Math.sin(angle) * radius,
+  ];
+}
+
+export default class CosmosNavigation {
+  private static instance: CosmosNavigation | null = null;
+
+  private nodes = new Map<string, NavNode>();
+  private trail: string[] = [];
+  private currentId = CORE_ID;
+  private version = 0;
+  private listeners = new Set<(state: NavigationState) => void>();
+
+  private constructor() {
+    this.nodes.set(CORE_ID, coreNode());
+    this.load();
+  }
+
+  static getInstance(): CosmosNavigation {
+    if (!CosmosNavigation.instance) CosmosNavigation.instance = new CosmosNavigation();
+    return CosmosNavigation.instance;
+  }
+
+  /** Drop the singleton and its persisted rooms (tests, full reset). */
+  static reset(): void {
+    CosmosNavigation.instance = null;
+    try {
+      KvStore.getInstance().remove(KEY);
+    } catch {
+      /* storage blocked */
+    }
+  }
+
+  getState(): NavigationState {
+    return {
+      nodes: [...this.nodes.values()].filter((node) => !node.archived),
+      currentId: this.currentId,
+      trail: [...this.trail],
+      version: this.version,
+    };
+  }
+
+  subscribe(listener: (state: NavigationState) => void): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  /**
+   * Register (or refresh) a destination. Idempotent by id: the label,
+   * parent, ref and what it opens can be corrected by the runtime, while
+   * visits, position and the room's own persistence are kept.
+   */
+  register(destination: NavDestination): NavNode {
+    const existing = this.nodes.get(destination.id);
+    if (existing) {
+      existing.label = destination.label;
+      existing.parentId = destination.parentId;
+      existing.level = destination.level;
+      if (destination.ref !== undefined) existing.ref = destination.ref;
+      if (destination.opens !== undefined) existing.opens = destination.opens;
+      if (destination.origin) existing.origin = destination.origin;
+      if (destination.position) existing.position = destination.position;
+      if (destination.removable !== undefined) existing.removable = destination.removable;
+      this.version += 1;
+      // A persisted room whose label the runtime corrected must keep the
+      // correction across a reload, or a rename would revert on boot.
+      if (existing.origin !== "system") this.persist();
+      this.notify();
+      return existing;
+    }
+
+    const parent = destination.parentId ? this.nodes.get(destination.parentId) : undefined;
+    const siblings = this.childrenOf(destination.parentId ?? null).length;
+    const node: NavNode = {
+      id: destination.id,
+      level: destination.level,
+      label: destination.label,
+      parentId: destination.parentId,
+      ref: destination.ref ?? null,
+      opens: destination.opens ?? null,
+      position: destination.position ?? childPosition(parent?.position ?? [0, 0, 0], siblings),
+      origin: destination.origin ?? "system",
+      createdAt: Date.now(),
+      visits: 0,
+      lastVisited: null,
+      removable: destination.removable ?? destination.level === "room",
+      archived: false,
+    };
+    this.nodes.set(node.id, node);
+    this.version += 1;
+    this.persist();
+    this.notify();
+    return node;
+  }
+
+  registerAll(destinations: NavDestination[]): void {
+    for (const destination of destinations) this.register(destination);
+  }
+
+  get(id: string): NavNode | undefined {
+    return this.nodes.get(id);
+  }
+
+  current(): NavNode {
+    return this.nodes.get(this.currentId) ?? coreNode();
+  }
+
+  children(parentId: string | null): NavNode[] {
+    return this.childrenOf(parentId);
+  }
+
+  /** Root → node, for a breadcrumb. Empty when the id is unknown. */
+  pathTo(id: string): NavNode[] {
+    const path: NavNode[] = [];
+    const seen = new Set<string>();
+    let cursor = this.nodes.get(id);
+    while (cursor && !seen.has(cursor.id)) {
+      seen.add(cursor.id);
+      path.unshift(cursor);
+      cursor = cursor.parentId ? this.nodes.get(cursor.parentId) : undefined;
+    }
+    return path;
+  }
+
+  /** Travel to a destination. Unknown or archived ids do not move you. */
+  navigateTo(id: string): NavNode | null {
+    const node = this.nodes.get(id);
+    if (!node || node.archived) return null;
+    // The first move starts the trail from where you already were, so a
+    // trail always reads as a path rather than a list that begins mid-way.
+    if (this.trail.length === 0 && this.currentId !== id) this.trail = [this.currentId];
+    this.currentId = id;
+    node.visits += 1;
+    node.lastVisited = Date.now();
+    this.trail = [...this.trail.filter((entry) => entry !== id), id].slice(-MAX_TRAIL);
+    this.version += 1;
+    this.persist();
+    this.notify();
+    return node;
+  }
+
+  /** The place before the current one, if the trail has one. */
+  back(): NavNode | null {
+    if (this.trail.length < 2) return null;
+    const previous = this.trail[this.trail.length - 2];
+    return this.navigateTo(previous);
+  }
+
+  /**
+   * Open a new room. This is how the environment grows: LÉLU (with
+   * approval — see CosmosAutonomy) or the user names a place, it hangs
+   * under an existing destination, and it opens a real workspace on
+   * arrival. A room with the same label under the same parent is reused
+   * rather than duplicated.
+   */
+  createRoom(input: {
+    label: string;
+    parentId?: string | null;
+    opens?: NavOpen | null;
+    origin?: NavOrigin;
+    ref?: NavRef | null;
+  }): { ok: true; node: NavNode; created: boolean } | { ok: false; error: string } {
+    const label = input.label.trim();
+    if (!label) return { ok: false, error: "a room needs a name" };
+    const parentId = input.parentId ?? CORE_ID;
+    const parent = this.nodes.get(parentId);
+    if (!parent || parent.archived) return { ok: false, error: `no destination "${parentId}" to hang a room under` };
+
+    const duplicate = this.childrenOf(parentId).find(
+      (node) => node.level === "room" && node.label.toLowerCase() === label.toLowerCase(),
+    );
+    if (duplicate) return { ok: true, node: duplicate, created: false };
+
+    const index = this.childrenOf(parentId).length;
+    const node: NavNode = {
+      id: `room-${crypto.randomUUID().slice(0, 8)}`,
+      level: "room",
+      label,
+      parentId,
+      ref: input.ref ?? null,
+      opens: input.opens ?? null,
+      position: childPosition(parent.position, index),
+      origin: input.origin ?? "user",
+      createdAt: Date.now(),
+      visits: 0,
+      lastVisited: null,
+      removable: true,
+      archived: false,
+    };
+    this.nodes.set(node.id, node);
+    this.version += 1;
+    this.persist();
+    this.notify();
+    return { ok: true, node, created: true };
+  }
+
+  /** Archive a room. Reversible: the node and its visits are kept. */
+  removeRoom(id: string): { ok: true; node: NavNode } | { ok: false; error: string } {
+    const node = this.nodes.get(id);
+    if (!node) return { ok: false, error: `no destination "${id}"` };
+    if (!node.removable || node.level !== "room") {
+      return { ok: false, error: `"${node.label}" is part of the environment and cannot be removed` };
+    }
+    if (node.archived) return { ok: true, node };
+    node.archived = true;
+    if (this.currentId === id) {
+      this.currentId = node.parentId && this.nodes.get(node.parentId) ? node.parentId : CORE_ID;
+    }
+    this.trail = this.trail.filter((entry) => entry !== id);
+    this.version += 1;
+    this.persist();
+    this.notify();
+    return { ok: true, node };
+  }
+
+  /**
+   * Remove a destination that mirrors a live record, because that record
+   * is gone. Only system-owned destinations can be retired this way; a
+   * room the user or LÉLU made goes through removeRoom instead.
+   */
+  retire(id: string): boolean {
+    if (id === CORE_ID) return false;
+    const node = this.nodes.get(id);
+    if (!node || node.archived) return false;
+    if (node.origin !== "system" || node.removable) return false;
+    node.archived = true;
+    if (this.currentId === id) {
+      this.currentId = node.parentId && this.nodes.get(node.parentId) ? node.parentId : CORE_ID;
+    }
+    this.trail = this.trail.filter((entry) => entry !== id);
+    this.version += 1;
+    this.persist();
+    this.notify();
+    return true;
+  }
+
+  /** Archived rooms, so a removal can be undone from the interface. */
+  archivedRooms(): NavNode[] {
+    return [...this.nodes.values()].filter((node) => node.level === "room" && node.archived);
+  }
+
+  /** Bring an archived room back exactly as it was. */
+  restoreRoom(id: string): { ok: true; node: NavNode } | { ok: false; error: string } {
+    const node = this.nodes.get(id);
+    if (!node) return { ok: false, error: `no destination "${id}"` };
+    if (!node.archived) return { ok: true, node };
+    node.archived = false;
+    this.version += 1;
+    this.persist();
+    this.notify();
+    return { ok: true, node };
+  }
+
+  /** Every room, for a workspace listing. */
+  rooms(): NavNode[] {
+    return [...this.nodes.values()].filter((node) => node.level === "room" && !node.archived);
+  }
+
+  /** Re-read persisted visits and rooms (a fresh start sees the same map). */
+  reload(): void {
+    this.load();
+    this.version += 1;
+    this.notify();
+  }
+
+  destroy(): void {
+    this.listeners.clear();
+    CosmosNavigation.instance = null;
+  }
+
+  /* ---------------- internals ---------------- */
+
+  private childrenOf(parentId: string | null): NavNode[] {
+    return [...this.nodes.values()].filter((node) => node.parentId === parentId && !node.archived);
+  }
+
+  private notify(): void {
+    const state = this.getState();
+    for (const listener of this.listeners) {
+      try {
+        listener(state);
+      } catch (error) {
+        console.error("[CosmosNavigation] listener failed:", error);
+      }
+    }
+  }
+
+  private persist(): void {
+    try {
+      const rooms = [...this.nodes.values()]
+        .filter((node) => node.level === "room" && node.origin !== "system")
+        .slice(-MAX_PERSISTED_ROOMS);
+      const visits: PersistedNav["visits"] = {};
+      for (const node of this.nodes.values()) {
+        if (node.visits > 0) visits[node.id] = { visits: node.visits, lastVisited: node.lastVisited };
+      }
+      const payload: PersistedNav = {
+        rooms,
+        visits,
+        currentId: this.currentId,
+        trail: this.trail,
+      };
+      KvStore.getInstance().set(KEY, payload);
+    } catch {
+      /* persistence must never break navigation */
+    }
+  }
+
+  private load(): void {
+    let stored: PersistedNav | null = null;
+    try {
+      stored = KvStore.getInstance().get<PersistedNav>(KEY);
+    } catch {
+      stored = null;
+    }
+    if (!stored) return;
+
+    for (const room of stored.rooms ?? []) {
+      if (!room || !room.id) continue;
+      // A persisted room must hang under something that still exists.
+      const parentId = room.parentId && this.nodes.has(room.parentId) ? room.parentId : CORE_ID;
+      this.nodes.set(room.id, { ...room, level: "room", removable: true, parentId });
+    }
+    for (const [id, visit] of Object.entries(stored.visits ?? {})) {
+      const node = this.nodes.get(id);
+      if (!node) continue;
+      node.visits = visit.visits;
+      node.lastVisited = visit.lastVisited;
+    }
+    if (stored.currentId && this.nodes.get(stored.currentId) && !this.nodes.get(stored.currentId)!.archived) {
+      this.currentId = stored.currentId;
+    }
+    this.trail = (stored.trail ?? []).filter((id) => {
+      const node = this.nodes.get(id);
+      return Boolean(node && !node.archived);
+    });
+  }
+}
diff --git a/src/core/cosmos/CosmosTools.ts b/src/core/cosmos/CosmosTools.ts
new file mode 100644
index 0000000..fb37f5c
--- /dev/null
+++ b/src/core/cosmos/CosmosTools.ts
@@ -0,0 +1,421 @@
+/**
+ * ==========================================================
+ * LÉLU — COSMOS TOOLS
+ *
+ * The workspace API and the live map, offered to LÉLU through
+ * the SAME pipeline every other tool uses: ToolRegistry marks
+ * it, ToolDispatcher runs it, AutonomyGate gates it, and the
+ * activity timeline shows the real result.
+ *
+ * The model-facing tool id is "cosmos.workspace". It never
+ * decides its own boundary: every call goes through
+ * WorkspaceAPI.execute, which classifies it with
+ * CosmosAutonomy and raises a real ApprovalGate request when
+ * the boundary says wait.
+ *
+ * The actor is ALWAYS "lelu". A model must not be able to pass
+ * actor:"user" and thereby treat its own click as consent —
+ * that would make the approval gate decorative.
+ * ==========================================================
+ */
+
+import ToolRegistry, { type ToolDefinition } from "../tools/ToolRegistry";
+import { registerExecutor } from "../tools/ToolDispatcher";
+import type { ToolExecutionResult, ToolExecutor } from "../tools/ToolDispatcher";
+import type { CosmosAction } from "./CosmosAutonomy";
+import CosmosNavigation from "./CosmosNavigation";
+import CosmosInspector from "./CosmosInspector";
+import { describeCosmosMap, syncCosmosMap } from "./CosmosLiveMap";
+import WorkspaceAPI, { type WorkspaceCall } from "../workspace/WorkspaceAPI";
+import type { WorkspaceLayoutMode, WorkspaceViewKind } from "../workspace/WorkspaceEngine";
+import type { SpatialKind } from "./SpatialObjects";
+
+const WORKSPACE_ACTIONS: CosmosAction[] = [
+  "navigate",
+  "open-workspace",
+  "read-file",
+  "open-browser",
+  "arrange-windows",
+  "switch-project",
+  "place-object",
+  "create-room",
+  "remove-room",
+  "run-task",
+  "pause-task",
+  "resume-task",
+  "cancel-task",
+  "restore-workspace",
+  "publish-extension",
+];
+
+const VIEW_KINDS: WorkspaceViewKind[] = [
+  "diagram",
+  "chart",
+  "table",
+  "timeline",
+  "wireframe",
+  "file",
+  "browser",
+  "video",
+  "image",
+  "memory",
+  "cognition",
+  "providers",
+  "genesis",
+  "activity",
+  "executive",
+  "design",
+];
+
+const LAYOUTS: WorkspaceLayoutMode[] = ["auto", "grid", "split", "stack"];
+
+const SPATIAL_KINDS: SpatialKind[] = [
+  "message",
+  "document",
+  "image",
+  "video",
+  "research",
+  "project",
+  "task",
+  "file",
+  "conversation",
+  "note",
+];
+
+const definition = (
+  id: string,
+  name: string,
+  description: string,
+  riskLevel: 0 | 1,
+  inputSchema?: Record<string, unknown>,
+): ToolDefinition => ({
+  id,
+  name,
+  description,
+  category: "Cosmos",
+  permissions: riskLevel === 0 ? ["READ"] : ["READ", "WRITE"],
+  riskLevel,
+  available: true,
+  ...(inputSchema ? { inputSchema } : {}),
+});
+
+export const COSMOS_TOOLS: ToolDefinition[] = [
+  definition(
+    "cosmos.workspace",
+    "Operate the Workspace",
+    "Move around the cosmos and change the workspace: go to a room, open or read something, arrange windows, place a link to a real record, make or remove a room, run or pause a background task, switch project, restore the saved workspace. Actions that outlive the moment come back with an approval id instead of running.",
+    1,
+  ),
+  definition(
+    "cosmos.map",
+    "Read the Cosmos Map",
+    "Synchronise and read the live map: galaxies, agent planets, projects, open workspace views, rooms and the trail to where you are now",
+    0,
+  ),
+  definition(
+    "cosmos.inspect",
+    "Inspect a Placed Record",
+    "Read the real record behind an object placed in a room (a project, task, conversation, note or link), or open it in the workspace",
+    0,
+  ),
+];
+
+export function registerCosmosTools(): void {
+  const registry = ToolRegistry.getInstance();
+  for (const tool of COSMOS_TOOLS) registry.register(tool);
+  // The executors join the dispatcher through its own runtime registration
+  // path (registerExecutor), which registers the definition as well. A
+  // static import of these executors from ToolDispatcher would be a cycle:
+  // this module drives WorkspaceAPI, whose approval gate reads ToolRegistry.
+  for (const executor of COSMOS_EXECUTORS) {
+    const definition = COSMOS_TOOLS.find((tool) => tool.id === executor.id);
+    if (!definition) continue;
+    const added = registerExecutor(executor, definition);
+    if (!added.ok) console.warn(`[CosmosTools] ${executor.id} was not registered: ${added.reason}`);
+  }
+}
+
+const str = (args: Record<string, unknown>, key: string): string =>
+  typeof args[key] === "string" ? (args[key] as string).trim() : "";
+
+function obj(args: Record<string, unknown>, key: string): Record<string, unknown> | null {
+  const value = args[key];
+  return value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : null;
+}
+
+/**
+ * Turn model arguments into a validated WorkspaceCall.
+ *
+ * Arguments are checked before anything executes: an unknown action or a
+ * view kind that does not exist is refused with the valid options, rather
+ * than silently falling through to a default the user never saw.
+ */
+export function parseWorkspaceCall(args: Record<string, unknown>): { ok: true; call: WorkspaceCall } | { ok: false; error: string } {
+  const action = str(args, "action") as CosmosAction;
+  if (!action) return { ok: false, error: `cosmos_workspace needs an action. One of: ${WORKSPACE_ACTIONS.join(", ")}.` };
+  if (!WORKSPACE_ACTIONS.includes(action)) {
+    return {
+      ok: false,
+      error: `"${action}" is not a workspace action. One of: ${WORKSPACE_ACTIONS.join(", ")}. Protected actions (secrets, authentication, database, deployment, autonomy) are never available as tools.`,
+    };
+  }
+
+  const call: WorkspaceCall = { action, actor: "lelu" };
+
+  const approvalId = str(args, "approvalId");
+  if (approvalId) call.approvalId = approvalId;
+
+  const roomId = str(args, "roomId");
+  if (roomId) call.roomId = roomId;
+
+  const projectId = str(args, "projectId");
+  if (projectId) call.projectId = projectId;
+
+  const taskId = str(args, "taskId");
+  if (taskId) call.taskId = taskId;
+
+  const extensionId = str(args, "extensionId");
+  if (extensionId) call.extensionId = extensionId;
+
+  const layout = str(args, "layout");
+  if (layout) {
+    if (!(LAYOUTS as string[]).includes(layout)) {
+      return { ok: false, error: `"${layout}" is not a window layout. One of: ${LAYOUTS.join(", ")}.` };
+    }
+    call.layout = layout as WorkspaceLayoutMode;
+  }
+
+  const view = obj(args, "view");
+  if (view) {
+    const kind = String(view.kind ?? "").trim() as WorkspaceViewKind;
+    const title = String(view.title ?? "").trim();
+    if (!title) return { ok: false, error: "a view needs a title." };
+    if (!(VIEW_KINDS as string[]).includes(kind)) {
+      return { ok: false, error: `"${kind}" is not a view kind. One of: ${VIEW_KINDS.join(", ")}.` };
+    }
+    const text = typeof view.text === "string" ? view.text : undefined;
+    const url = typeof view.url === "string" ? view.url : undefined;
+    const id = typeof view.id === "string" ? view.id : undefined;
+    call.view = {
+      kind,
+      title,
+      ...(id ? { id } : {}),
+      ...(text !== undefined ? { text } : {}),
+      ...(url !== undefined ? { url } : {}),
+    };
+  }
+
+  const room = obj(args, "room");
+  if (room) {
+    const label = String(room.label ?? "").trim();
+    if (!label) return { ok: false, error: "a new room needs a label." };
+    const parentId = typeof room.parentId === "string" && room.parentId.trim() ? room.parentId.trim() : null;
+    call.room = { label, parentId };
+  }
+
+  const object = obj(args, "object");
+  if (object) {
+    const kind = String(object.kind ?? "").trim() as SpatialKind;
+    const title = String(object.title ?? "").trim();
+    const link = obj(object, "link");
+    const linkKind = link ? String(link.kind ?? "").trim() : "";
+    const linkId = link ? String(link.id ?? "").trim() : "";
+    if (!(SPATIAL_KINDS as string[]).includes(kind)) {
+      return { ok: false, error: `"${kind}" is not a placeable kind. One of: ${SPATIAL_KINDS.join(", ")}.` };
+    }
+    if (!title) return { ok: false, error: "a placed object needs a title." };
+    if (!linkKind || !linkId) {
+      return { ok: false, error: "a placed object must link to a real record: pass object.link {kind, id}." };
+    }
+    call.object = {
+      kind,
+      title,
+      link: { kind: linkKind, id: linkId },
+      ...(typeof object.note === "string" ? { note: object.note } : {}),
+      ...(typeof object.pinned === "boolean" ? { pinned: object.pinned } : {}),
+    };
+  }
+
+  // Validate the arguments the chosen action actually needs, before the
+  // policy check, so a missing id is reported as a bad call rather than
+  // as a boundary refusal.
+  const needs: Partial<Record<CosmosAction, keyof WorkspaceCall>> = {
+    navigate: "roomId",
+    "remove-room": "roomId",
+    "run-task": "taskId",
+    "pause-task": "taskId",
+    "resume-task": "taskId",
+    "cancel-task": "taskId",
+    "switch-project": "projectId",
+    "publish-extension": "extensionId",
+  };
+  const required = needs[action];
+  if (required && !call[required]) {
+    return { ok: false, error: `${action} needs ${String(required)}.` };
+  }
+  if ((action === "open-workspace" || action === "read-file" || action === "open-browser") && !call.view) {
+    return { ok: false, error: `${action} needs a view {kind, title} (plus url for open-browser).` };
+  }
+  if (action === "place-object" && !call.object) {
+    return { ok: false, error: "place-object needs an object {kind, title, link}." };
+  }
+  if (action === "create-room" && !call.room) {
+    return { ok: false, error: "create-room needs a room {label}." };
+  }
+  if (action === "arrange-windows" && !call.layout) {
+    return { ok: false, error: "arrange-windows needs a layout (auto, grid, split, stack)." };
+  }
+
+  return { ok: true, call };
+}
+
+export const COSMOS_EXECUTORS: ToolExecutor[] = [
+  {
+    id: "cosmos.workspace",
+    parameters: {
+      type: "object",
+      properties: {
+        action: {
+          type: "string",
+          enum: WORKSPACE_ACTIONS,
+          description: "What to do. go to a room (navigate), open a view, place a record, make a room, run or pause a task, and so on.",
+        },
+        roomId: { type: "string", description: "A destination id from cosmos_map (a room, planet or galaxy)." },
+        projectId: { type: "string", description: "A project id, for switch-project." },
+        taskId: { type: "string", description: "A background task id, for run/pause/resume/cancel-task." },
+        layout: { type: "string", enum: LAYOUTS, description: "Window arrangement, for arrange-windows." },
+        view: {
+          type: "object",
+          properties: {
+            id: { type: "string", description: "Reuse this view id to update a window already open." },
+            kind: { type: "string", enum: VIEW_KINDS },
+            title: { type: "string" },
+            text: { type: "string" },
+            url: { type: "string" },
+          },
+          required: ["kind", "title"],
+          description: "The window to open (open-workspace / read-file / open-browser).",
+        },
+        room: {
+          type: "object",
+          properties: { label: { type: "string" }, parentId: { type: "string" } },
+          required: ["label"],
+          description: "The room to create.",
+        },
+        object: {
+          type: "object",
+          properties: {
+            kind: { type: "string", enum: SPATIAL_KINDS },
+            title: { type: "string" },
+            link: {
+              type: "object",
+              properties: { kind: { type: "string" }, id: { type: "string" } },
+              required: ["kind", "id"],
+              description: "The REAL record this object stands for.",
+            },
+            note: { type: "string" },
+            pinned: { type: "boolean" },
+          },
+          required: ["kind", "title", "link"],
+          description: "The record to place in the room.",
+        },
+        extensionId: { type: "string", description: "A verified extension to publish." },
+        approvalId: {
+          type: "string",
+          description:
+            "Only after the user approved this exact call: the id returned by the previous attempt. It works once, for the same arguments.",
+        },
+      },
+      required: ["action"],
+    },
+    run: async (args): Promise<ToolExecutionResult> => {
+      const parsed = parseWorkspaceCall(args);
+      if (!parsed.ok) return { ok: false, content: parsed.error };
+
+      const result = WorkspaceAPI.getInstance().execute(parsed.call);
+      const data = {
+        ok: result.ok,
+        boundary: result.boundary,
+        requiresApproval: result.requiresApproval,
+        ...(result.approvalId ? { approvalId: result.approvalId } : {}),
+      };
+
+      if (result.requiresApproval) {
+        return {
+          ok: false,
+          content:
+            `NOT DONE YET — this is a ${result.boundary} action: ${result.message} Nothing in the workspace has changed. ` +
+            `The user can approve or reject it from the approvals shown in the conversation` +
+            `${result.approvalId ? ` (approval id ${result.approvalId})` : ""}. ` +
+            `After they approve, call cosmos_workspace again with the same arguments plus that approvalId; after they reject it, do not retry.`,
+          data,
+        };
+      }
+
+      return {
+        ok: result.ok,
+        content: `${result.boundary.toUpperCase()}: ${result.message}`,
+        data,
+      };
+    },
+  },
+
+  {
+    id: "cosmos.map",
+    parameters: {
+      type: "object",
+      properties: {
+        sync: {
+          type: "boolean",
+          description: "Re-read the live environment first (default true). Set false to read the map as it stands.",
+        },
+      },
+    },
+    run: async (args): Promise<ToolExecutionResult> => {
+      const sync = args.sync !== false;
+      const synced = sync ? await syncCosmosMap() : { ok: true, destinations: 0, retired: 0 };
+      const nav = CosmosNavigation.getInstance();
+      const nodes = nav.getState().nodes;
+      return {
+        ok: true,
+        content:
+          `${sync && synced.ok ? `Synchronised with the live environment: ${synced.destinations} destinations, ${synced.retired} retired.\n` : ""}` +
+          `${synced.ok ? "" : `The live stores could not be read (${synced.error ?? "unknown error"}), so this is the map as it stands.\n`}` +
+          describeCosmosMap(),
+        data: {
+          destinations: nodes.length,
+          rooms: nodes.filter((node) => node.level === "room").length,
+          currentId: nav.current().id,
+          trail: nav.getState().trail,
+        },
+      };
+    },
+  },
+
+  {
+    id: "cosmos.inspect",
+    parameters: {
+      type: "object",
+      properties: {
+        objectId: { type: "string", description: "The id of an object placed in a room." },
+        open: { type: "boolean", description: "Open the record in the workspace as well as reporting it." },
+      },
+      required: ["objectId"],
+    },
+    run: async (args): Promise<ToolExecutionResult> => {
+      const objectId = str(args, "objectId");
+      if (!objectId) return { ok: false, content: "cosmos_inspect needs an objectId." };
+      const inspector = CosmosInspector.getInstance();
+      const inspection = inspector.inspect(objectId);
+      const lines = [
+        `${inspection.title} — ${inspection.link.kind} ${inspection.link.id} in ${inspection.roomId}`,
+        ...inspection.lines.map((line) => `  ${line}`),
+      ];
+      if (args.open === true) {
+        const opened = inspector.open(objectId);
+        lines.push(opened.ok ? `Opened: ${opened.message}` : `Not opened: ${opened.message}`);
+      }
+      return { ok: inspection.ok, content: lines.join("\n"), data: inspection };
+    },
+  },
+];
diff --git a/src/core/cosmos/SpatialObjects.ts b/src/core/cosmos/SpatialObjects.ts
new file mode 100644
index 0000000..4ec346f
--- /dev/null
+++ b/src/core/cosmos/SpatialObjects.ts
@@ -0,0 +1,250 @@
+/**
+ * ==========================================================
+ * LÉLU — SPATIAL OBJECTS
+ *
+ * A message, a document, an image, a video, a research brief,
+ * a project, or a task can sit in a room as a thing you move
+ * around — while remaining the record it came from.
+ *
+ * The rule this file exists to enforce: a spatial object is a
+ * POSITION AND A POINTER, never a copy. Every object carries a
+ * link to a real record; there is no way to create one without
+ * a record id. Anything that displays the object is expected to
+ * load the record by that link, so a stale card can never
+ * invent content that the record does not contain.
+ *
+ * Placement is idempotent by record: dropping the same record
+ * into the cosmos twice updates the object that is already
+ * there instead of stacking duplicates (the same rule views and
+ * conversations follow elsewhere in the codebase).
+ * ==========================================================
+ */
+
+import KvStore from "../storage/KvStore";
+
+export type SpatialKind =
+  | "message"
+  | "document"
+  | "image"
+  | "video"
+  | "research"
+  | "project"
+  | "task"
+  | "file"
+  | "conversation"
+  | "note";
+
+/** The record this object stands for. Never optional, never generated. */
+export interface RecordLink {
+  kind: string;
+  id: string;
+}
+
+export interface SpatialObject {
+  id: string;
+  kind: SpatialKind;
+  title: string;
+  link: RecordLink;
+  /** The room it sits in (a CosmosNavigation room id, or "cosmos-core"). */
+  roomId: string;
+  position: [number, number, number];
+  pinned: boolean;
+  note?: string;
+  createdAt: number;
+  updatedAt: number;
+}
+
+export interface PlaceInput {
+  kind: SpatialKind;
+  title: string;
+  link: RecordLink;
+  roomId?: string;
+  position?: [number, number, number];
+  note?: string;
+  pinned?: boolean;
+}
+
+export type PlaceResult =
+  | { ok: true; object: SpatialObject; duplicate: boolean }
+  | { ok: false; error: string };
+
+const KEY = "lelu.cosmos.objects.v1";
+const MAX_OBJECTS = 500;
+
+function sameLink(a: RecordLink, b: RecordLink): boolean {
+  return a.kind === b.kind && a.id === b.id;
+}
+
+/** Deterministic free spot in a room, so two drops do not land on top of each other. */
+function nextPosition(count: number): [number, number, number] {
+  const angle = count * 2.399963; // golden angle — spreads without overlap
+  const radius = 1.4 + Math.sqrt(count) * 0.9;
+  return [Math.cos(angle) * radius, 0.2 + (count % 3) * 0.4, Math.sin(angle) * radius];
+}
+
+export default class SpatialObjects {
+  private static instance: SpatialObjects | null = null;
+
+  private objects: SpatialObject[] = [];
+  private listeners = new Set<(objects: SpatialObject[]) => void>();
+
+  private constructor() {
+    this.load();
+  }
+
+  static getInstance(): SpatialObjects {
+    if (!SpatialObjects.instance) SpatialObjects.instance = new SpatialObjects();
+    return SpatialObjects.instance;
+  }
+
+  static reset(): void {
+    SpatialObjects.instance = null;
+    try {
+      KvStore.getInstance().remove(KEY);
+    } catch {
+      /* storage blocked */
+    }
+  }
+
+  list(roomId?: string): SpatialObject[] {
+    return roomId ? this.objects.filter((object) => object.roomId === roomId) : [...this.objects];
+  }
+
+  get(id: string): SpatialObject | undefined {
+    return this.objects.find((object) => object.id === id);
+  }
+
+  /** The object for a record, if it has been placed. */
+  find(link: RecordLink): SpatialObject | undefined {
+    return this.objects.find((object) => sameLink(object.link, link));
+  }
+
+  /** Every object in a room, ordered so a renderer can be deterministic. */
+  inRoom(roomId: string): SpatialObject[] {
+    return this.objects
+      .filter((object) => object.roomId === roomId)
+      .sort((a, b) => Number(b.pinned) - Number(a.pinned) || a.createdAt - b.createdAt);
+  }
+
+  place(input: PlaceInput): PlaceResult {
+    if (!input.link || !input.link.kind || !input.link.id) {
+      return { ok: false, error: "a spatial object must point at a real record (kind and id)" };
+    }
+    const title = input.title.trim();
+    if (!title) return { ok: false, error: "a spatial object needs a title" };
+
+    const existing = this.find(input.link);
+    if (existing) {
+      existing.title = title;
+      if (input.note !== undefined) existing.note = input.note;
+      if (input.pinned !== undefined) existing.pinned = input.pinned;
+      existing.updatedAt = Date.now();
+      this.persist();
+      this.notify();
+      return { ok: true, object: existing, duplicate: true };
+    }
+
+    const roomId = input.roomId ?? "cosmos-core";
+    const object: SpatialObject = {
+      id: `obj-${crypto.randomUUID().slice(0, 8)}`,
+      kind: input.kind,
+      title,
+      link: { ...input.link },
+      roomId,
+      position: input.position ?? nextPosition(this.inRoom(roomId).length),
+      pinned: input.pinned ?? false,
+      ...(input.note !== undefined ? { note: input.note } : {}),
+      createdAt: Date.now(),
+      updatedAt: Date.now(),
+    };
+    this.objects = [...this.objects, object].slice(-MAX_OBJECTS);
+    this.persist();
+    this.notify();
+    return { ok: true, object, duplicate: false };
+  }
+
+  /** Move an object to a new spot in its room (or into another room). */
+  move(id: string, position: [number, number, number], roomId?: string): SpatialObject | null {
+    const object = this.get(id);
+    if (!object) return null;
+    object.position = [...position] as [number, number, number];
+    if (roomId) object.roomId = roomId;
+    object.updatedAt = Date.now();
+    this.persist();
+    this.notify();
+    return object;
+  }
+
+  pin(id: string, pinned = true): SpatialObject | null {
+    const object = this.get(id);
+    if (!object) return null;
+    object.pinned = pinned;
+    object.updatedAt = Date.now();
+    this.persist();
+    this.notify();
+    return object;
+  }
+
+  remove(id: string): boolean {
+    const before = this.objects.length;
+    this.objects = this.objects.filter((object) => object.id !== id);
+    if (this.objects.length === before) return false;
+    this.persist();
+    this.notify();
+    return true;
+  }
+
+  subscribe(listener: (objects: SpatialObject[]) => void): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  reload(): void {
+    this.load();
+    this.notify();
+  }
+
+  /** Snapshot for a reversible extension checkpoint. */
+  snapshot(): SpatialObject[] {
+    return this.objects.map((object) => ({ ...object, link: { ...object.link }, position: [...object.position] as [number, number, number] }));
+  }
+
+  /** Put the objects back exactly as a snapshot recorded them. */
+  restore(snapshot: SpatialObject[]): void {
+    this.objects = snapshot.map((object) => ({
+      ...object,
+      link: { ...object.link },
+      position: [...object.position] as [number, number, number],
+    }));
+    this.persist();
+    this.notify();
+  }
+
+  private notify(): void {
+    const objects = [...this.objects];
+    for (const listener of this.listeners) {
+      try {
+        listener(objects);
+      } catch (error) {
+        console.error("[SpatialObjects] listener failed:", error);
+      }
+    }
+  }
+
+  private persist(): void {
+    try {
+      KvStore.getInstance().set(KEY, this.objects);
+    } catch {
+      /* best-effort */
+    }
+  }
+
+  private load(): void {
+    try {
+      const stored = KvStore.getInstance().get<SpatialObject[]>(KEY);
+      this.objects = Array.isArray(stored) ? stored.filter((object) => object?.link?.id) : [];
+    } catch {
+      this.objects = [];
+    }
+  }
+}
