diff --git a/src/core/studio/StudioApprovals.ts b/src/core/studio/StudioApprovals.ts
new file mode 100644
index 0000000..c9bc1f9
--- /dev/null
+++ b/src/core/studio/StudioApprovals.ts
@@ -0,0 +1,144 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: APPROVALS
+ *
+ * Protected acts — production deploys, paid services, production
+ * databases, authentication/security changes, secret management and
+ * LÉLU CORE changes — stop here and wait for a person.
+ *
+ * The separation is structural, exactly as it is for
+ * EngineeringAuthorization: LÉLU's tools can REQUEST an approval; only a
+ * deliberate user action in the Studio panel can GRANT one. The queue is
+ * deliberately NOT persisted: a reload must never restore an authority
+ * nobody has just given. Approvals are scoped to one project and one
+ * action, and they expire.
+ * ==========================================================
+ */
+
+import type { ProtectedAction, StudioApproval } from "./StudioProjectTypes";
+import { isProtectedAction } from "./StudioProjectTypes";
+
+export const APPROVAL_TTL_MS = 15 * 60 * 1000;
+
+function makeId(): string {
+  return `approval-${crypto.randomUUID().slice(0, 8)}`;
+}
+
+export const PROTECTED_ACTION_LABELS: Record<ProtectedAction, string> = {
+  "production-deploy": "Publish to production",
+  "paid-service": "Activate a paid service",
+  "production-database": "Modify a production database",
+  "auth-security": "Change authentication or security",
+  "secret-management": "Create, rotate or expose a secret",
+  "lelu-core": "Change protected LÉLU CORE",
+};
+
+export default class StudioApprovals {
+  private static instance: StudioApprovals | null = null;
+  private queue: StudioApproval[] = [];
+
+  public static getInstance(): StudioApprovals {
+    if (!StudioApprovals.instance) StudioApprovals.instance = new StudioApprovals();
+    return StudioApprovals.instance;
+  }
+
+  public static resetForTests(): StudioApprovals {
+    StudioApprovals.instance = new StudioApprovals();
+    return StudioApprovals.instance;
+  }
+
+  private expire(): void {
+    const now = Date.now();
+    this.queue = this.queue.map((approval) =>
+      approval.status === "pending" && now > approval.expiresAt
+        ? { ...approval, status: "expired" as const }
+        : approval,
+    );
+  }
+
+  /** Called by a tool, on LÉLU's behalf. Never grants anything. */
+  public request(input: {
+    projectId: string;
+    action: string;
+    reason: string;
+    scope?: string[];
+  }): StudioApproval {
+    if (!isProtectedAction(input.action)) {
+      throw new Error(
+        `"${input.action}" is not a protected action; work that needs no approval should proceed directly.`,
+      );
+    }
+    const reason = input.reason.trim();
+    if (reason.length < 12) {
+      throw new Error(
+        "An approval request must say what would happen and why — at least a sentence, not a label.",
+      );
+    }
+    const now = Date.now();
+    const approval: StudioApproval = {
+      id: makeId(),
+      projectId: input.projectId,
+      action: input.action,
+      reason,
+      requestedAt: now,
+      expiresAt: now + APPROVAL_TTL_MS,
+      status: "pending",
+      decidedAt: null,
+      decidedBy: null,
+      scope: [...(input.scope ?? [])],
+    };
+    this.queue = [...this.queue, approval].slice(-30);
+    return approval;
+  }
+
+  public list(projectId?: string): StudioApproval[] {
+    this.expire();
+    return this.queue.filter((approval) => !projectId || approval.projectId === projectId);
+  }
+
+  public get(id: string): StudioApproval | null {
+    this.expire();
+    return this.queue.find((approval) => approval.id === id) ?? null;
+  }
+
+  /**
+   * A PERSON's decision. The Studio panel calls this from a click handler;
+   * no tool executor calls it, so a model cannot approve its own request.
+   */
+  public decide(id: string, decision: "approved" | "denied", decidedBy: string): StudioApproval {
+    this.expire();
+    const approval = this.get(id);
+    if (!approval) throw new Error(`No approval "${id}".`);
+    if (!decidedBy.trim()) {
+      throw new Error("An approval decision needs the identity of the person making it.");
+    }
+    if (approval.status !== "pending") {
+      throw new Error(`Approval "${id}" is already ${approval.status}.`);
+    }
+    const next: StudioApproval = {
+      ...approval,
+      status: decision,
+      decidedAt: Date.now(),
+      decidedBy: decidedBy.trim(),
+    };
+    this.queue = this.queue.map((item) => (item.id === id ? next : item));
+    return next;
+  }
+
+  /** The live authorization for a project + action, or null. */
+  public authorizationFor(projectId: string, action: ProtectedAction): StudioApproval | null {
+    this.expire();
+    const approval = this.queue.find(
+      (item) =>
+        item.projectId === projectId &&
+        item.action === action &&
+        item.status === "approved" &&
+        Date.now() < item.expiresAt,
+    );
+    return approval ?? null;
+  }
+
+  public pending(projectId: string): StudioApproval[] {
+    return this.list(projectId).filter((approval) => approval.status === "pending");
+  }
+}
diff --git a/src/core/studio/StudioAssets.ts b/src/core/studio/StudioAssets.ts
new file mode 100644
index 0000000..6bb9397
--- /dev/null
+++ b/src/core/studio/StudioAssets.ts
@@ -0,0 +1,126 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: ASSETS, FROM SESSION 3B
+ *
+ * The Studio owns no asset library. It reads Session 3B's forge ledger
+ * (leluverse/forge/ledger.json) and its character references, and turns
+ * them into the references a game project can consume.
+ *
+ * The ledger is the truth: a Meshy job in `awaiting_approval` is reported
+ * as awaiting approval, never as a model on disk. That matters because a
+ * game that says "uses the character GLB" while no GLB exists is a false
+ * claim about the build.
+ * ==========================================================
+ */
+
+import type { StudioAssetRef } from "./StudioProjectTypes.js";
+
+interface ForgeJob {
+  id?: string;
+  asset?: string;
+  workflow?: string;
+  purpose?: string;
+  state?: string;
+  params?: Record<string, unknown>;
+  dependsOn?: string[];
+}
+
+export interface ForgeLedger {
+  jobs?: ForgeJob[];
+}
+
+/** Expected formats a job declares, so a run can look for the real file. */
+function declaredFormats(job: ForgeJob): string[] {
+  const formats = job.params?.target_formats;
+  if (Array.isArray(formats)) return formats.map(String);
+  if (job.workflow === "rigging") return ["glb", "fbx"];
+  return ["glb"];
+}
+
+/**
+ * Build asset references from the ledger, given the files that actually
+ * exist under the character directory (relative paths, forward slashes).
+ */
+export function assetRefsFromLedger(
+  ledger: ForgeLedger,
+  existingFiles: readonly string[] = [],
+): StudioAssetRef[] {
+  const refs: StudioAssetRef[] = [];
+
+  for (const job of ledger.jobs ?? []) {
+    if (!job.id) continue;
+    const formats = declaredFormats(job);
+    // A format existing somewhere is not this job's output. The file must be
+    // attributable to the job, or two completed jobs would both claim one
+    // GLB — measured by a failing test on the first version of this.
+    const produced = formats.filter((format) =>
+      existingFiles.some(
+        (file) => file.toLowerCase().endsWith(`.${format}`) && file.includes(job.id as string),
+      ),
+    );
+    const isRig = job.workflow === "rigging";
+    refs.push({
+      id: job.id,
+      source: "meshy",
+      path: job.asset ?? "",
+      kind: isRig ? "animation" : "model",
+      state: job.state === "completed" && produced.length > 0 ? "present" : "awaiting_approval",
+      jobId: job.id,
+      note:
+        job.state === "awaiting_approval"
+          ? `${job.purpose ?? job.workflow ?? "3D job"} — planned, not run: no ${formats.join("/")} file exists yet.`
+          : job.state === "completed" && produced.length === 0
+            ? "The job reports completed but no declared output file is present."
+            : job.purpose,
+    });
+  }
+
+  /* Reference images are real files the character pipeline already owns. */
+  const references = existingFiles.filter((file) => /\.(png|jpe?g|webp)$/i.test(file));
+  if (references.length > 0) {
+    refs.push({
+      id: "lelu-character-references",
+      source: "reference",
+      path: "leluverse/assets/characters/lelu_character/references",
+      kind: "texture",
+      state: "present",
+      note: `${references.length} reference image(s) available for textures and concept boards.`,
+    });
+  }
+
+  return refs;
+}
+
+/** What a generated game may honestly claim to use right now. */
+export function describeAssets(refs: readonly StudioAssetRef[]): string {
+  if (refs.length === 0) return "No asset references are wired for this project.";
+  const present = refs.filter((ref) => ref.state === "present");
+  const pending = refs.filter((ref) => ref.state !== "present");
+  const parts = [
+    `${present.length} usable asset reference(s): ${present.map((ref) => ref.id).join(", ") || "none"}.`,
+  ];
+  if (pending.length > 0) {
+    parts.push(
+      `${pending.length} awaiting the pipeline: ${pending.map((ref) => ref.id).join(", ")}. ` +
+        "These are NOT in the build — no model file exists for them yet.",
+    );
+  }
+  return parts.join(" ");
+}
+
+/**
+ * A game built before the Meshy jobs are approved must not claim a rigged
+ * character. This returns the honest substitution it makes instead.
+ */
+export function fallbackCharacterAsset(): StudioAssetRef {
+  return {
+    id: "studio-character-fallback",
+    source: "procedural",
+    path: "assets/character-card.png",
+    kind: "texture",
+    state: "present",
+    note:
+      "Rigged GLB not available yet: the playable figure is procedural geometry using Session 3B's " +
+      "character reference as its card texture.",
+  };
+}
diff --git a/src/core/studio/StudioEngines.ts b/src/core/studio/StudioEngines.ts
new file mode 100644
index 0000000..743b8a1
--- /dev/null
+++ b/src/core/studio/StudioEngines.ts
@@ -0,0 +1,263 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: ENGINE EVALUATION
+ *
+ * "Which engine?" is answered from the project's real requirements and
+ * this runtime's real capabilities — not from a preference. Unity and
+ * Unreal are not silently pretended to be usable: their editors,
+ * licences and build toolchains are not present in this environment, so
+ * they are reported as unavailable with the exact reason. Godot is
+ * available only when a real `godot` binary is found.
+ *
+ * Web technologies are always available here, because the browser is the
+ * runtime that actually exists: three.js for 3D, canvas/WebGL for 2D,
+ * shipped as static files and previewed in a Cosmos window.
+ * ==========================================================
+ */
+
+import type {
+  EngineCapability,
+  EngineRecommendation,
+  StudioEngineId,
+  StudioRequirements,
+} from "./StudioProjectTypes";
+
+export interface EngineProbe {
+  /** `godot --version` succeeded on the studio runtime. */
+  godotInstalled: boolean;
+  /** `unity` editor binary found (never true in a headless runtime). */
+  unityInstalled: boolean;
+  /** UnrealEditor binary found (never true in a headless runtime). */
+  unrealInstalled: boolean;
+}
+
+export const DEFAULT_ENGINE_PROBE: EngineProbe = {
+  godotInstalled: false,
+  unityInstalled: false,
+  unrealInstalled: false,
+};
+
+/** Capabilities measured against the environment, in one place. */
+export function engineCapabilities(probe: EngineProbe = DEFAULT_ENGINE_PROBE): EngineCapability[] {
+  return [
+    {
+      id: "web",
+      label: "Web technologies (three.js / WebGL)",
+      dimensions: ["2d", "3d"],
+      targets: ["web", "pwa", "mobile", "desktop"],
+      status: "available",
+      requires: ["a browser runtime", "static build output"],
+      detail:
+        "Always available here: the studio builds static output and previews it inside a Cosmos window. " +
+        "Mobile and desktop are reached through the existing Capacitor shell and PWA install, not a game console toolchain.",
+      preview: "in-browser",
+    },
+    {
+      id: "godot",
+      label: "Godot 4",
+      dimensions: ["2d", "3d"],
+      targets: ["mobile", "desktop", "web"],
+      status: probe.godotInstalled ? "available" : "not-installed",
+      requires: ["a godot editor binary on the runtime", "export templates for each target"],
+      detail: probe.godotInstalled
+        ? "A godot binary is present and can export the project."
+        : "Godot is not installed on this runtime, so nothing could be built or previewed here. " +
+          "The project scaffold and asset contract are still valid for a runtime that has the editor.",
+      preview: "editor",
+    },
+    {
+      id: "unity",
+      label: "Unity",
+      dimensions: ["2d", "3d"],
+      targets: ["mobile", "desktop", "web"],
+      status: probe.unityInstalled ? "available" : "not-installed",
+      requires: ["Unity Editor + licence", "Unity Hub", "per-platform build modules"],
+      detail:
+        "Unity's editor is not installed and cannot be driven headlessly here; it also requires a licensed " +
+        "editor install per machine. Recommending it would produce a project this studio cannot build.",
+      preview: "editor",
+    },
+    {
+      id: "unreal",
+      label: "Unreal Engine 5",
+      dimensions: ["3d"],
+      targets: ["desktop", "mobile"],
+      status: probe.unrealInstalled ? "available" : "not-installed",
+      requires: ["Unreal Editor + licence", "C++ toolchain", "a GPU workstation for baking"],
+      detail:
+        "The Unreal editor and toolchain are not present in this runtime. It is the right fit for photoreal, " +
+        "large-team titles with a workstation budget — not for a headless studio that has to build and preview now.",
+      preview: "editor",
+    },
+  ];
+}
+
+function isNativeTarget(targets: StudioRequirements["targets"]): boolean {
+  return targets.some((target) => target === "desktop" || target === "mobile");
+}
+
+/**
+ * The decision, with its reasoning attached. Every rejected engine carries
+ * the real reason it was rejected, so the choice can be reviewed rather
+ * than trusted.
+ */
+export function recommendEngine(
+  requirements: StudioRequirements,
+  probe: EngineProbe = DEFAULT_ENGINE_PROBE,
+): EngineRecommendation {
+  const capabilities = engineCapabilities(probe);
+  const byId = (id: StudioEngineId): EngineCapability =>
+    capabilities.find((capability) => capability.id === id) as EngineCapability;
+
+  if (requirements.kind === "website") {
+    const web = byId("web");
+    return {
+      engine: "web",
+      label: web.label,
+      supported: web.status === "available",
+      confidence: "high",
+      stack: "HTML + CSS + modern JavaScript, static build, responsive and accessible",
+      rationale: [
+        "A website needs no game engine: the deliverable is documents, styles and browser JavaScript.",
+        "Static output is buildable and previewable in this runtime without an editor install.",
+        "Forms, navigation, dashboards and APIs are all reachable from the same stack and the existing backend runtime.",
+      ],
+      alternatives: [
+        {
+          engine: "godot",
+          label: "Godot",
+          why: "Only if the site is really a 2D interactive experience with its own render loop.",
+        },
+      ],
+      rejected: ["godot", "unity", "unreal"].map((engine) => {
+        const capability = byId(engine as StudioEngineId);
+        return {
+          engine: capability.id,
+          label: capability.label,
+          reason:
+            engine === "godot"
+              ? "Adds an editor and an export step to a document deliverable, with no benefit to navigation or forms."
+              : `${capability.label} is a game editor; using it for a website adds a build toolchain the runtime does not have.`,
+        };
+      }),
+    };
+  }
+
+  if (requirements.kind === "application") {
+    const web = byId("web");
+    return {
+      engine: "web",
+      label: web.label,
+      supported: web.status === "available",
+      confidence: "high",
+      stack: "Web application + Node HTTP backend, JSON/file persistence, PWA and Capacitor for installed targets",
+      rationale: [
+        "The application has to connect to a real backend; the existing Node/Deno runtime already serves APIs next to the app.",
+        "Progressive web app and installed mobile/desktop builds are supported by the existing Capacitor shell.",
+        "A game engine would not give the forms, routing, API and database integration an application needs.",
+      ],
+      alternatives: [
+        {
+          engine: "godot",
+          label: "Godot",
+          why: "Only for an application whose core is a real-time 2D/3D simulation.",
+        },
+      ],
+      rejected: (["godot", "unity", "unreal"] as StudioEngineId[]).map((engine) => ({
+        engine,
+        label: byId(engine).label,
+        reason:
+          "Wrong tool for a data-and-interface application: no benefit for forms, routing, APIs or persistence, " +
+          "and the editor is not available on this runtime.",
+      })),
+    };
+  }
+
+  /* Games: the decision depends on dimension, targets and realism. */
+  const dimension = requirements.dimension ?? "3d";
+  const native = isNativeTarget(requirements.targets);
+  const photoreal = requirements.photoreal === true;
+  const largeTeam = (requirements.teamSize ?? 1) >= 8;
+  let engine: StudioEngineId = "web";
+  const rationale: string[] = [];
+  const rejected: EngineRecommendation["rejected"] = [];
+
+  if (photoreal && largeTeam && native && requirements.targets.includes("desktop")) {
+    engine = "unreal";
+    rationale.push(
+      "Photoreal rendering, a large team and native desktop delivery are Unreal's own use case.",
+    );
+    rationale.push(
+      "It is the recommendation on requirements, but NOT on this runtime: the editor is absent, so the project " +
+        "cannot be built or previewed here until one is installed.",
+    );
+  } else if (native && (requirements.multiplayer || dimension === "2d" || !requirements.targets.includes("web"))) {
+    engine = "godot";
+    rationale.push(
+      native
+        ? "Native desktop/mobile delivery with a small team is what Godot exports well, and it is free of per-seat editor cost."
+        : "Godot fits the requested runtime.",
+    );
+    rationale.push(
+      requirements.multiplayer
+        ? "Godot's high-level multiplayer API covers the requested multiplayer requirement."
+        : "Godot covers 2D and 3D without a second toolchain.",
+    );
+  } else {
+    engine = "web";
+    rationale.push(
+      dimension === "3d"
+        ? "A 3D game that must run in the browser is built on three.js/WebGL: the same output the Cosmos preview runs."
+        : "A 2D browser game is built on canvas/WebGL with no editor install.",
+    );
+    rationale.push(
+      "Static build output means LÉLU can build, test and preview the game herself in an isolated studio project.",
+    );
+  }
+
+  const chosen = byId(engine);
+  for (const capability of capabilities) {
+    if (capability.id === engine) continue;
+    let reason: string;
+    if (capability.status !== "available") {
+      reason = `${capability.detail}`;
+    } else if (capability.id === "web" && engine !== "web") {
+      reason = "Web output is still produced as a preview/companion channel unless native-only is required.";
+    } else {
+      reason = "Does not match the measured requirements (dimension, targets, team size or realism).";
+    }
+    rejected.push({ engine: capability.id, label: capability.label, reason });
+  }
+
+  return {
+    engine,
+    label: chosen.label,
+    supported: chosen.status === "available",
+    confidence:
+      engine === "web" ? "high" : requirements.teamSize || requirements.photoreal ? "medium" : "low",
+    stack:
+      engine === "web"
+        ? dimension === "3d"
+          ? "three.js + WebGL, static build, keyboard/touch controls, pure-logic test suite"
+          : "Canvas/WebGL 2D, static build, pure-logic test suite"
+        : `${chosen.label} project + export templates; not buildable on this runtime`,
+    rationale,
+    alternatives:
+      engine === "web"
+        ? [
+            {
+              engine: "godot",
+              label: "Godot",
+              why: "Choose it when the game must ship as a native desktop/mobile binary and a Godot editor is installed.",
+            },
+          ]
+        : [
+            {
+              engine: "web",
+              label: "Web technologies",
+              why: "The only engine this runtime can build and preview today; it also gives an instant browser demo.",
+            },
+          ],
+    rejected,
+  };
+}
diff --git a/src/core/studio/StudioIntent.ts b/src/core/studio/StudioIntent.ts
new file mode 100644
index 0000000..f6a6e94
--- /dev/null
+++ b/src/core/studio/StudioIntent.ts
@@ -0,0 +1,80 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: STUDIO INTENT
+ *
+ * The router has to decide one thing before it chooses tools: is this
+ * message about building or changing software, or about something else that
+ * merely uses the word "project"? Getting it wrong in either direction is
+ * costly — a research request sent to the studio scaffolder, or a real build
+ * request sent down the generic project path.
+ *
+ * Two independent signals must agree, and the studio must actually be
+ * offered (`available`). The tests pin the exact cases: a bare noun is not a
+ * build, and a collection of pendant designs is not an application.
+ * ==========================================================
+ */
+
+/** Verbs that ask for a piece of software to be brought into existence. */
+const BUILD_VERB =
+  /\b(create|build|scaffold|generate|develop|code|make|prototype|spin\s+up|whip\s+up)\b/i;
+
+/** Nouns that name software as an artifact, rather than a content project. */
+const SOFTWARE_NOUN =
+  /\b(website|web\s*site|web\s*app|webapp|application|app|game|dashboard|portal|storefront|player|platform|interface|saas|pwa|cli|api|frontend|backend|ui|prototype|3d|three\.?js)\b/i;
+
+/** Verbs that ask for a change to software that already exists. */
+const CHANGE_VERB =
+  /\b(add|fix|change|update|adjust|improve|refactor|extend|remove|rename|tweak|iterate|polish|restyle|redo|debug|preview|test|deploy|ship|split|merge|extract|wire|hook)\b/i;
+
+/**
+ * A definite reference to a thing the person already has: "the Focus
+ * Ledger", "my dashboard". This is what lets a follow-up like "add a status
+ * filter to the Focus Ledger" stay with the studio even though it names no
+ * software noun.
+ */
+const EXISTING_REFERENCE = /\b(the|my|our|this|that)\s+[A-Za-z][\w-]*/i;
+
+/**
+ * Work about a real-world collection, not software. These phrases describe
+ * the subject of a project, so they must not be mistaken for an app.
+ */
+const NON_SOFTWARE =
+  /\b(research|pendant|pendants|jewel(?:le)?ry|collection|collections|designs?|essay|article|curriculum|lesson\s+plan|survey|report\s+on|field\s+notes)\b/i;
+
+function normalise(text: string): string {
+  return String(text ?? "").replace(/\s+/g, " ").trim();
+}
+
+/**
+ * A build request: a build verb and a software noun in the same message,
+ * with no competing non-software subject, and the studio actually offered.
+ */
+export function asksForStudioBuild(text: string, studioAvailable: boolean): boolean {
+  if (!studioAvailable) return false;
+  const message = normalise(text);
+  if (!message) return false;
+  if (!BUILD_VERB.test(message)) return false;
+  if (!SOFTWARE_NOUN.test(message)) return false;
+  // "make the collection larger" is a build verb over a content project.
+  if (NON_SOFTWARE.test(message) && !SOFTWARE_NOUN.test(message.replace(NON_SOFTWARE, " "))) {
+    return false;
+  }
+  return true;
+}
+
+/**
+ * A follow-up change to software already in the studio: a change verb plus
+ * either a software noun or a definite reference to something the person
+ * already has. Still requires the studio to be offered.
+ */
+export function asksForStudioChange(text: string, studioAvailable: boolean): boolean {
+  if (!studioAvailable) return false;
+  const message = normalise(text);
+  if (!message) return false;
+  if (!CHANGE_VERB.test(message)) return false;
+  const namesSoftware = SOFTWARE_NOUN.test(message);
+  const refersToExisting = EXISTING_REFERENCE.test(message);
+  if (!namesSoftware && !refersToExisting) return false;
+  if (NON_SOFTWARE.test(message) && !namesSoftware) return false;
+  return true;
+}
diff --git a/src/core/studio/StudioLibrary.ts b/src/core/studio/StudioLibrary.ts
new file mode 100644
index 0000000..65eac11
--- /dev/null
+++ b/src/core/studio/StudioLibrary.ts
@@ -0,0 +1,346 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: PROJECT LIBRARY
+ *
+ * The persistent library the spec asks for: source, versions, builds,
+ * tests, assets, documentation and deployment records for every project
+ * the studio creates, so LÉLU can reopen and improve one later.
+ *
+ * It stores FACTS the runtime measured. A build record is written from a
+ * real exit code, a version from a real file set. Nothing here invents a
+ * success.
+ *
+ * Storage is pluggable so the library is testable without a browser; the
+ * default is the app's existing KvStore, which is already the one
+ * persistence layer for projects.
+ * ==========================================================
+ */
+
+import KvStore from "../storage/KvStore";
+import { persistedDisplayName, type PersistedStudioProject } from "./StudioPersistence";
+import {
+  studioSlug,
+  type StudioAssetRef,
+  type StudioBuildRecord,
+  type StudioDeployment,
+  type StudioEngineId,
+  type StudioProject,
+  type StudioProjectKind,
+  type StudioTestRecord,
+  type StudioVersion,
+} from "./StudioProjectTypes";
+
+export interface StudioStorePort {
+  get<T>(key: string): T | null;
+  set(key: string, value: unknown): void;
+}
+
+const kvPort: StudioStorePort = {
+  get<T>(key: string): T | null {
+    return KvStore.getInstance().get<T>(key) ?? null;
+  },
+  set(key: string, value: unknown): void {
+    KvStore.getInstance().set(key, value);
+  },
+};
+
+const KEY = "lelu.studio.library.v1";
+const MAX_RECORDS = 20;
+const MAX_PROJECTS = 40;
+
+/** FNV-1a over a sorted file set: the same content gives the same version. */
+export function contentHash(files: Record<string, string>): string {
+  const paths = Object.keys(files).sort();
+  let hash = 0x811c9dc5;
+  for (const path of paths) {
+    const body = `${path}\u0000${files[path]}\u0001`;
+    for (let index = 0; index < body.length; index += 1) {
+      hash ^= body.charCodeAt(index);
+      hash = Math.imul(hash, 0x01000193) >>> 0;
+    }
+  }
+  return hash.toString(16).padStart(8, "0");
+}
+
+export function byteSize(files: Record<string, string>): number {
+  let bytes = 0;
+  for (const [path, content] of Object.entries(files)) {
+    bytes += path.length + content.length;
+  }
+  return bytes;
+}
+
+function id(prefix: string): string {
+  return `${prefix}-${crypto.randomUUID().slice(0, 8)}`;
+}
+
+function trim<T>(records: T[]): T[] {
+  return records.slice(-MAX_RECORDS);
+}
+
+export interface CreateStudioProjectInput {
+  name: string;
+  kind: StudioProjectKind;
+  engine: StudioEngineId;
+  stack: string;
+  root: string;
+  documentation?: string;
+}
+
+export default class StudioLibrary {
+  private static instance: StudioLibrary | null = null;
+  private projects: StudioProject[];
+
+  constructor(private readonly store: StudioStorePort = kvPort) {
+    this.projects = this.load();
+  }
+
+  public static getInstance(): StudioLibrary {
+    if (!StudioLibrary.instance) StudioLibrary.instance = new StudioLibrary();
+    return StudioLibrary.instance;
+  }
+
+  /** Fresh library over an explicit store (tests). */
+  public static resetForTests(store: StudioStorePort = kvPort): StudioLibrary {
+    StudioLibrary.instance = new StudioLibrary(store);
+    return StudioLibrary.instance;
+  }
+
+  private load(): StudioProject[] {
+    const stored = this.store.get<StudioProject[]>(KEY);
+    if (!Array.isArray(stored)) return [];
+    return stored.filter(
+      (project) =>
+        project &&
+        typeof project.id === "string" &&
+        typeof project.slug === "string" &&
+        Array.isArray(project.versions),
+    );
+  }
+
+  private persist(): void {
+    try {
+      this.store.set(KEY, this.projects);
+    } catch {
+      /* a blocked storage must never break the studio */
+    }
+  }
+
+  public list(): StudioProject[] {
+    return [...this.projects].sort((a, b) => b.updatedAt - a.updatedAt);
+  }
+
+  public get(idOrSlug: string): StudioProject | null {
+    return (
+      this.projects.find((project) => project.id === idOrSlug || project.slug === idOrSlug) ?? null
+    );
+  }
+
+  /** Create a project record for a directory the runtime really created. */
+  public create(input: CreateStudioProjectInput): StudioProject {
+    const slug = studioSlug(input.name);
+    if (this.get(slug)) {
+      throw new Error(`A studio project with the slug "${slug}" already exists.`);
+    }
+    const now = Date.now();
+    const project: StudioProject = {
+      id: id("studio"),
+      slug,
+      name: input.name.trim() || slug,
+      kind: input.kind,
+      engine: input.engine,
+      stack: input.stack,
+      root: input.root,
+      createdAt: now,
+      updatedAt: now,
+      versions: [],
+      builds: [],
+      tests: [],
+      assets: [],
+      deployments: [],
+      documentation: input.documentation ?? "",
+      previewUrl: null,
+      lastOpenedAt: now,
+    };
+    this.projects = [project, ...this.projects].slice(0, MAX_PROJECTS);
+    this.persist();
+    return project;
+  }
+
+  public update(idOrSlug: string, patch: Partial<StudioProject>): StudioProject | null {
+    const project = this.get(idOrSlug);
+    if (!project) return null;
+    const next: StudioProject = { ...project, ...patch, updatedAt: Date.now() };
+    this.projects = this.projects.map((item) => (item.id === project.id ? next : item));
+    this.persist();
+    return next;
+  }
+
+  /** Reopen: record that it was opened, keep everything else. */
+  public reopen(idOrSlug: string): StudioProject | null {
+    return this.update(idOrSlug, { lastOpenedAt: Date.now() });
+  }
+
+  public remove(idOrSlug: string): boolean {
+    const project = this.get(idOrSlug);
+    if (!project) return false;
+    this.projects = this.projects.filter((item) => item.id !== project.id);
+    this.persist();
+    return true;
+  }
+
+  /** A snapshot of the real file set, with a comparable content hash. */
+  public recordVersion(
+    idOrSlug: string,
+    files: Record<string, string>,
+    note?: string,
+  ): StudioVersion | null {
+    const project = this.get(idOrSlug);
+    if (!project) return null;
+    const version: StudioVersion = {
+      id: id("ver"),
+      label: `v${project.versions.length + 1}`,
+      createdAt: Date.now(),
+      files: Object.keys(files).length,
+      bytes: byteSize(files),
+      hash: contentHash(files),
+      note,
+    };
+    project.versions = trim([...project.versions, version]);
+    project.updatedAt = Date.now();
+    this.persist();
+    return version;
+  }
+
+  /**
+   * A version the runtime hashed itself (build output), when the whole
+   * file set is not in the client's hands.
+   */
+  public recordVersionManifest(
+    idOrSlug: string,
+    meta: { files: number; bytes: number; hash: string; note?: string },
+  ): StudioVersion | null {
+    const project = this.get(idOrSlug);
+    if (!project) return null;
+    const version: StudioVersion = {
+      id: id("ver"),
+      label: `v${project.versions.length + 1}`,
+      createdAt: Date.now(),
+      files: meta.files,
+      bytes: meta.bytes,
+      hash: meta.hash,
+      note: meta.note,
+    };
+    project.versions = trim([...project.versions, version]);
+    project.updatedAt = Date.now();
+    this.persist();
+    return version;
+  }
+
+  public recordBuild(idOrSlug: string, build: Omit<StudioBuildRecord, "id">): StudioBuildRecord | null {
+    const project = this.get(idOrSlug);
+    if (!project) return null;
+    const record: StudioBuildRecord = { ...build, id: id("build") };
+    project.builds = trim([...project.builds, record]);
+    project.updatedAt = Date.now();
+    this.persist();
+    return record;
+  }
+
+  public recordTest(idOrSlug: string, run: Omit<StudioTestRecord, "id">): StudioTestRecord | null {
+    const project = this.get(idOrSlug);
+    if (!project) return null;
+    const record: StudioTestRecord = { ...run, id: id("test") };
+    project.tests = trim([...project.tests, record]);
+    project.updatedAt = Date.now();
+    this.persist();
+    return record;
+  }
+
+  public recordAssets(idOrSlug: string, assets: StudioAssetRef[]): StudioProject | null {
+    return this.update(idOrSlug, { assets: [...assets] });
+  }
+
+  public recordDeployment(
+    idOrSlug: string,
+    deployment: Omit<StudioDeployment, "id">,
+  ): StudioDeployment | null {
+    const project = this.get(idOrSlug);
+    if (!project) return null;
+    const record: StudioDeployment = { ...deployment, id: id("deploy") };
+    project.deployments = trim([...project.deployments, record]);
+    project.updatedAt = Date.now();
+    this.persist();
+    return record;
+  }
+
+  /**
+   * Adopt projects that exist on disk but are absent from this browser's
+   * library. No build/version/test record is invented: the disk flag is
+   * kept separately and the next real build/test fills the history.
+   */
+  public syncFromDisk(entries: readonly PersistedStudioProject[]): StudioProject[] {
+    const bySlug = new Map(this.projects.map((project) => [project.slug, project]));
+    let changed = false;
+    for (const entry of entries) {
+      if (bySlug.has(entry.slug)) continue;
+      const now = Date.now();
+      const project: StudioProject = {
+        id: `studio-disk-${entry.slug}`,
+        slug: entry.slug,
+        name: persistedDisplayName(entry.slug),
+        kind: "application",
+        engine: "web",
+        stack: "persisted on disk",
+        root: `.lelu-studio/${entry.slug}`,
+        createdAt: entry.updatedAt,
+        updatedAt: entry.updatedAt,
+        versions: [],
+        builds: [],
+        tests: [],
+        assets: [],
+        deployments: [],
+        documentation: `Found on disk at .lelu-studio/${entry.slug}. Build and test history is recorded the next time they run.`,
+        previewUrl: null,
+        lastOpenedAt: now,
+        discovered: true,
+        discoveredBuilt: entry.built,
+      };
+      this.projects = [...this.projects, project];
+      bySlug.set(entry.slug, project);
+      changed = true;
+    }
+    if (changed) this.persist();
+    const onDisk = new Set(entries.map((entry) => entry.slug));
+    return this.list().filter((project) => onDisk.has(project.slug));
+  }
+
+  /** A factual description for LÉLU's own context. */
+  public describe(idOrSlug: string): string {
+    const project = this.get(idOrSlug);
+    if (!project) return `No studio project named "${idOrSlug}".`;
+    const latestBuild = project.builds.at(-1);
+    const latestTest = project.tests.at(-1);
+    const parts = [
+      `${project.name} (${project.kind}, ${project.engine}) at ${project.root}.`,
+      `${project.versions.length} version(s), ${project.assets.length} asset reference(s).`,
+    ];
+    if (latestBuild) {
+      parts.push(
+        `Last build exited ${latestBuild.exitCode} (${latestBuild.ok ? "passed" : "FAILED"})` +
+          `${latestBuild.artifact ? `, output ${latestBuild.artifact}` : ""}.`,
+      );
+    } else {
+      parts.push("No build has been run.");
+    }
+    if (latestTest) {
+      parts.push(
+        `Last tests: ${latestTest.passed} passed, ${latestTest.failed} failed (exit ${latestTest.exitCode}).`,
+      );
+    }
+    if (project.previewUrl) parts.push(`Preview: ${project.previewUrl}.`);
+    const deployments = project.deployments.at(-1);
+    if (deployments) parts.push(`Last deployment: ${deployments.environment} ${deployments.status}.`);
+    return parts.join(" ");
+  }
+}
diff --git a/src/core/studio/StudioMemory.ts b/src/core/studio/StudioMemory.ts
new file mode 100644
index 0000000..0dda3ce
--- /dev/null
+++ b/src/core/studio/StudioMemory.ts
@@ -0,0 +1,136 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3D: GROUNDED STUDIO MEMORY
+ *
+ * What LÉLU remembers about engineering is not a transcript she
+ * writes about herself. It is a read model over records the studio
+ * already persists from measured events:
+ *
+ *   • StudioLibrary  — objectives, versions, real build/test exit codes
+ *   • StudioPipeline — which stage passed, with what evidence
+ *   • StudioApprovals — what is waiting on a person, and until when
+ *
+ * Every line this module returns can be traced to one of those
+ * records. Nothing is inferred, and nothing new is stored: a second
+ * memory of the same work would be a second thing to disagree.
+ * ==========================================================
+ */
+
+import StudioApprovals from "./StudioApprovals";
+import StudioLibrary from "./StudioLibrary";
+import StudioPipeline from "./StudioPipeline";
+import { STUDIO_PHASE_LABELS, STUDIO_PHASES, type StudioProject } from "./StudioProjectTypes";
+
+/** The first useful line of a failed process, not the whole log. */
+function failureLine(project: StudioProject): string | null {
+  const failed = [...project.builds].reverse().find((build) => !build.ok);
+  if (!failed) return null;
+  const line =
+    failed.output
+      .split("\n")
+      .map((entry) => entry.trim())
+      .find((entry) => /error|failed|cannot|not found|exception/i.test(entry)) ??
+    failed.output.split("\n").map((entry) => entry.trim()).find(Boolean) ??
+    "no output was produced";
+  return `build exit ${failed.exitCode}: ${line.slice(0, 200)}`;
+}
+
+function lastGoodBuild(project: StudioProject): string | null {
+  const build = [...project.builds].reverse().find((record) => record.ok);
+  if (!build) return null;
+  return `${build.bytes} B in ${build.durationMs} ms`;
+}
+
+function projectLine(project: StudioProject, pipeline: StudioPipeline, approvals: StudioApprovals): string {
+  const state = pipeline.state(project.id);
+  const completed = pipeline.completed(project.id);
+  const next = pipeline.next(project.id);
+  const pending = approvals.pending(project.id);
+  const failedTest = [...project.tests].reverse().find((test) => !test.ok);
+
+  const objective =
+    project.documentation.trim().split("\n")[0]?.slice(0, 220) || "No objective recorded yet.";
+
+  const parts = [
+    `- ${project.name} [${project.slug}] — ${project.kind} on ${project.engine}.`,
+    `  objective: ${objective}`,
+    `  progress: ${completed.length}/${STUDIO_PHASES.length} stages` +
+      (completed.length
+        ? ` (${completed.map((phase) => STUDIO_PHASE_LABELS[phase]).join(", ")})`
+        : " — no stage has passed yet") +
+      `; next: ${STUDIO_PHASE_LABELS[next] ?? next}.`,
+  ];
+
+  if (project.versions.length > 0) {
+    const version = project.versions.at(-1)!;
+    parts.push(`  current version: ${version.label} — ${version.files} files, ${version.bytes} B.`);
+  }
+  if (failedTest) {
+    parts.push(`  last failing test run: exit ${failedTest.exitCode}, ${failedTest.failed} failed.`);
+  }
+  if (project.tests.length > 0) {
+    const test = project.tests.at(-1)!;
+    parts.push(`  last test run: ${test.passed} passed, ${test.failed} failed (exit ${test.exitCode}).`);
+  }
+  const failure = failureLine(project);
+  if (failure) parts.push(`  last build failure: ${failure}`);
+  const good = lastGoodBuild(project);
+  if (good) parts.push(`  last successful build: ${good}.`);
+  if (project.previewUrl) parts.push(`  live preview: ${project.previewUrl}`);
+  if (pending.length > 0) {
+    parts.push(
+      `  WAITING ON A PERSON: ${pending
+        .map((approval) => `${approval.action} (${approval.id}, ${Math.max(0, Math.round((approval.expiresAt - Date.now()) / 60000))} min left)`)
+        .join("; ")}.`,
+    );
+  }
+  if (state.blockedBy) {
+    parts.push(`  workflow is blocked on ${state.blockedBy}; LÉLU cannot grant it.`);
+  }
+  if (project.deployments.length > 0) {
+    const deployment = project.deployments.at(-1)!;
+    parts.push(
+      `  last deployment: ${deployment.environment} ${deployment.status} at ${deployment.target || "no target"}.`,
+    );
+  }
+  return parts.join("\n");
+}
+
+/**
+ * A compact, grounded engineering state for the model's context.
+ * Read-only: assembling context never builds, tests or deploys anything.
+ */
+export function describeStudioWork(limit = 3): string {
+  try {
+    const library = StudioLibrary.getInstance();
+    const pipeline = StudioPipeline.getInstance();
+    const approvals = StudioApprovals.getInstance();
+    const projects = library.list().slice(0, limit);
+
+    if (projects.length === 0) {
+      return "No studio project exists yet. Nothing has been built in the studio.";
+    }
+
+    return projects.map((project) => projectLine(project, pipeline, approvals)).join("\n");
+  } catch {
+    return "Studio state is unavailable in this runtime.";
+  }
+}
+
+/** The pending approvals across every project, from the live queue. */
+export function pendingStudioApprovals(): string {
+  try {
+    const pending = StudioApprovals.getInstance()
+      .list()
+      .filter((approval) => approval.status === "pending");
+    if (pending.length === 0) return "No studio approval is waiting on a person.";
+    return pending
+      .map(
+        (approval) =>
+          `- ${approval.action} for ${approval.projectId}: ${approval.reason} (${approval.id})`,
+      )
+      .join("\n");
+  } catch {
+    return "Studio approvals are unavailable in this runtime.";
+  }
+}
diff --git a/src/core/studio/StudioPersistence.ts b/src/core/studio/StudioPersistence.ts
new file mode 100644
index 0000000..3ab0195
--- /dev/null
+++ b/src/core/studio/StudioPersistence.ts
@@ -0,0 +1,70 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: STUDIO PERSISTENCE
+ *
+ * The disk is the authority for which studio projects exist. The browser
+ * library is only a cache of measured history (versions, builds, tests), so
+ * a project created in another browser or an earlier session must still be
+ * discoverable here.
+ *
+ * This module owns that one question: "what really exists on disk right
+ * now?" It returns the runtime's own answer, or `null` when the runtime
+ * cannot be reached — never an invented list. Callers distinguish the two:
+ * `null` means "unknown, keep what we have", `[]` means "the disk is empty".
+ * ==========================================================
+ */
+
+import StudioRuntime from "./StudioRuntime";
+
+/** A project directory the studio runtime found on disk, nothing more. */
+export interface PersistedStudioProject {
+  slug: string;
+  files: number;
+  bytes?: number;
+  updatedAt: number;
+  built: boolean;
+}
+
+/**
+ * Turn a directory slug into the name a person reads: `focus-ledger` becomes
+ * `Focus Ledger`. The library already stored whatever name the user gave a
+ * project it created; this is only for projects discovered on disk, where the
+ * slug is the sole surviving evidence of the name.
+ */
+export function persistedDisplayName(slug: string): string {
+  const words = String(slug ?? "")
+    .split(/[-_.\s]+/)
+    .filter(Boolean);
+  if (words.length === 0) return String(slug ?? "");
+  return words
+    .map((word) =>
+      word.length <= 2 && word === word.toUpperCase()
+        ? word
+        : word.charAt(0).toUpperCase() + word.slice(1),
+    )
+    .join(" ");
+}
+
+/**
+ * Ask the runtime which projects exist on disk. Never throws: an unreachable
+ * runtime is reported as `null` so a caller can keep its recorded history
+ * instead of wiping it because a request failed.
+ */
+export async function fetchPersistedStudioProjects(): Promise<PersistedStudioProject[] | null> {
+  try {
+    const projects = await StudioRuntime.getInstance().projects();
+    if (!Array.isArray(projects)) return null;
+    return projects
+      .filter((project) => project && typeof project.slug === "string" && project.slug.length > 0)
+      .map((project) => ({
+        slug: project.slug,
+        files: Number.isFinite(project.files) ? project.files : 0,
+        bytes: Number.isFinite(project.bytes) ? project.bytes : 0,
+        updatedAt: Number.isFinite(project.updatedAt) ? project.updatedAt : Date.now(),
+        built: project.built === true,
+      }))
+      .sort((a, b) => b.updatedAt - a.updatedAt);
+  } catch {
+    return null;
+  }
+}
diff --git a/src/core/studio/StudioPipeline.ts b/src/core/studio/StudioPipeline.ts
new file mode 100644
index 0000000..a08e666
--- /dev/null
+++ b/src/core/studio/StudioPipeline.ts
@@ -0,0 +1,232 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: DEVELOPMENT PIPELINE
+ *
+ * Understand → Research → Architect → Generate → Build → Integrate →
+ * Test → Debug → Preview → Approve → Deploy → Maintain.
+ *
+ * A stage is recorded only with the evidence that stage is supposed to
+ * produce, and the pipeline refuses to move past a missing stage. That is
+ * the difference between "LÉLU says she tested it" and a record holding
+ * the exit code of the test process.
+ *
+ * Deploy of a production environment additionally requires a live human
+ * approval from StudioApprovals; the pipeline cannot grant one.
+ * ==========================================================
+ */
+
+import KvStore from "../storage/KvStore";
+import StudioApprovals from "./StudioApprovals";
+import {
+  STUDIO_PHASES,
+  type StudioEvidence,
+  type StudioPhase,
+  type StudioPipelineState,
+  type StudioStageRecord,
+} from "./StudioProjectTypes";
+
+export interface PipelineStorePort {
+  get<T>(key: string): T | null;
+  set(key: string, value: unknown): void;
+}
+
+const kvPort: PipelineStorePort = {
+  get<T>(key: string): T | null {
+    return KvStore.getInstance().get<T>(key) ?? null;
+  },
+  set(key: string, value: unknown): void {
+    KvStore.getInstance().set(key, value);
+  },
+};
+
+const KEY = "lelu.studio.pipeline.v1";
+
+/** What each stage must be able to show. */
+export const STAGE_EVIDENCE: Record<StudioPhase, string[]> = {
+  understand: ["requirements"],
+  research: ["findings"],
+  architect: ["decisions"],
+  generate: ["files"],
+  build: ["exitCode"],
+  integrate: ["connections"],
+  test: ["exitCode"],
+  debug: ["outcome"],
+  approve: ["approvalId"],
+  preview: ["url"],
+  deploy: ["deploymentId"],
+  maintain: ["plan"],
+};
+
+export type AdvanceResult =
+  | { ok: true; stage: StudioStageRecord; state: StudioPipelineState }
+  | { ok: false; error: string; state: StudioPipelineState };
+
+function emptyState(projectId: string): StudioPipelineState {
+  return { projectId, stages: [], blockedBy: null, updatedAt: Date.now() };
+}
+
+export default class StudioPipeline {
+  private static instance: StudioPipeline | null = null;
+  private states: Record<string, StudioPipelineState>;
+
+  constructor(
+    private readonly store: PipelineStorePort = kvPort,
+    private readonly approvals: StudioApprovals = StudioApprovals.getInstance(),
+  ) {
+    const stored = this.store.get<Record<string, StudioPipelineState>>(KEY);
+    this.states = stored && typeof stored === "object" ? stored : {};
+  }
+
+  public static getInstance(): StudioPipeline {
+    if (!StudioPipeline.instance) StudioPipeline.instance = new StudioPipeline();
+    return StudioPipeline.instance;
+  }
+
+  public static resetForTests(store: PipelineStorePort = kvPort): StudioPipeline {
+    StudioPipeline.instance = new StudioPipeline(store, StudioApprovals.resetForTests());
+    return StudioPipeline.instance;
+  }
+
+  private persist(): void {
+    try {
+      this.store.set(KEY, this.states);
+    } catch {
+      /* best effort, same as every other store here */
+    }
+  }
+
+  public state(projectId: string): StudioPipelineState {
+    return this.states[projectId] ?? emptyState(projectId);
+  }
+
+  /** The latest record for a phase, or null. */
+  public latest(projectId: string, phase: StudioPhase): StudioStageRecord | null {
+    const stages = this.state(projectId).stages.filter((stage) => stage.phase === phase);
+    return stages.at(-1) ?? null;
+  }
+
+  public completed(projectId: string): StudioPhase[] {
+    const done = new Set<StudioPhase>();
+    for (const stage of this.state(projectId).stages) {
+      if (stage.ok) done.add(stage.phase);
+    }
+    return STUDIO_PHASES.filter((phase) => done.has(phase));
+  }
+
+  /**
+   * Record a stage. Evidence must be real and complete for the stage, and
+   * the preceding stage must have passed — except Debug, which exists
+   * precisely to loop back from a failed build or test.
+   */
+  public advance(input: {
+    projectId: string;
+    phase: StudioPhase;
+    evidence: StudioEvidence;
+    note?: string;
+    ok?: boolean;
+  }): AdvanceResult {
+    const state = this.state(input.projectId);
+    const required = STAGE_EVIDENCE[input.phase];
+    const missing = required.filter((key) => {
+      const value = input.evidence[key];
+      return value === undefined || value === null || value === "";
+    });
+    if (missing.length > 0) {
+      return {
+        ok: false,
+        error: `${input.phase} needs real evidence: ${missing.join(", ")}.`,
+        state,
+      };
+    }
+
+    const index = STUDIO_PHASES.indexOf(input.phase);
+    if (input.phase !== "understand" && input.phase !== "debug") {
+      const previous = STUDIO_PHASES[index - 1];
+      const previousRecord = this.latest(input.projectId, previous);
+      if (!previousRecord || !previousRecord.ok) {
+        return {
+          ok: false,
+          error:
+            `${input.phase} cannot be recorded before ${previous} has passed. ` +
+            `Complete ${previous} first.`,
+          state,
+        };
+      }
+    }
+
+    if (input.phase === "deploy") {
+      const environment = String(input.evidence.environment ?? "preview");
+      const action = environment === "production" ? "production-deploy" : null;
+      if (action && !this.approvals.authorizationFor(input.projectId, action)) {
+        const blocked: StudioPipelineState = {
+          ...state,
+          blockedBy: "production-deploy",
+          updatedAt: Date.now(),
+        };
+        this.states = { ...this.states, [input.projectId]: blocked };
+        this.persist();
+        return {
+          ok: false,
+          error:
+            "A production deployment needs a live human approval. Ask for one; LÉLU cannot grant it.",
+          state: blocked,
+        };
+      }
+    }
+
+    const stage: StudioStageRecord = {
+      phase: input.phase,
+      at: Date.now(),
+      ok: input.ok !== false,
+      evidence: { ...input.evidence },
+      note: input.note,
+    };
+    const next: StudioPipelineState = {
+      ...state,
+      stages: [...state.stages, stage].slice(-80),
+      blockedBy: null,
+      updatedAt: Date.now(),
+    };
+    this.states = { ...this.states, [input.projectId]: next };
+    this.persist();
+    return { ok: true, stage, state: next };
+  }
+
+  /** Request a protected action; the approval decision belongs to a person. */
+  public requestProtected(
+    projectId: string,
+    action: string,
+    reason: string,
+    scope: string[] = [],
+  ) {
+    const approval = this.approvals.request({ projectId, action, reason, scope });
+    this.states = {
+      ...this.states,
+      [projectId]: { ...this.state(projectId), blockedBy: approval.action, updatedAt: Date.now() },
+    };
+    this.persist();
+    return approval;
+  }
+
+  /** The next stage that can be attempted, or "maintain" when complete. */
+  public next(projectId: string): StudioPhase {
+    for (const phase of STUDIO_PHASES) {
+      const record = this.latest(projectId, phase);
+      if (!record || !record.ok) return phase;
+    }
+    return "maintain";
+  }
+
+  public describe(projectId: string): string {
+    const state = this.state(projectId);
+    if (state.stages.length === 0) {
+      return `No development workflow has started for ${projectId}. Start at understand.`;
+    }
+    const done = new Set(state.stages.filter((stage) => stage.ok).map((stage) => stage.phase));
+    const progress = STUDIO_PHASES.map((phase) => `${phase}${done.has(phase) ? " ✓" : ""}`).join(" → ");
+    return (
+      `Workflow: ${progress}. Next: ${this.next(projectId)}.` +
+      (state.blockedBy ? ` Blocked on human approval for ${state.blockedBy}.` : "")
+    );
+  }
+}
diff --git a/src/core/studio/StudioProjectTypes.ts b/src/core/studio/StudioProjectTypes.ts
new file mode 100644
index 0000000..41e042d
--- /dev/null
+++ b/src/core/studio/StudioProjectTypes.ts
@@ -0,0 +1,269 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: THE SOFTWARE STUDIO
+ * TYPES
+ *
+ * One vocabulary for websites, applications and games. These types
+ * describe real artifacts only: a project record is written from what
+ * the studio runtime actually returned (a file count, an exit code, a
+ * build directory), never from what a model said it did.
+ *
+ * The Studio does not introduce a second agent system, a second
+ * workspace architecture or a second asset library. Projects live in
+ * Cosmos through the existing WorkspaceEngine and windows; agents are
+ * SHAMAN's; assets are Session 3B's forge ledger.
+ * ==========================================================
+ */
+
+/** What is being built. */
+export type StudioProjectKind = "website" | "application" | "game";
+
+/** A real engine/runtime, not a slide in a comparison table. */
+export type StudioEngineId = "web" | "godot" | "unity" | "unreal";
+
+/** Where the result has to run. */
+export type StudioTarget = "web" | "pwa" | "mobile" | "desktop";
+
+/** The autonomous development workflow, in order. */
+export type StudioPhase =
+  | "understand"
+  | "research"
+  | "architect"
+  | "generate"
+  | "build"
+  | "integrate"
+  | "test"
+  | "debug"
+  | "preview"
+  | "approve"
+  | "deploy"
+  | "maintain";
+
+export const STUDIO_PHASES: readonly StudioPhase[] = [
+  "understand",
+  "research",
+  "architect",
+  "generate",
+  "build",
+  "integrate",
+  "test",
+  "debug",
+  "preview",
+  "approve",
+  "deploy",
+  "maintain",
+];
+
+/** Actions that may never be taken autonomously. */
+export type ProtectedAction =
+  | "production-deploy"
+  | "paid-service"
+  | "production-database"
+  | "auth-security"
+  | "secret-management"
+  | "lelu-core";
+
+export const PROTECTED_ACTIONS: readonly ProtectedAction[] = [
+  "production-deploy",
+  "paid-service",
+  "production-database",
+  "auth-security",
+  "secret-management",
+  "lelu-core",
+];
+
+/** What the project needs. Requirements drive the engine decision. */
+export interface StudioRequirements {
+  kind: StudioProjectKind;
+  /** 2D or 3D. A website has no dimension and leaves this unset. */
+  dimension?: "2d" | "3d";
+  targets: StudioTarget[];
+  multiplayer?: boolean;
+  /** Photoreal rendering and very large worlds. */
+  photoreal?: boolean;
+  /** Number of people who will work in the engine's editor. */
+  teamSize?: number;
+  /** Needs Session 3B: Blender scenes, Meshy meshes, rigs, animations. */
+  assetPipeline?: boolean;
+}
+
+export type EngineStatus = "available" | "not-installed" | "unsupported-host";
+
+export interface EngineCapability {
+  id: StudioEngineId;
+  label: string;
+  dimensions: Array<"2d" | "3d">;
+  targets: StudioTarget[];
+  /** Measured against this runtime, not claimed from marketing pages. */
+  status: EngineStatus;
+  /** What has to be true to use it here. */
+  requires: string[];
+  /** Why it is available or not, in this environment specifically. */
+  detail: string;
+  preview: "in-browser" | "editor" | "none";
+}
+
+export interface EngineRecommendation {
+  engine: StudioEngineId;
+  label: string;
+  /** Whether this runtime can actually build and preview the result. */
+  supported: boolean;
+  confidence: "high" | "medium" | "low";
+  rationale: string[];
+  stack: string;
+  alternatives: Array<{ engine: StudioEngineId; label: string; why: string }>;
+  /** Engines considered and rejected, each with the real reason. */
+  rejected: Array<{ engine: StudioEngineId; label: string; reason: string }>;
+}
+
+export interface StudioVersion {
+  id: string;
+  label: string;
+  createdAt: number;
+  files: number;
+  bytes: number;
+  /** Content hash of the file set, so two versions are comparable. */
+  hash: string;
+  note?: string;
+}
+
+export interface StudioBuildRecord {
+  id: string;
+  at: number;
+  ok: boolean;
+  exitCode: number;
+  durationMs: number;
+  /** Real process output, trimmed by the runtime. */
+  output: string;
+  /** Where the real build output landed, relative to the project. */
+  artifact: string | null;
+  bytes: number;
+}
+
+export interface StudioTestRecord {
+  id: string;
+  at: number;
+  ok: boolean;
+  exitCode: number;
+  passed: number;
+  failed: number;
+  durationMs: number;
+  output: string;
+}
+
+export interface StudioAssetRef {
+  id: string;
+  /** Where the asset comes from. 3B owns meshy and blender. */
+  source: "meshy" | "blender" | "reference" | "procedural" | "three";
+  path: string;
+  kind: "model" | "texture" | "animation" | "scene" | "library";
+  /** The real state: a file that exists, or a job that has not run. */
+  state: "present" | "awaiting_approval" | "missing";
+  jobId?: string;
+  note?: string;
+}
+
+export interface StudioDeployment {
+  id: string;
+  at: number;
+  environment: "preview" | "production";
+  /** Where it was written, or why it was refused. */
+  target: string;
+  status: "prepared" | "published" | "blocked" | "failed";
+  url?: string;
+  approvedBy?: string;
+  note?: string;
+}
+
+export interface StudioProject {
+  id: string;
+  slug: string;
+  name: string;
+  kind: StudioProjectKind;
+  engine: StudioEngineId;
+  stack: string;
+  /** Real directory inside the studio root on the runtime. */
+  root: string;
+  createdAt: number;
+  updatedAt: number;
+  versions: StudioVersion[];
+  builds: StudioBuildRecord[];
+  tests: StudioTestRecord[];
+  assets: StudioAssetRef[];
+  deployments: StudioDeployment[];
+  /** What the project is and how to run it — written from its README. */
+  documentation: string;
+  /** Last preview URL the runtime served, if any. */
+  previewUrl: string | null;
+  /** Last measured upstream health. */
+  lastOpenedAt: number | null;
+  /** True when this record was adopted from a project already on disk. */
+  discovered?: boolean;
+  /** The disk API found a build output; no build record was invented for it. */
+  discoveredBuilt?: boolean;
+}
+
+/** What a phase had to show before it could be recorded. */
+export type StudioEvidence = Record<string, unknown>;
+
+export interface StudioStageRecord {
+  phase: StudioPhase;
+  at: number;
+  ok: boolean;
+  evidence: StudioEvidence;
+  note?: string;
+}
+
+export interface StudioPipelineState {
+  projectId: string;
+  stages: StudioStageRecord[];
+  /** The approval a protected step is waiting on, if any. */
+  blockedBy: string | null;
+  updatedAt: number;
+}
+
+/** A request for a human decision. Created by the model, decided by a person. */
+export interface StudioApproval {
+  id: string;
+  projectId: string;
+  action: ProtectedAction;
+  /** Exactly what would happen, shown to the person deciding. */
+  reason: string;
+  requestedAt: number;
+  expiresAt: number;
+  status: "pending" | "approved" | "denied" | "expired";
+  decidedAt: number | null;
+  decidedBy: string | null;
+  /** Present only when approved: what the person's yes covers. */
+  scope: string[];
+}
+
+export const STUDIO_PHASE_LABELS: Record<StudioPhase, string> = {
+  understand: "Understand",
+  research: "Research",
+  architect: "Architect",
+  generate: "Generate",
+  build: "Build",
+  integrate: "Integrate",
+  test: "Test",
+  debug: "Debug",
+  preview: "Preview",
+  approve: "Approve",
+  deploy: "Deploy",
+  maintain: "Maintain",
+};
+
+export function isProtectedAction(value: string): value is ProtectedAction {
+  return (PROTECTED_ACTIONS as readonly string[]).includes(value);
+}
+
+/** A URL-safe slug that can never escape the studio root. */
+export function studioSlug(input: string): string {
+  const slug = input
+    .trim()
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 48);
+  return slug || "project";
+}
diff --git a/src/core/studio/StudioRuntime.ts b/src/core/studio/StudioRuntime.ts
