+      for (const finding of findings) console.log(`  ${finding.severity === "problem" ? "PROBLEM" : "warning"}  ${finding.look}/${finding.asset}: ${finding.message}`);
+      console.log(`${problems} problems, ${warnings} warnings`);
+      return;
+    }
+    case "crop": {
+      // The board is a blueprint, not the product: cut ONE asset out of it, keep
+      // where it came from, and store the cut as its own reference.
+      const [file, refId, rect] = process.argv.slice(3);
+      if (!file || !refId || !rect) throw new ForgeError("usage: crop <board.png> <refId> <x,y,w,h> [--category=clothing] [--view=…]");
+      const numbers = rect.split(",").map(Number);
+      if (numbers.length !== 4 || numbers.some((n) => !Number.isFinite(n))) throw new ForgeError(`Region must be four fractions x,y,w,h (got "${rect}").`);
+      const [x, y, w, h] = numbers;
+      const flag = (name: string, fallback: string) => new RegExp(`--${name}=([^\\s]+)`).exec(process.argv.join(" "))?.[1] ?? fallback;
+      const category = flag("category", "clothing") as "identity" | "body" | "hair" | "clothing" | "accessories";
+      const view = flag("view", "detail");
+      const sheet = new Uint8Array(readFileSync(file));
+      const source = buildRecords([{ classification: { id: "source", sourceName: path.basename(file), category, view, outfitVariant: "unspecified", intendedUse: "n/a", uses: [] }, file, bytes: sheet }], [])[0];
+      const cropped = cropPng(sheet, { x, y, w, h });
+      const existing = store.references(CHARACTER);
+      if (existing.some((r) => r.id === refId)) throw new ForgeError(`Reference id "${refId}" already exists; crops are never overwritten.`);
+      const [record] = buildRecords(
+        [
+          {
+            classification: {
+              id: refId,
+              sourceName: `${path.basename(file)}#${rect}`,
+              category,
+              view,
+              outfitVariant: "unspecified",
+              intendedUse: `One asset cut out of ${path.basename(file)} (${rect}); a design guide, second to the original photograph.`,
+              uses: ["geometry"],
+              notes: `crop ${rect} of ${path.basename(file)} sha256 ${source.metrics.sha256.slice(0, 16)}`,
+            },
+            file: "",
+            bytes: cropped.png,
+          },
+        ],
+        existing,
+      );
+      record.file = store.relative(store.storeReferenceFile(CHARACTER, refId, ".png", cropped.png));
+      store.saveReferences(CHARACTER, [...existing, record]);
+      console.log(`${record.id}  ${cropped.width}×${cropped.height}  ${record.file}  quality ${record.quality}`);
+      return;
+    }
+    case "plan-inventory": {
+      const file = process.argv[3];
+      if (!file) throw new ForgeError("usage: plan-inventory <inventory.json> [--approve --budget=N]");
+      const inventory = validateInventory(JSON.parse(readFileSync(file, "utf8")));
+      const planned = planInventory(inventory, store.references(CHARACTER));
+      const totals = totalise(planned);
+      let look = "";
+      for (const item of planned) {
+        if (item.look !== look) {
+          look = item.look;
+          console.log(`\n${inventory.looks.find((l) => l.id === look)?.title ?? look}`);
+          console.log("asset                          category     slot             kind        credits");
+        }
+        const name = item.asset.id.padEnd(30);
+        console.log(
+          `${name} ${item.asset.category.padEnd(12)} ${item.asset.slot.padEnd(16)} ${item.kind.padEnd(11)} ${item.blockers.length ? "blocked" : String(item.estimate + item.rigEstimate).padStart(5)}`,
+        );
+        for (const blocker of item.blockers) console.log(`  ! ${blocker}`);
+      }
+      console.log(
+        `\n${planned.length} assets: ${totals.ready} ready, ${totals.blocked} blocked.  ` +
+          `Generation ${totals.generation} credits + rigging ${totals.rigging} = ${totals.generation + totals.rigging} credits.`,
+      );
+      const approve = process.argv.includes("--approve");
+      if (!approve) {
+        console.log("Nothing submitted. Planning is free; --approve --budget=N submits the ready assets.");
+        return;
+      }
+      const budget = Number(/--budget=(\d+)/.exec(process.argv.join(" "))?.[1] ?? 0);
+      const needed = totals.generation + totals.rigging;
+      if (!budget) throw new ForgeError("--approve needs --budget=N: the most credits this run may spend.");
+      if (needed > budget) throw new ForgeError(`This run would cost ${needed} credits, over the ${budget}-credit budget. Nothing submitted.`);
+      if (totals.blocked) {
+        console.log(`${totals.blocked} assets are blocked and will be skipped.`);
+      }
+      for (const item of planned.filter((p) => !p.blockers.length)) {
+        const { job } = await forge.request({
+          character: CHARACTER,
+          kind: item.kind,
+          purpose: `${item.look} — ${item.asset.name}`,
+          body: item.body,
+          approve: true,
+        });
+        console.log(`${item.asset.id.padEnd(30)} ${job.status.padEnd(18)} ${job.id}  ${job.estimatedCredits} cr`);
+      }
+      return;
+    }
+    case "ingest": {
+      const [file, id, ...view] = process.argv.slice(3);
+      if (!file || !id) throw new ForgeError("usage: ingest <image.png|jpg|webp> <refId> <view description…>");
+      const bytes = new Uint8Array(readFileSync(file));
+      const ext = (path.extname(file) || ".png").toLowerCase();
+      const existing = store.references(CHARACTER);
+      const [record] = buildRecords(
+        [
+          {
+            classification: {
+              id,
+              sourceName: path.basename(file),
+              category: "body",
+              view: view.join(" ") || "unspecified",
+              outfitVariant: "unspecified",
+              intendedUse: "Supplied by the user as an approved look.",
+              uses: ["geometry", "texture"],
+            },
+            file: "",
+            bytes,
+          },
+        ],
+        existing,
+      );
+      if (record.duplicateOf) {
+        console.log(`${id} is already stored as ${record.duplicateOf} (identical bytes); nothing written.`);
+        return;
+      }
+      if (existing.some((r) => r.id === id)) throw new ForgeError(`Reference id "${id}" is taken by different content.`);
+      record.file = store.relative(store.storeReferenceFile(CHARACTER, id, ext, bytes));
+      store.saveReferences(CHARACTER, [...existing, record]);
+      console.log(`ingested ${record.id}  ${record.metrics.width}×${record.metrics.height}  ${record.file}  sha256 ${record.metrics.sha256.slice(0, 16)}`);
+      return;
+    }
     default:
       console.log(readFileSync(new URL(import.meta.url), "utf8").split("*/")[0]);
   }
diff --git a/scripts/mobile-layout-audit.mjs b/scripts/mobile-layout-audit.mjs
new file mode 100644
index 0000000..f15781e
--- /dev/null
+++ b/scripts/mobile-layout-audit.mjs
@@ -0,0 +1,82 @@
+/**
+ * Session 3F — two workspaces on a 390x844 phone viewport.
+ * This is browser emulation, not a physical Android device.
+ */
+import { chromium } from "playwright";
+import { mkdirSync, writeFileSync } from "node:fs";
+
+const OUT = "artifacts/session3f";
+mkdirSync(OUT, { recursive: true });
+const result = { viewport: "390x844", errors: [] };
+const browser = await chromium.launch({ args: ["--no-sandbox", "--enable-unsafe-swiftshader", "--use-angle=swiftshader"] });
+const context = await browser.newContext({
+  viewport: { width: 390, height: 844 },
+  deviceScaleFactor: 1,
+  isMobile: true,
+  hasTouch: true,
+});
+await context.addInitScript(() => {
+  try { localStorage.setItem("lelu.workspace", "genesisv2"); } catch {}
+});
+const page = await context.newPage();
+page.on("pageerror", (error) => result.errors.push(String(error).slice(0, 240)));
+
+const boxes = () =>
+  page.locator("[data-lelu-module-window]").evaluateAll((nodes) =>
+    nodes.map((node) => {
+      const rect = node.getBoundingClientRect();
+      return {
+        id: node.getAttribute("data-lelu-module-window"),
+        presentation: node.getAttribute("data-lelu-module-presentation"),
+        x: Math.round(rect.x),
+        y: Math.round(rect.y),
+        w: Math.round(rect.width),
+        h: Math.round(rect.height),
+      };
+    }),
+  );
+
+const openInline = (id) =>
+  page.evaluate((moduleId) => {
+    window.dispatchEvent(
+      new CustomEvent("genesis-module-presentation", { detail: { id: moduleId, presentation: "inline" } }),
+    );
+  }, id);
+
+try {
+  await page.goto("http://127.0.0.1:3004/", { waitUntil: "domcontentloaded", timeout: 30_000 });
+  const gate = page.locator("[data-lelu-signin-gate]");
+  await gate.waitFor({ state: "visible", timeout: 15_000 }).catch(() => {});
+  if (await gate.count()) {
+    const skip = gate.getByRole("button", { name: /^Continue/ });
+    if (await skip.count()) {
+      const box = await skip.first().boundingBox();
+      if (box) await page.mouse.click(box.x + box.width / 2, box.y + box.height / 2);
+    }
+    await page.waitForTimeout(700);
+  }
+  await openInline("studio");
+  await page.waitForTimeout(700);
+  await openInline("browser");
+  await page.waitForTimeout(1000);
+  result.windows = await boxes();
+  result.overlap = result.windows.some((a, index) =>
+    result.windows.some(
+      (b, other) =>
+        index < other &&
+        a.x < b.x + b.w &&
+        b.x < a.x + a.w &&
+        a.y < b.y + b.h &&
+        b.y < a.y + a.h,
+    ),
+  );
+  result.chatVisible = await page.locator("[data-lelu-chat-window]").isVisible().catch(() => false);
+  result.composerVisible = await page.locator("[data-lelu-chat-window] textarea").isVisible().catch(() => false);
+  await page.screenshot({ path: `${OUT}/mobile-two-windows.png` });
+} catch (error) {
+  result.failure = error instanceof Error ? error.message : String(error);
+} finally {
+  writeFileSync(`${OUT}/mobile-layout-audit.json`, JSON.stringify(result, null, 2));
+  console.log(JSON.stringify(result, null, 2));
+  await browser.close();
+}
diff --git a/scripts/setup-blender-headless.sh b/scripts/setup-blender-headless.sh
new file mode 100755
index 0000000..12f2de5
--- /dev/null
+++ b/scripts/setup-blender-headless.sh
@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+# ==========================================================
+# LÉLU 3D FORGE — headless Blender, without root
+#
+# The Forge stages (postprocess, headswap, faceshapes, export)
+# shell out to Blender. On a host where it is not installed and
+# root is unavailable, the official portable tarball works — but
+# its binary still needs a few system shared libraries
+# (libSM, libICE, libXrender …) that a bare container lacks.
+#
+# This installs both into one prefix and prints the two
+# environment variables the server needs.
+#
+#   scripts/setup-blender-headless.sh [prefix] [version]
+#   scripts/setup-blender-headless.sh /opt/lelu/blender 5.2.3
+#
+# Then, for the server process:
+#   LELU_BLENDER_BIN=<prefix>/blender-<version>-linux-x64/blender
+#   LD_LIBRARY_PATH=<prefix>/libs/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH
+#
+# Verified on Ubuntu 24.04 x86_64 (glibc 2.39) with Blender
+# 5.2.3 LTS: `blender --background --version`, a Cycles CPU
+# render, and GLB/OBJ/STL/FBX/.blend exports all succeed.
+# ==========================================================
+set -euo pipefail
+
+PREFIX="${1:-$HOME/.local/share/lelu-blender}"
+VERSION="${2:-5.2.3}"
+BASE="https://download.blender.org/release/Blender${VERSION%.*}"
+TARBALL="blender-${VERSION}-linux-x64.tar.xz"
+BLENDER_DIR="${PREFIX}/blender-${VERSION}-linux-x64"
+
+mkdir -p "$PREFIX/lists/partial" "$PREFIX/etc" "$PREFIX/cache/archives/partial" "$PREFIX/libs"
+
+echo "==> Blender ${VERSION} → ${BLENDER_DIR}"
+if [ ! -x "${BLENDER_DIR}/blender" ]; then
+  curl -fL --retry 3 --max-time 1800 -o "${PREFIX}/${TARBALL}" "${BASE}/${TARBALL}"
+  tar -xJf "${PREFIX}/${TARBALL}" -C "$PREFIX"
+  rm -f "${PREFIX}/${TARBALL}"
+fi
+
+echo "==> shared libraries the tarball does not bundle"
+if [ ! -f "$PREFIX/etc/sources.list" ]; then
+  cat > "$PREFIX/etc/sources.list" <<'SOURCES'
+deb http://archive.ubuntu.com/ubuntu noble main universe
+deb http://archive.ubuntu.com/ubuntu noble-updates main universe
+SOURCES
+fi
+
+APT="apt-get -o Dir::State::lists=${PREFIX}/lists -o Dir::Etc::sourcelist=${PREFIX}/etc/sources.list -o Dir::Etc::sourceparts=/dev/null -o Dir::Cache=${PREFIX}/cache -o Debug::NoLocking=1"
+if [ -z "$(ls "${PREFIX}"/lists/*Packages* 2>/dev/null || true)" ]; then
+  $APT update
+fi
+( cd "${PREFIX}/cache" && $APT download libsm6 libice6 libxrender1 libxfixes3 libxi6 libxxf86vm1 \
+    libxkbcommon0 libegl1 libgl1 libglx0 libglvnd0 libopengl0 libgomp1 libxau6 libxdmcp6 libbsd0 libmd0 ) || true
+for deb in "${PREFIX}"/cache/*.deb; do dpkg-deb -x "$deb" "${PREFIX}/libs"; done
+
+echo "==> verifying"
+LIBDIR="${PREFIX}/libs/usr/lib/x86_64-linux-gnu"
+LD_LIBRARY_PATH="${LIBDIR}:${LD_LIBRARY_PATH:-}" "${BLENDER_DIR}/blender" --background --version | head -1
+
+cat <<EOF
+
+Blender is executable. Give the server these:
+
+  LELU_BLENDER_BIN=${BLENDER_DIR}/blender
+  LD_LIBRARY_PATH=${LIBDIR}:\$LD_LIBRARY_PATH
+
+Then check it end to end (no credits are spent):
+
+  curl -s -X POST -H 'Content-Type: application/json' \\
+    -d '{"formats":["blend","glb","obj","stl","fbx"],"targetTris":30000}' \\
+    http://localhost:3000/api/forge/jobs/<succeeded-job-id>/export
+
+A 503 "Blender is not available on this server" means the binary or its
+libraries are not visible to the server process, not that the stage is missing.
+EOF
diff --git a/scripts/setup-browser-libs.sh b/scripts/setup-browser-libs.sh
new file mode 100644
index 0000000..75b97d7
--- /dev/null
+++ b/scripts/setup-browser-libs.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# ---------------------------------------------------------------
+# Playwright Chromium on this image is missing its shared library
+# set (libnspr4, libnss3, the atk/atspi/alsa/X11 libs), and there
+# is no sudo. A plain `npx playwright install-deps` cannot run, so
+# resolve the debs from the distro's own package index, unpack them
+# into a private prefix and print the LD_LIBRARY_PATH to use.
+#
+#   bash scripts/setup-browser-libs.sh          # install
+#   eval "$(bash scripts/setup-browser-libs.sh --env)"   # export it
+#
+# Verified on Ubuntu 24.04 (noble) with Chromium 1234 from
+# playwright 1.62.1.
+# ---------------------------------------------------------------
+set -euo pipefail
+PREFIX="${LELU_BROWSER_LIBS:-/tmp/lelu-browser-libs}"
+. /etc/os-release
+CODENAME="${VERSION_CODENAME:-noble}"
+
+if [ "${1:-}" != "--env" ]; then
+  python3 - "$CODENAME" "$PREFIX" <<'PY'
+import gzip, os, subprocess, sys, urllib.request
+
+code, prefix = sys.argv[1], sys.argv[2]
+want = {
+    "libasound2t64", "libatk-bridge2.0-0t64", "libatk1.0-0t64", "libatspi2.0-0t64",
+    "libnspr4", "libnss3", "libxcomposite1", "libxdamage1", "libxfixes3",
+    "libxkbcommon0", "libxrandr2",
+}
+found = {}
+for comp in ("main", "universe"):
+    url = f"http://archive.ubuntu.com/ubuntu/dists/{code}/{comp}/binary-amd64/Packages.gz"
+    try:
+        raw = gzip.decompress(urllib.request.urlopen(url, timeout=90).read()).decode("utf-8", "replace")
+    except Exception as exc:  # a missing component is not fatal
+        print(f"  index {comp} unavailable: {exc}")
+        continue
+    pkg = None
+    for line in raw.splitlines():
+        if line.startswith("Package: "):
+            pkg = line[9:].strip()
+        elif line.startswith("Filename: ") and pkg in want and pkg not in found:
+            found[pkg] = line[10:].strip()
+
+os.makedirs(prefix, exist_ok=True)
+for pkg, path in sorted(found.items()):
+    deb = os.path.join(prefix, f"{pkg}.deb")
+    if not os.path.exists(deb):
+        urllib.request.urlretrieve("http://archive.ubuntu.com/ubuntu/" + path, deb)
+    subprocess.run(["dpkg-deb", "-x", deb, os.path.join(prefix, "root")], check=True)
+    print(f"  extracted {pkg}")
+print(f"missing from the index: {sorted(want - found.keys()) or 'none'}")
+PY
+fi
+
+LIBDIR="$PREFIX/root/usr/lib/x86_64-linux-gnu"
+if [ "${1:-}" = "--env" ]; then
+  echo "export LD_LIBRARY_PATH=\"$LIBDIR\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}\""
+else
+  echo
+  echo "Libraries are in $LIBDIR"
+  echo "Run with:"
+  echo "  eval \"\$(bash scripts/setup-browser-libs.sh --env)\""
+fi
diff --git a/scripts/verify-asset-caching.mjs b/scripts/verify-asset-caching.mjs
new file mode 100644
index 0000000..031fe75
--- /dev/null
+++ b/scripts/verify-asset-caching.mjs
@@ -0,0 +1,202 @@
+/**
+ * LÉLU — PRODUCTION CACHE POLICY, CHECKED AGAINST REAL RESPONSES
+ *
+ * The runtime (`server.ts`) is the production asset server. This script
+ * asks it the questions a phone actually asks, and checks the answer:
+ *
+ *   1. the app shell revalidates (`no-cache`) and answers a repeat with
+ *      304 and no body;
+ *   2. a content-hashed build asset is `immutable` for a year;
+ *   3. nothing that a deploy can change is served `immutable` — the
+ *      service worker script, the manifest, the avatar art, the models;
+ *   4. every file carries an ETag, and a conditional request is a 304;
+ *   5. a model answers Range with 206 and the right bytes, refuses an
+ *      impossible range with 416, and ignores a stale If-Range;
+ *   6. HEAD answers with the real Content-Length and no body.
+ *
+ * Evidence goes to docs/evidence/asset-caching/<stamp>/http.json.
+ * Usage: node scripts/verify-asset-caching.mjs [baseUrl]
+ */
+
+import { existsSync, mkdirSync, writeFileSync, readdirSync, rmSync, truncateSync, mkdirSync as mkdir } from "node:fs";
+import path from "node:path";
+
+const BASE = (process.argv[2] ?? "http://127.0.0.1:4173/").replace(/\/?$/, "/");
+const stamp = new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19);
+const OUT = path.join("docs", "evidence", "asset-caching", stamp);
+mkdirSync(OUT, { recursive: true });
+
+const checks = [];
+const evidence = {};
+
+function check(name, pass, detail) {
+  checks.push({ name, pass: Boolean(pass), detail });
+  console.log(`${pass ? "PASS" : "FAIL"}  ${name}${detail ? ` — ${detail}` : ""}`);
+}
+
+async function head(url, headers = {}) {
+  const res = await fetch(url, { method: "HEAD", headers });
+  return { status: res.status, headers: Object.fromEntries(res.headers) };
+}
+
+async function get(url, headers = {}) {
+  const res = await fetch(url, { headers });
+  const body = await res.arrayBuffer();
+  return {
+    status: res.status,
+    headers: Object.fromEntries(res.headers),
+    bytes: body.byteLength,
+  };
+}
+
+/** A content-hashed bundle, picked from the real build. */
+function hashedAsset() {
+  try {
+    const file = readdirSync("dist/assets").find((name) => /-[A-Za-z0-9_-]{8,}\.[a-z0-9]+$/i.test(name));
+    return file ? `assets/${file}` : null;
+  } catch {
+    return null;
+  }
+}
+
+const MODEL = "models/cache-probe.glb";
+
+/**
+ * A model-sized fixture, made here and removed afterwards, so the range
+ * checks are reproducible without shipping a 49 MB placeholder in dist
+ * (which a real deploy would serve). 12 MB is enough to exercise every
+ * range path and keeps the evidence cheap.
+ */
+function ensureModelFixture() {
+  if (existsSync(path.join("dist", MODEL))) return false;
+  mkdir(path.join("dist", "models"), { recursive: true });
+  const file = path.join("dist", MODEL);
+  writeFileSync(file, "");
+  truncateSync(file, 12 * 1024 * 1024);
+  return true;
+}
+
+async function main() {
+  const fixtureCreated = ensureModelFixture();
+  /* ---------------------------------------------------------------- */
+  /* the app shell                                                     */
+  /* ---------------------------------------------------------------- */
+  const shell = await head(BASE);
+  evidence.shell = shell;
+  check("app shell is not cached without revalidation", shell.headers["cache-control"] === "no-cache", shell.headers["cache-control"]);
+  check("app shell carries an ETag", Boolean(shell.headers.etag), shell.headers.etag);
+
+  const shellConditional = await get(BASE, { "If-None-Match": shell.headers.etag ?? "" });
+  evidence.shellConditional = shellConditional;
+  check("repeat shell request is a 304", shellConditional.status === 304, `status ${shellConditional.status}`);
+  check("a 304 carries no body", shellConditional.bytes === 0, `${shellConditional.bytes} bytes`);
+
+  /* ---------------------------------------------------------------- */
+  /* a content-hashed bundle may be immutable                          */
+  /* ---------------------------------------------------------------- */
+  const asset = hashedAsset();
+  if (!asset) {
+    check("a content-hashed bundle exists in dist/assets", false, "no hashed file found");
+  } else {
+    const hashed = await head(BASE + asset);
+    evidence.hashedAsset = { asset, ...hashed };
+    check(
+      "content-hashed bundle is immutable for a year",
+      /\bimmutable\b/.test(hashed.headers["cache-control"] ?? "") && /max-age=31536000/.test(hashed.headers["cache-control"] ?? ""),
+      `${asset}: ${hashed.headers["cache-control"]}`,
+    );
+  }
+
+  /* ---------------------------------------------------------------- */
+  /* nothing a deploy can change may be immutable                      */
+  /* ---------------------------------------------------------------- */
+  const mutable = [
+    ["the service worker script", "sw.js"],
+    ["the web manifest", "manifest.webmanifest"],
+    ["the avatar art", "avatar/lelu/earthy/body.webp"],
+    ["the avatar rig", "avatar/lelu/earthy/rig.json"],
+  ];
+  evidence.mutable = {};
+  for (const [label, rel] of mutable) {
+    const res = await head(BASE + rel);
+    evidence.mutable[rel] = res;
+    const cc = res.headers["cache-control"] ?? "";
+    check(`${label} is not served immutable`, !/\bimmutable\b/.test(cc), `${rel}: ${cc}`);
+    check(`${label} revalidates`, /no-cache|must-revalidate|max-age=0/.test(cc), `${rel}: ${cc}`);
+    check(`${label} carries an ETag`, Boolean(res.headers.etag), `${rel}: ${res.headers.etag}`);
+  }
+
+  /* the avatar art specifically: a new look must be able to replace it */
+  const avatar = await head(BASE + "avatar/lelu/earthy/body.webp");
+  const avatarConditional = await get(BASE + "avatar/lelu/earthy/body.webp", {
+    "If-None-Match": avatar.headers.etag ?? "",
+  });
+  evidence.avatarConditional = avatarConditional;
+  check("unchanged avatar art costs a 304, not a re-download", avatarConditional.status === 304 && avatarConditional.bytes === 0, `status ${avatarConditional.status}, ${avatarConditional.bytes} bytes`);
+
+  /* the service worker must never be served from an immutable entry */
+  const sw = await head(BASE + "sw.js");
+  check("the service worker can be updated on an installed phone", sw.headers["cache-control"] === "no-cache", String(sw.headers["cache-control"]));
+
+  /* ---------------------------------------------------------------- */
+  /* the model: ranges, resume, validators                             */
+  /* ---------------------------------------------------------------- */
+  const modelHead = await head(BASE + MODEL);
+  evidence.modelHead = modelHead;
+  if (modelHead.status !== 200) {
+    check(`a model asset is present at ${MODEL}`, false, `status ${modelHead.status} — create one to test ranges`);
+  } else {
+    const total = Number(modelHead.headers["content-length"]);
+    check("model advertises range support", modelHead.headers["accept-ranges"] === "bytes", String(modelHead.headers["accept-ranges"]));
+    check("HEAD reports the real length", Number.isFinite(total) && total > 0, `${total} bytes`);
+
+    const firstKb = await get(BASE + MODEL, { Range: "bytes=0-1023" });
+    evidence.rangeFirstKb = { status: firstKb.status, headers: firstKb.headers, bytes: firstKb.bytes };
+    check("a range request is 206, not the whole file", firstKb.status === 206, `status ${firstKb.status}`);
+    check("a range request returns only the asked bytes", firstKb.bytes === 1024, `${firstKb.bytes} bytes`);
+    check("Content-Range names the slice", firstKb.headers["content-range"] === `bytes 0-1023/${total}`, String(firstKb.headers["content-range"]));
+
+    const tail = await get(BASE + MODEL, { Range: "bytes=-100" });
+    check("a suffix range resumes from the end", tail.status === 206 && tail.bytes === 100, `status ${tail.status}, ${tail.bytes} bytes`);
+
+    const resume = await get(BASE + MODEL, { Range: `bytes=${total - 1024}-` });
+    check("an open-ended range resumes to the end", resume.status === 206 && resume.bytes === 1024, `status ${resume.status}, ${resume.bytes} bytes`);
+
+    const impossible = await get(BASE + MODEL, { Range: `bytes=${total + 10}-` });
+    check("an impossible range is 416 with the real size", impossible.status === 416 && impossible.headers["content-range"] === `bytes */${total}`, `status ${impossible.status}, ${impossible.headers["content-range"]}`);
+
+    const staleIfRange = await get(BASE + MODEL, { Range: "bytes=0-1023", "If-Range": '"not-the-current-model"' });
+    check("a stale If-Range gets the full current file", staleIfRange.status === 200 && staleIfRange.bytes === total, `status ${staleIfRange.status}, ${staleIfRange.bytes} bytes`);
+
+    const freshIfRange = await get(BASE + MODEL, { Range: "bytes=0-1023", "If-Range": modelHead.headers.etag ?? "" });
+    check("a matching If-Range gets the slice", freshIfRange.status === 206 && freshIfRange.bytes === 1024, `status ${freshIfRange.status}, ${freshIfRange.bytes} bytes`);
+
+    const modelConditional = await get(BASE + MODEL, { "If-None-Match": modelHead.headers.etag ?? "" });
+    check("an unchanged model is a 304, not 49 MB again", modelConditional.status === 304 && modelConditional.bytes === 0, `status ${modelConditional.status}, ${modelConditional.bytes} bytes`);
+
+    const modelType = modelHead.headers["content-type"];
+    check("the model has a real content type", modelType === "model/gltf-binary", String(modelType));
+  }
+
+  /* ---------------------------------------------------------------- */
+  /* untouched behaviour                                               */
+  /* ---------------------------------------------------------------- */
+  const missingAsset = await get(BASE + "assets/does-not-exist.js");
+  check("a missing bundle is still a 404, not the shell", missingAsset.status === 404, `status ${missingAsset.status}`);
+
+  const spa = await get(BASE + "some/deep/route");
+  check("an app route still returns the shell", spa.status === 200 && (spa.headers["content-type"] ?? "").startsWith("text/html"), `status ${spa.status}`);
+
+  if (fixtureCreated) rmSync(path.join("dist", MODEL), { force: true });
+
+  const pass = checks.filter((c) => c.pass).length;
+  const summary = { stamp, base: BASE, pass, total: checks.length, checks, evidence };
+  writeFileSync(path.join(OUT, "http.json"), JSON.stringify(summary, null, 2));
+  console.log(`\n${pass}/${checks.length} cache-policy checks passed — evidence in ${OUT}/http.json`);
+  process.exit(pass === checks.length ? 0 : 1);
+}
+
+main().catch((error) => {
+  console.error("verify-asset-caching failed:", error);
+  process.exit(1);
+});
