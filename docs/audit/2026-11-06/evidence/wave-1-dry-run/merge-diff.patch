+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: STUDIO RUNTIME (CLIENT)
+ *
+ * The Studio's transport. Every method reaches the real studio runtime
+ * (POST /api/studio/*) that Session 3A's engineering server already
+ * exposes for the dev and standalone runtimes. Nothing is simulated: a
+ * build result is the process's exit code, a tree is the real directory.
+ *
+ * The runtime is the existing one — SourceAccess owns the base URL and
+ * access token, exactly as it does for every other engineering call.
+ * ==========================================================
+ */
+
+import SourceAccess from "../selfdev/SourceAccess";
+import type { StudioProjectKind } from "./StudioProjectTypes";
+
+export interface StudioHealth {
+  ok: boolean;
+  runtime: string;
+  root: string;
+  templates: string[];
+  capabilities: {
+    node: boolean;
+    godot: boolean;
+    unity: boolean;
+    unreal: boolean;
+    headlessBrowser: boolean;
+  };
+  error?: string;
+}
+
+export interface StudioEntry {
+  name: string;
+  path: string;
+  type: "file" | "dir";
+  size?: number;
+}
+
+export interface StudioBuildResult {
+  ok: boolean;
+  exitCode: number;
+  durationMs: number;
+  output: string;
+  artifact: string | null;
+  bytes: number;
+  error?: string;
+}
+
+export interface StudioTestResult {
+  ok: boolean;
+  exitCode: number;
+  passed: number;
+  failed: number;
+  durationMs: number;
+  output: string;
+  error?: string;
+}
+
+export interface StudioDeploymentResult {
+  ok: boolean;
+  status: "prepared" | "published" | "blocked" | "failed";
+  environment: "preview" | "production";
+  target: string;
+  url?: string;
+  note?: string;
+  error?: string;
+}
+
+export interface StudioAssetResponse {
+  ok: boolean;
+  assets: Array<{
+    id: string;
+    source: string;
+    path: string;
+    kind: string;
+    state: string;
+    jobId?: string;
+    note?: string;
+  }>;
+  error?: string;
+}
+
+interface ServerReply {
+  ok?: boolean;
+  error?: string;
+  [key: string]: unknown;
+}
+
+export default class StudioRuntime {
+  private static instance: StudioRuntime | null = null;
+
+  public static getInstance(): StudioRuntime {
+    if (!StudioRuntime.instance) StudioRuntime.instance = new StudioRuntime();
+    return StudioRuntime.instance;
+  }
+
+  private async post(route: string, body: Record<string, unknown> = {}): Promise<ServerReply> {
+    const source = SourceAccess.getInstance();
+    try {
+      const response = await fetch(source.url(route), {
+        method: "POST",
+        headers: { ...source.headers() },
+        body: JSON.stringify(body),
+      });
+      const text = await response.text();
+      let data: ServerReply = {};
+      try {
+        data = text ? (JSON.parse(text) as ServerReply) : {};
+      } catch {
+        return { ok: false, error: text.slice(0, 400) || `HTTP ${response.status}` };
+      }
+      if (!response.ok && data.ok !== false) {
+        return { ok: false, error: String(data.error ?? `HTTP ${response.status}`) };
+      }
+      return data;
+    } catch (error) {
+      return {
+        ok: false,
+        error:
+          `The studio runtime is not reachable (${error instanceof Error ? error.message : String(error)}). ` +
+          "A static deployment has no /api/studio; run the app with its development runtime.",
+      };
+    }
+  }
+
+  public async health(): Promise<StudioHealth> {
+    const data = await this.post("/api/studio/health");
+    return {
+      ok: data.ok === true,
+      runtime: String(data.runtime ?? "unknown"),
+      root: String(data.root ?? ""),
+      templates: Array.isArray(data.templates) ? (data.templates as string[]) : [],
+      capabilities: (data.capabilities as StudioHealth["capabilities"]) ?? {
+        node: false,
+        godot: false,
+        unity: false,
+        unreal: false,
+        headlessBrowser: false,
+      },
+      error: data.error ? String(data.error) : undefined,
+    };
+  }
+
+  public async projects(): Promise<Array<{ slug: string; files: number; bytes: number; updatedAt: number; built: boolean }>> {
+    const data = await this.post("/api/studio/projects");
+    return Array.isArray(data.projects)
+      ? (data.projects as Array<{ slug: string; files: number; bytes: number; updatedAt: number; built: boolean }>)
+      : [];
+  }
+
+  public async scaffold(input: {
+    kind: StudioProjectKind;
+    name: string;
+    requirements?: Record<string, unknown>;
+  }): Promise<{ ok: boolean; slug?: string; root?: string; files?: number; error?: string }> {
+    const data = await this.post("/api/studio/scaffold", input);
+    return {
+      ok: data.ok === true,
+      slug: data.slug ? String(data.slug) : undefined,
+      root: data.root ? String(data.root) : undefined,
+      files: typeof data.files === "number" ? data.files : undefined,
+      error: data.error ? String(data.error) : undefined,
+    };
+  }
+
+  /** Create the three first-demonstration projects. Real files, real copies. */
+  public async seedDemos(): Promise<Array<{ ok: boolean; kind: string; slug: string; files: number; error?: string }>> {
+    const data = await this.post("/api/studio/demo");
+    return Array.isArray(data.projects)
+      ? (data.projects as Array<{ ok: boolean; kind: string; slug: string; files: number; error?: string }>)
+      : [];
+  }
+
+  public async tree(slug: string, path = "."): Promise<{ ok: boolean; entries: StudioEntry[]; error?: string }> {
+    const data = await this.post("/api/studio/tree", { slug, path });
+    return {
+      ok: data.ok === true,
+      entries: Array.isArray(data.entries) ? (data.entries as StudioEntry[]) : [],
+      error: data.error ? String(data.error) : undefined,
+    };
+  }
+
+  public async read(slug: string, path: string): Promise<{ ok: boolean; content?: string; error?: string }> {
+    const data = await this.post("/api/studio/read", { slug, path });
+    return {
+      ok: data.ok === true,
+      content: typeof data.content === "string" ? data.content : undefined,
+      error: data.error ? String(data.error) : undefined,
+    };
+  }
+
+  public async write(slug: string, path: string, content: string): Promise<{ ok: boolean; error?: string }> {
+    const data = await this.post("/api/studio/write", { slug, path, content });
+    return { ok: data.ok === true, error: data.error ? String(data.error) : undefined };
+  }
+
+  public async build(slug: string): Promise<StudioBuildResult> {
+    const data = await this.post("/api/studio/build", { slug });
+    return {
+      ok: data.ok === true,
+      exitCode: typeof data.exitCode === "number" ? data.exitCode : 1,
+      durationMs: typeof data.durationMs === "number" ? data.durationMs : 0,
+      output: String(data.output ?? data.error ?? ""),
+      artifact: data.artifact ? String(data.artifact) : null,
+      bytes: typeof data.bytes === "number" ? data.bytes : 0,
+      error: data.error ? String(data.error) : undefined,
+    };
+  }
+
+  public async test(slug: string): Promise<StudioTestResult> {
+    const data = await this.post("/api/studio/test", { slug });
+    return {
+      ok: data.ok === true,
+      exitCode: typeof data.exitCode === "number" ? data.exitCode : 1,
+      passed: typeof data.passed === "number" ? data.passed : 0,
+      failed: typeof data.failed === "number" ? data.failed : 0,
+      durationMs: typeof data.durationMs === "number" ? data.durationMs : 0,
+      output: String(data.output ?? data.error ?? ""),
+      error: data.error ? String(data.error) : undefined,
+    };
+  }
+
+  /** Same-origin preview URL, served by the studio runtime from real dist output. */
+  public previewUrl(slug: string): string {
+    return `/api/studio/serve/${encodeURIComponent(slug)}/`;
+  }
+
+  public async assets(): Promise<StudioAssetResponse> {
+    const data = await this.post("/api/studio/assets");
+    return {
+      ok: data.ok === true,
+      assets: Array.isArray(data.assets) ? (data.assets as StudioAssetResponse["assets"]) : [],
+      error: data.error ? String(data.error) : undefined,
+    };
+  }
+
+  /** Prepare a deployment. Production requires a live human approval id. */
+  public async deploy(input: {
+    slug: string;
+    environment: "preview" | "production";
+    approvalId?: string;
+  }): Promise<StudioDeploymentResult> {
+    const data = await this.post("/api/studio/deploy", input);
+    const environment = input.environment;
+    return {
+      ok: data.ok === true,
+      status: (data.status as StudioDeploymentResult["status"]) ?? "failed",
+      environment,
+      target: String(data.target ?? ""),
+      url: data.url ? String(data.url) : undefined,
+      note: data.note ? String(data.note) : undefined,
+      error: data.error ? String(data.error) : undefined,
+    };
+  }
+
+  /** Ask a person to approve a protected action. Never grants it. */
+  public requestApproval(input: {
+    slug: string;
+    action: string;
+    reason: string;
+    scope?: string[];
+  }): Promise<{ ok: boolean; approvalId?: string; approval?: Record<string, unknown>; error?: string }> {
+    return this.post("/api/studio/approvals/request", input).then((data) => ({
+      ok: data.ok === true,
+      approvalId: data.approvalId ? String(data.approvalId) : undefined,
+      approval: (data.approval as Record<string, unknown>) ?? undefined,
+      error: data.error ? String(data.error) : undefined,
+    }));
+  }
+
+  public async approvals(slug: string): Promise<Array<Record<string, unknown>>> {
+    const data = await this.post("/api/studio/approvals/list", { slug });
+    return Array.isArray(data.approvals) ? (data.approvals as Array<Record<string, unknown>>) : [];
+  }
+
+  /**
+   * A person's own decision. The panel calls this from a click; no tool
+   * executor does, and the server requires the explicit user-confirmed
+   * header that only the panel sends.
+   */
+  public async decideApproval(input: {
+    approvalId: string;
+    decision: "approved" | "denied";
+    decidedBy: string;
+  }): Promise<{ ok: boolean; error?: string }> {
+    const source = SourceAccess.getInstance();
+    try {
+      const response = await fetch(source.url("/api/studio/approvals/decide"), {
+        method: "POST",
+        headers: { ...source.headers(), "x-lelu-user-confirmed": "1" },
+        body: JSON.stringify(input),
+      });
+      const data = (await response.json()) as ServerReply;
+      return { ok: data.ok === true, error: data.error ? String(data.error) : undefined };
+    } catch (error) {
+      return { ok: false, error: error instanceof Error ? error.message : String(error) };
+    }
+  }
+}
diff --git a/src/core/studio/StudioSecurity.ts b/src/core/studio/StudioSecurity.ts
new file mode 100644
index 0000000..5b95b4d
--- /dev/null
+++ b/src/core/studio/StudioSecurity.ts
@@ -0,0 +1,101 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: SECRET HYGIENE
+ *
+ * "Never expose secrets in frontend code" is enforced at the write
+ * boundary, not left as an instruction. A file that would ship a
+ * credential to a browser is refused before it reaches the disk.
+ *
+ * The detector is deliberately narrow: it looks for a KEY WITH A VALUE
+ * and for well-known credential shapes. It does not flag the *name* of a
+ * server-side variable, because telling a build script to read
+ * `process.env.STRIPE_SECRET_KEY` is correct, and blocking it would make
+ * the guard useless.
+ * ==========================================================
+ */
+
+export interface SecretFinding {
+  line: number;
+  kind: string;
+  /** The variable name, never its value. */
+  name: string;
+}
+
+const CLIENT_PREFIX = /^(?:VITE_|NEXT_PUBLIC_|PUBLIC_|REACT_APP_|NUXT_PUBLIC_)/;
+/** `VITE_KEY=value` / `VITE_KEY: "value"`, bare or inside a quoted string. */
+const CLIENT_ENV_STYLE =
+  /\b(VITE_[A-Z0-9_]{2,}|NEXT_PUBLIC_[A-Z0-9_]{2,})\s*[:=]\s*["']?([^\s"'`,;]{8,})/g;
+const ASSIGNMENT = /\b([A-Z0-9_]{3,})\s*[:=]\s*["'`]([^"'`\s]{12,})["'`]/g;
+const KNOWN_SHAPES: Array<{ kind: string; pattern: RegExp }> = [
+  { kind: "private key", pattern: /-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/ },
+  { kind: "OpenAI-style key", pattern: /\bsk-[A-Za-z0-9_-]{20,}\b/ },
+  { kind: "AWS access key", pattern: /\bAKIA[0-9A-Z]{16}\b/ },
+  { kind: "GitHub token", pattern: /\bgh[pousr]_[A-Za-z0-9]{30,}\b/ },
+  { kind: "Supabase service role", pattern: /\bsb_secret_[A-Za-z0-9_-]{16,}\b/ },
+  { kind: "generic bearer token", pattern: /\bBearer\s+[A-Za-z0-9_-]{24,}\b/ },
+];
+
+/**
+ * What in this content would leak a credential to a browser.
+ * Returns [] when the file is safe to write.
+ */
+export function scanForSecrets(content: string): SecretFinding[] {
+  const findings: SecretFinding[] = [];
+  const lines = content.split("\n");
+
+  for (let index = 0; index < lines.length; index += 1) {
+    const line = lines[index];
+    const lineNumber = index + 1;
+
+    for (const shape of KNOWN_SHAPES) {
+      if (shape.pattern.test(line)) {
+        findings.push({ line: lineNumber, kind: shape.kind, name: shape.kind });
+      }
+    }
+
+    CLIENT_ENV_STYLE.lastIndex = 0;
+    let envMatch = CLIENT_ENV_STYLE.exec(line);
+    while (envMatch) {
+      findings.push({
+        line: lineNumber,
+        kind: "browser-exposed environment variable",
+        name: envMatch[1],
+      });
+      envMatch = CLIENT_ENV_STYLE.exec(line);
+    }
+
+    ASSIGNMENT.lastIndex = 0;
+    let match = ASSIGNMENT.exec(line);
+    while (match) {
+      const name = match[1];
+      if (CLIENT_PREFIX.test(name)) {
+        findings.push({
+          line: lineNumber,
+          kind: "browser-exposed environment variable",
+          name,
+        });
+      }
+      match = ASSIGNMENT.exec(line);
+    }
+  }
+
+  return findings;
+}
+
+/** A refusal message that names the problem without repeating the value. */
+export function describeSecretFindings(findings: readonly SecretFinding[]): string {
+  const unique = [...new Map(findings.map((finding) => [finding.name + finding.line, finding])).values()];
+  return unique
+    .map((finding) => `line ${finding.line}: ${finding.kind} (${finding.name})`)
+    .join("; ");
+}
+
+/** The studio refuses a write when this is non-empty. */
+export function refuseReasonForWrite(content: string): string | null {
+  const findings = scanForSecrets(content);
+  if (findings.length === 0) return null;
+  return (
+    `Refused: this file would expose a credential to the browser (${describeSecretFindings(findings)}). ` +
+    "Keep secrets on the server and read them from process.env; never inline them in frontend code."
+  );
+}
diff --git a/src/core/studio/StudioToolExecutors.ts b/src/core/studio/StudioToolExecutors.ts
new file mode 100644
index 0000000..baab509
--- /dev/null
+++ b/src/core/studio/StudioToolExecutors.ts
@@ -0,0 +1,571 @@
+/**
+ * ==========================================================
+ * LÉLU — SESSION 3C: STUDIO TOOL EXECUTORS
+ *
+ * The studio's hands for LÉLU's own cognition. Every executor calls the
+ * real runtime and records what came back in the project library and the
+ * workflow — no executor writes "done" on its own authority.
+ *
+ * Approval is the exception, deliberately: the model can ASK for one and
+ * can never grant it. There is no executor here that decides an approval.
+ * ==========================================================
+ */
+
+import type { ToolExecutionResult, ToolExecutor } from "../tools/ToolDispatcher";
+import StudioApprovals, { PROTECTED_ACTION_LABELS } from "./StudioApprovals";
+import StudioLibrary from "./StudioLibrary";
+import { fetchPersistedStudioProjects } from "./StudioPersistence";
+import StudioPipeline from "./StudioPipeline";
+import StudioRuntime from "./StudioRuntime";
+import { describeAssets } from "./StudioAssets";
+import { engineCapabilities, recommendEngine } from "./StudioEngines";
+import {
+  STUDIO_PHASE_LABELS,
+  STUDIO_PHASES,
+  type StudioPhase,
+  type StudioRequirements,
+} from "./StudioProjectTypes";
+
+function str(args: Record<string, unknown>, key: string): string {
+  return typeof args[key] === "string" ? (args[key] as string) : "";
+}
+
+function num(args: Record<string, unknown>, key: string, fallback: number): number {
+  return typeof args[key] === "number" ? (args[key] as number) : fallback;
+}
+
+function projectRef(args: Record<string, unknown>): string {
+  return str(args, "project") || str(args, "slug");
+}
+
+function requirementsFrom(args: Record<string, unknown>): StudioRequirements {
+  const kind = str(args, "kind");
+  const targets: StudioRequirements["targets"] = Array.isArray(args.targets)
+    ? (args.targets.map(String).filter((target) =>
+        ["web", "pwa", "mobile", "desktop"].includes(target),
+      ) as StudioRequirements["targets"])
+    : ["web"];
+  return {
+    kind: kind === "application" || kind === "game" ? kind : "website",
+    dimension: str(args, "dimension") === "2d" ? "2d" : str(args, "dimension") === "3d" ? "3d" : undefined,
+    targets,
+    multiplayer: args.multiplayer === true,
+    photoreal: args.photoreal === true,
+    teamSize: num(args, "teamSize", 1),
+    assetPipeline: args.assetPipeline === true,
+  };
+}
+
+export const studioToolExecutors: ToolExecutor[] = [
+  {
+    id: "studio.engine",
+    parameters: {
+      type: "object",
+      properties: {
+        kind: { type: "string", enum: ["website", "application", "game"] },
+        dimension: { type: "string", enum: ["2d", "3d"] },
+        targets: {
+          type: "array",
+          items: { type: "string", enum: ["web", "pwa", "mobile", "desktop"] },
+          description: "Where the result must run.",
+        },
+        multiplayer: { type: "boolean" },
+        photoreal: { type: "boolean" },
+        teamSize: { type: "number", description: "People who will work in the engine editor." },
+      },
+      required: ["kind"],
+    },
+    run: async (args): Promise<ToolExecutionResult> => {
+      const requirements = requirementsFrom(args);
+      const runtime = StudioRuntime.getInstance();
+      const health = await runtime.health();
+      const probe = {
