{
  "name": "lelu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort --port 5173",
    "lelu:start": "vite --host 0.0.0.0 --strictPort --port 5173",
    "lelu:doctor": "tsx scripts/lelu-doctor.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:live": "tsx --test tests/autonomy-end-to-end.test.ts",
    "verify:autonomy": "node scripts/verify-continuous-cognition.mjs",
    "verify:persistence": "node scripts/verify-persistence-restart.mjs",
    "serve": "bun run server.ts",
    "start": "bun run server.ts",
    "preview": "vite preview --host 0.0.0.0 --strictPort --port 4173",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:assets": "capacitor-assets generate --android",
    "android:apk": "bun run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@capacitor/core": "^8.5.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@vly-ai/integrations": "^0.6.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.43.0",
    "openai": "^6.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "glslify": "^7.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-glsl": "^1.6.0"
  }
}
