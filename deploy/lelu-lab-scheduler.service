# ==========================================================
# LÉLU — self-development laboratory scheduler (systemd)
#
# NOT INSTALLED. This file is the configuration and the install
# procedure; enabling a unit changes the host, which needs the
# operator's explicit authorization.
#
#   sudo cp deploy/lelu-lab-scheduler.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lelu-lab-scheduler
#   systemctl status lelu-lab-scheduler
#   journalctl -u lelu-lab-scheduler -n 50 --no-pager
#
# Why a unit and not a detached process: the laboratory's own lock stops a
# SECOND instance, but nothing restarts the first after a reboot. systemd is
# the supervisor this host already has; adding another scheduler would be the
# duplication Mission 44 forbids.
#
# ENVIRONMENT LOADING (verified by reading the code, not assumed): the
# scheduler needs NO credential. `scripts/lab-scheduler.ts` and
# `plugins/labEngine.ts` read process.env only to pass it through to `git`
# (with GIT_TERMINAL_PROMPT=0) and to run their own subprocesses. It never
# calls a model provider, so no EnvironmentFile= for `.env.local` is used:
# handing this process the repository's provider keys would widen exposure
# for no gain. What it DOES need is a PATH that finds `node`, `npx` and
# `git`; systemd's default PATH omits the Node install prefix on this image,
# so PATH is set explicitly below.
#
# RESTART POLICY: Restart=always, because "the scheduler exited cleanly" is
# not a state this daemon should stay in — the unit is the thing that keeps
# discovery running across reboots and crashes. `systemctl stop` still stops
# it: systemd never restarts a unit it stopped itself. RestartPreventExitStatus
# =3 is the one exception: exit 3 is the scheduler's deliberate "another
# instance holds the lock" refusal, and restarting into that refusal five
# times would only fill the journal. It stops and stays stopped, visibly.
#
# A cycle that keeps crashing must not spin: StartLimitIntervalSec/Burst are
# [Unit] settings (they moved out of [Service] in systemd 229 and are ignored
# there — they were in the wrong section before this mission).
# ==========================================================

[Unit]
Description=LÉLU self-development laboratory — daily repository discovery
Documentation=file:///workspace/chats/08af6cc9ef212913e6b7209b/docs/missions/MISSION-44-1-VERIFICATION.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
# Paths are the deployment's; adjust to wherever the repository is checked out.
WorkingDirectory=/workspace/chats/08af6cc9ef212913e6b7209b
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npx tsx scripts/lab-scheduler.ts --interval-ms 21600000
# SIGTERM makes the scheduler close its heartbeat and release its lock before exit.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=30
# Exit 3 = "refusing to start — already held by pid N". Not a crash.
RestartPreventExitStatus=3
StandardOutput=append:/workspace/chats/08af6cc9ef212913e6b7209b/.lelu-lab/state/scheduler.log
StandardError=append:/workspace/chats/08af6cc9ef212913e6b7209b/.lelu-lab/state/scheduler.log

# The scheduler reads the repository and writes only .lelu-lab/.
# It never pushes, merges or deploys, so it needs no network write path beyond
# the git remote the checkout already uses.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
