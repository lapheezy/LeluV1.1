# /etc/lelu/lelu.env — LÉLU production environment (Contabo VPS).
# Owned by root:lelu, mode 0640. NEVER commit the filled-in copy.
# Every value here stays on the server: server.ts reads it; the browser
# never receives a provider credential (they are relayed by /api/model/*).

# ---- Access (required on a public server) ----
LELU_ACCESS_PASSWORD=
# 64 random hex chars: `openssl rand -hex 32`. Keeps sessions valid across restarts.
LELU_SESSION_SECRET=
LELU_SESSION_DAYS=30
# Optional second factor for the engineering API (POSTs need header x-lelu-token).
LELU_ENGINEER_TOKEN=

# ---- Intelligence ----
# Groq leads (verified working). Fireworks' account is suspended for billing.
# Anthropic is OPT-IN (src/core/model/ProviderPolicy.ts) and is NOT a
# deployment dependency: leave it off until it is funded AND authorized.
# To make it primary later, set both lines below and restart `lelu` — the
# server publishes them to the page at request time
# (plugins/runtimeKeyBridge.ts); no rebuild is needed:
#   LELU_ENABLE_ANTHROPIC=true
#   DEFAULT_PROVIDER=anthropic
LELU_ENABLE_ANTHROPIC=false
DEFAULT_PROVIDER=groq
LELU_ANTHROPIC_API_KEY=
# Do NOT set ANTHROPIC_BASE_URL here unless it is a proxy the BROWSER can
# reach: it is published to the page, which then calls it directly instead of
# the server broker (/api/model/anthropic), and a direct call has no key.
# Optional model override (default chosen in src/core/ProviderModels.ts)
# ANTHROPIC_MODEL=

# ---- Fallback providers (used in order when Anthropic is unavailable) ----
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
# GitHub Models (chat fallback) and the GitHub relay (/api/github/*)
GITHUB_MODELS_TOKEN=
GITHUB_TOKEN=
GEMINI_API_KEY=

# ---- Persistence: Supabase (publishable key is public by design; RLS protects data) ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---- Voice ----
# See DEPLOY_CONTABO.md "Voice" and deploy/voice/README.md.
# Speech worker: MOSS-TTS-Nano on this CPU (1.7 GiB RSS, RTF ~0.8-1.3 on
# 4 vCPU). VoxCPM2 needs ~11 GiB to load and is ~5x slower than real time on
# CPU: run it on a GPU worker via VOXCPM_WORKERS, never on this VPS.
VOXCPM_BASE_URL=http://127.0.0.1:8789
# LiveKit (LiveKit Cloud, or a self-hosted livekit-server). Secret: never commit.
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret between this app and the voice agent (openssl rand -hex 32).
LELU_VOICE_AGENT_TOKEN=

# ---- 3D Forge ----
MESHY_API_KEY=
# Headless Blender stages (optional): a Python with `bpy` installed
# LELU_BLENDER_PYTHON=/opt/lelu/blender-venv/bin/python

# ---- Optional data integrations ----
# AISSTREAM_API_KEY=
# NEWS_API_KEY=
# YOUTUBE_API_KEY=
# GEOAPIFY_API_KEY=
# GUARDIAN_API_KEY=
# NEWSDATA_API_KEY=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
