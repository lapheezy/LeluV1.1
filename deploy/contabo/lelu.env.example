# /etc/lelu/lelu.env — LÉLU production environment (Contabo VPS).
# Owned by root:lelu, mode 0640. NEVER commit the filled-in copy.
# Every value here stays on the server: server.ts reads it; the browser
# never receives a provider credential (they are relayed by /api/model/*).

# ---- Access (required on a public server) ----
LELU_ACCESS_PASSWORD=
# 64 random hex chars: `openssl rand -hex 32`. Keeps sessions valid across restarts.
LELU_SESSION_SECRET=
LELU_SESSION_DAYS=30
# Optional second factor for the engineering API (POSTs need header x-lelu-token).
LELU_ENGINEER_TOKEN=

# ---- Intelligence: Anthropic is primary ----
LELU_ANTHROPIC_API_KEY=
# Optional model override (default chosen in src/core/ProviderModels.ts)
# ANTHROPIC_MODEL=

# ---- Fallback providers (used in order when Anthropic is unavailable) ----
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
# GitHub Models (chat fallback) and the GitHub relay (/api/github/*)
GITHUB_MODELS_TOKEN=
GITHUB_TOKEN=
GEMINI_API_KEY=

# ---- Persistence: Supabase (publishable key is public by design; RLS protects data) ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---- Voice ----
# See DEPLOY_CONTABO.md "Voice": speech-to-text and text-to-speech providers
# and the variables they read are documented there.

# ---- 3D Forge ----
MESHY_API_KEY=
# Headless Blender stages (optional): a Python with `bpy` installed
# LELU_BLENDER_PYTHON=/opt/lelu/blender-venv/bin/python

# ---- Optional data integrations ----
# AISSTREAM_API_KEY=
# NEWS_API_KEY=
# YOUTUBE_API_KEY=
# GEOAPIFY_API_KEY=
# GUARDIAN_API_KEY=
# NEWSDATA_API_KEY=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
