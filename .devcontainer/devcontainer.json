{
  "name": "LÉLU",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "oxc.oxc-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },
  "postCreateCommand": "bun install || npm install",
  "forwardPorts": [5173],
  "remoteEnv": {
    "VITE_GROQ_API_KEY": "${localEnv:VITE_GROQ_API_KEY}",
    "VITE_OPENROUTER_API_KEY": "${localEnv:VITE_OPENROUTER_API_KEY}",
    "VITE_CEREBRAS_API_KEY": "${localEnv:VITE_CEREBRAS_API_KEY}",
    "VITE_MISTRAL_API_KEY": "${localEnv:VITE_MISTRAL_API_KEY}",
    "VITE_FIREWORKS_API_KEY": "${localEnv:VITE_FIREWORKS_API_KEY}",
    "VITE_GITHUB_TOKEN": "${localEnv:VITE_GITHUB_TOKEN}",
    "VITE_ANTHROPIC_API_KEY": "${localEnv:VITE_ANTHROPIC_API_KEY}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "VITE_NEWS_API_KEY": "${localEnv:VITE_NEWS_API_KEY}",
    "VITE_YOUTUBE_API_KEY": "${localEnv:VITE_YOUTUBE_API_KEY}"
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind"
  ]
}